<%# Minimal FAB + Bottom Sheet + Side Drawers %>
<% if logged_in? %>
  <div data-controller="fab-navigation"
       data-fab-navigation-current-days-value="<%= @view_days || 7 %>"
       data-action="keydown@document->fab-navigation#closeOnEscape click@document->fab-navigation#closeOnOverlay open-theme-drawer@window->fab-navigation#openThemeDrawer open-view-drawer@window->fab-navigation#openViewDrawer">



    <%# ── FAB Button (bottom-right, no background) ── %>
    <button class="fab"
            data-fab-navigation-target="button"
            data-action="click->fab-navigation#toggle"
            aria-label="Open navigation menu"
            aria-expanded="false">
      <svg data-fab-navigation-target="closedIcon" class="fab__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg data-fab-navigation-target="openIcon" class="fab__icon fab__icon--hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <%# ── Overlay ── %>
    <div class="bottom-sheet-overlay hidden" data-fab-navigation-target="overlay"></div>

    <%# ── Mobile Bottom Sheet ── %>
    <div class="bottom-sheet hidden"
         data-fab-navigation-target="bottomSheet"
         data-action="touchstart->fab-navigation#touchStart touchmove->fab-navigation#touchMove touchend->fab-navigation#touchEnd">
      <div class="bottom-sheet__handle-bar"><div class="bottom-sheet__handle"></div></div>

      <div class="bottom-sheet__content">
        <div class="bottom-sheet__user">
          <span class="bottom-sheet__username"><%= current_user.display_name %></span>
        </div>

        <nav class="bottom-sheet__nav">
          <a href="<%= app_root_path %>" class="bottom-sheet__link">Dashboard</a>
          <a href="<%= pages_path %>" class="bottom-sheet__link">Lists</a>
          <a href="<%= settings_path %>" class="bottom-sheet__link">Settings</a>
          <div class="bottom-sheet__divider"></div>
          <button class="bottom-sheet__link" data-action="click->fab-navigation#openViewDrawer">View</button>
          <button class="bottom-sheet__link" data-action="click->fab-navigation#openThemeDrawer">Themes</button>
          <div class="bottom-sheet__divider"></div>
          <a href="#" onclick="window.showLogoutModal(); return false;" class="bottom-sheet__link bottom-sheet__link--danger">Log out</a>
        </nav>
      </div>
    </div>

    <%# ── Desktop Bottom Bar ── %>
    <div class="desktop-nav hidden" data-fab-navigation-target="desktopNav">
      <div class="desktop-nav__inner">
        <span class="desktop-nav__user"><%= current_user.display_name %></span>
        <nav class="desktop-nav__links">
          <a href="<%= app_root_path %>" class="desktop-nav__link">Dashboard</a>
          <a href="<%= pages_path %>" class="desktop-nav__link">Lists</a>
          <a href="<%= settings_path %>" class="desktop-nav__link">Settings</a>
          <button class="desktop-nav__link" data-action="click->fab-navigation#openViewDrawer">View</button>
          <button class="desktop-nav__link" data-action="click->fab-navigation#openThemeDrawer">Themes</button>
          <a href="#" onclick="window.showLogoutModal(); return false;" class="desktop-nav__link desktop-nav__link--danger">Log out</a>
        </nav>
        <button data-action="click->fab-navigation#close" class="desktop-nav__close" aria-label="Close">&times;</button>
      </div>
    </div>

    <%# ── View Side Drawer (slides from left) ── %>
    <div data-fab-navigation-target="viewDrawerOverlay" class="side-drawer__overlay" style="display:none;"></div>
    <div data-fab-navigation-target="viewDrawer" class="side-drawer">
      <div class="side-drawer__header">
        <h2 class="side-drawer__title">View</h2>
        <button data-action="click->fab-navigation#closeViewDrawer" class="side-drawer__close" aria-label="Close">&times;</button>
      </div>
      <div class="side-drawer__body">
        <div class="view-options">
          <% [ [1, "Day", "Single day view"],
               [2, "2 Days", "Today & tomorrow"],
               [3, "3 Days", "Three day view"],
               [5, "Work Week", "Monday to Friday"],
               [7, "Full Week", "All seven days"] ].each do |days, label, desc| %>
            <a href="<%= app_root_path(days: days) %>"
               class="view-option<%= ' view-option--active' if (@view_days || 7) == days %>"
               data-turbo-action="replace">
              <span class="view-option__number"><%= days %></span>
              <span class="view-option__info">
                <span class="view-option__label"><%= label %></span>
                <span class="view-option__desc"><%= desc %></span>
              </span>
            </a>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Theme Side Drawer (slides from left) ── %>
    <div data-fab-navigation-target="themeDrawerOverlay" class="side-drawer__overlay" style="display:none;"></div>
    <div data-fab-navigation-target="themeDrawer" class="side-drawer">
      <div class="side-drawer__header">
        <h2 class="side-drawer__title">Themes</h2>
        <button data-action="click->fab-navigation#closeThemeDrawer" class="side-drawer__close" aria-label="Close">&times;</button>
      </div>
      <div class="side-drawer__body">
        <div class="theme-modal__grid">
          <% %w[classic lined graph vintage dark].each do |t| %>
            <button class="theme-option<%= ' theme-option--active' if current_theme == t %>"
                    data-theme="<%= t %>"
                    data-action="click->fab-navigation#selectTheme"
                    aria-label="Select <%= t.capitalize %> theme">
              <div class="theme-preview theme-btn--<%= t %>"></div>
              <span class="theme-option__label"><%= t.capitalize %></span>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
