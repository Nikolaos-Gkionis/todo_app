<%# Cog (top-left) opens unified preferences panel (left drawer with Preferences + Account tabs) %>
<% if logged_in? %>
  <div data-controller="fab-navigation shortcuts-help"
       data-fab-navigation-current-days-value="<%= @view_days || 7 %>"
       data-action="keydown@document->fab-navigation#closeOnEscape click@document->fab-navigation#closeOnOverlay open-theme-drawer@window->fab-navigation#openThemeDrawer open-view-drawer@window->fab-navigation#openViewDrawer open-preferences@window->fab-navigation#openPreferences open-settings-panel@window->fab-navigation#openPreferences">

    <%# ── Shortcuts Help Modal (shown on ?) ── %>
    <div id="shortcuts-help-modal" class="shortcuts-help" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="shortcuts-help-title" aria-hidden="true" data-shortcuts-help-target="modal">
      <div data-shortcuts-help-target="overlay" class="shortcuts-help__overlay"></div>
      <div class="shortcuts-help__dialog">
        <div class="shortcuts-help__header">
          <h2 class="shortcuts-help__title" id="shortcuts-help-title">Keyboard Shortcuts</h2>
          <button type="button" class="shortcuts-help__close" data-action="click->shortcuts-help#close" aria-label="Close">&times;</button>
        </div>
        <div class="shortcuts-help__body">
          <table class="shortcuts-help__table">
            <tbody>
              <tr><td><kbd>n</kbd></td><td>New task</td></tr>
              <tr><td><kbd>Shift+n</kbd></td><td>Create new list (when Not Yet panel open)</td></tr>
              <tr><td><kbd>y</kbd></td><td>Toggle Not Yet panel</td></tr>
              <tr><td><kbd>s</kbd></td><td>Open Settings</td></tr>
              <tr><td><kbd>t</kbd></td><td>Go to Today</td></tr>
              <tr><td><kbd>←</kbd> <kbd>→</kbd></td><td>Previous / Next day</td></tr>
              <tr><td><kbd>Shift+←</kbd> <kbd>Shift+→</kbd></td><td>Previous / Next week</td></tr>
              <tr><td><kbd>c</kbd></td><td>Open calendar picker</td></tr>
              <tr><td colspan="2" class="shortcuts-help__section">In calendar picker:</td></tr>
              <tr><td><kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd></td><td>Move between dates</td></tr>
              <tr><td><kbd>Enter</kbd> <kbd>Space</kbd></td><td>Select focused date</td></tr>
              <tr><td><kbd>PgUp</kbd> <kbd>PgDn</kbd></td><td>Previous / Next month</td></tr>
              <tr><td colspan="2" class="shortcuts-help__section">In Not Yet panel:</td></tr>
              <tr><td><kbd>↑</kbd> <kbd>↓</kbd></td><td>Move between tasks</td></tr>
              <tr><td><kbd>PgUp</kbd> <kbd>PgDn</kbd></td><td>Previous / Next list</td></tr>
              <tr><td><kbd>x</kbd></td><td>Toggle show/hide completed tasks</td></tr>
              <tr><td><kbd>?</kbd></td><td>Show this help</td></tr>
              <tr><td><kbd>Esc</kbd></td><td>Close panel or modal</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# ── Nav: Cog (top-left), Chevron (mobile island only for Not Yet) ── %>
    <div class="nav-island">
      <button class="fab nav-island__cog"
              data-fab-navigation-target="button"
              data-action="click->fab-navigation#openPreferences"
              aria-label="Open Settings"
              aria-expanded="false">
        <svg class="fab__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </button>
      <button type="button"
              class="nav-island__chevron"
              aria-label="Not Yet"
              title="Not Yet"
              onclick="window.dispatchEvent(new CustomEvent('open-not-yet-panel'))">
        <svg class="nav-island__chevron-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 18 12 12 6 6"/><polyline points="12 18 18 12 12 6"/></svg>
      </button>
    </div>

    <%# ── Unified Preferences Panel (left side drawer with tabs) ── %>
    <div data-fab-navigation-target="preferencesOverlay" class="side-drawer__overlay" style="display:none;"></div>
    <div data-fab-navigation-target="preferencesDrawer" data-fab-navigation-target="settingsPanel" class="side-drawer preferences-panel">
      <div class="side-drawer__header">
        <h2 class="side-drawer__title">Settings</h2>
        <button data-action="click->fab-navigation#closePreferences" class="side-drawer__close" aria-label="Close">&times;</button>
      </div>
      <%# Tab buttons: Preferences | Account (Account hidden when PWA + purchased) %>
      <div class="preferences-panel__tabs">
        <button type="button" class="preferences-panel__tab preferences-panel__tab--active" data-tab="preferences" data-action="click->fab-navigation#switchTab">Preferences</button>
        <button type="button" class="preferences-panel__tab" data-tab="account" data-action="click->fab-navigation#switchTab" data-standalone-hide="account-tab">Account</button>
      </div>
      <div class="side-drawer__body preferences-panel__body">
        <%# Preferences tab content %>
        <div data-fab-navigation-target="preferencesTab" class="preferences-panel__tab-content preferences-panel__tab-content--active">
          <div class="preferences-panel__grid">
            <%# Theme %>
            <div class="settings-sheet__section settings-sheet__section--theme pref-section">
              <div class="pref-section__label">Theme</div>
              <div class="theme-modal__grid">
                <% %w[classic lined graph vintage dark].each do |t| %>
                  <button class="theme-option<%= ' theme-option--active' if current_theme == t %>"
                          data-theme="<%= t %>"
                          data-action="click->fab-navigation#selectTheme"
                          aria-label="Select <%= t.capitalize %> theme">
                    <div class="theme-preview theme-btn--<%= t %>"></div>
                    <span class="theme-option__label"><%= t.capitalize %></span>
                  </button>
                <% end %>
              </div>
            </div>

            <%# Font %>
            <div class="settings-sheet__section settings-sheet__section--font pref-section">
              <div class="pref-section__label">Font</div>
              <div class="pref-font-list" id="pref-font-list">
                <% font_options = [
                     ['system_ui', 'System UI', "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"],
                     ['monospace', 'Monospace', "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Courier New', monospace"],
                     ['serif', 'Serif', "Georgia, 'Times New Roman', Times, serif"],
                     ['handwritten', 'Handwritten', "'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif"]
                   ] %>
                <% font_options.each do |value, label, stack| %>
                  <button class="pref-font-btn<%= ' pref-font-btn--active' if (current_user.font_family || 'default') == value %>"
                          data-font-value="<%= value %>"
                          style="font-family: <%= stack %>;"
                          onclick="applyFontFamily('<%= j value %>', '<%= j stack %>');">
                    <%= label %>
                  </button>
                <% end %>
              </div>
            </div>

            <%# Accent colour %>
            <div class="settings-sheet__section settings-sheet__section--accent pref-section">
              <div class="pref-section__label">Accent Colour</div>
              <div class="pref-color-swatches" id="pref-color-swatches">
                <% accent_swatches = ['#9966CC', '#CC3333', '#FF9933', '#CC9900', '#009933', '#3366CC', '#CC6699', '#666666'] %>
                <% accent_swatches.each do |color| %>
                  <button class="pref-color-swatch<%= ' pref-color-swatch--active' if (current_user.accent_color.presence || '#9966CC') == color %>"
                          style="background: <%= color %>;"
                          data-color="<%= color %>"
                          onclick="applyAccentColor('<%= color %>'); document.querySelectorAll('.pref-color-swatch').forEach(s => s.classList.remove('pref-color-swatch--active')); this.classList.add('pref-color-swatch--active');"
                          aria-label="Accent colour <%= color %>"></button>
                <% end %>
              </div>
            </div>

            <%# View Days %>
            <div class="settings-sheet__section settings-sheet__section--view pref-section">
              <div class="pref-section__label">View Days</div>
              <div class="pref-toggle-group">
                <a href="<%= app_root_path(days: 1) %>"
                   class="pref-toggle-btn<%= ' pref-toggle-btn--active' if (@view_days || 7) == 1 %>"
                   data-turbo-action="replace"
                   title="Today">T</a>
                <% [2, 3, 4, 5, 6, 7].each do |n| %>
                  <a href="<%= app_root_path(days: n) %>"
                     class="pref-toggle-btn<%= ' pref-toggle-btn--active' if (@view_days || 7) == n %>"
                     data-turbo-action="replace"
                     title="<%= n %> days"><%= n %></a>
                <% end %>
              </div>
            </div>

            <%# Completed %>
            <div class="settings-sheet__section settings-sheet__section--completed pref-section">
              <div class="pref-section__label">COMPLETED TASKS</div>
              <div class="pref-toggle-group">
                <button class="pref-toggle-btn pref-toggle-btn--active" id="pref-show-completed" onclick="toggleCompletedTodos(true); this.classList.add('pref-toggle-btn--active'); document.getElementById('pref-hide-completed').classList.remove('pref-toggle-btn--active');">Show</button>
                <button class="pref-toggle-btn" id="pref-hide-completed" onclick="toggleCompletedTodos(false); this.classList.add('pref-toggle-btn--active'); document.getElementById('pref-show-completed').classList.remove('pref-toggle-btn--active');">Hide</button>
              </div>
            </div>

            <%# Roll unfinished tasks to next day %>
            <div class="settings-sheet__section pref-section">
              <div class="pref-section__label">Roll to next day</div>
              <p class="pref-section__hint">Move unfinished tasks forward when you open the app</p>
              <div class="pref-toggle-group">
                <button class="pref-toggle-btn<%= ' pref-toggle-btn--active' if current_user.roll_over? %>"
                        id="pref-roll-over-yes"
                        onclick="toggleRollOver(true);">Yes</button>
                <button class="pref-toggle-btn<%= ' pref-toggle-btn--active' unless current_user.roll_over? %>"
                        id="pref-roll-over-no"
                        onclick="toggleRollOver(false);">No</button>
              </div>
            </div>

            <%# Lists placement %>
            <div class="settings-sheet__section pref-section">
              <div class="pref-section__label">Lists placement</div>
              <p class="pref-section__hint">Show Not Yet lists at the bottom or in a right side panel</p>
              <div class="pref-toggle-group">
                <button class="pref-toggle-btn<%= ' pref-toggle-btn--active' if (current_user.respond_to?(:lists_placement) ? (current_user.lists_placement.presence || 'right') : 'right') == 'bottom' %>"
                        id="pref-lists-bottom"
                        onclick="toggleListsPlacement('bottom');">Bottom</button>
                <button class="pref-toggle-btn<%= ' pref-toggle-btn--active' if (current_user.respond_to?(:lists_placement) ? (current_user.lists_placement.presence || 'right') : 'right') == 'right' %>"
                        id="pref-lists-right"
                        onclick="toggleListsPlacement('right');">Right</button>
              </div>
            </div>
          </div>
        </div>

        <%# Account tab content %>
        <div data-fab-navigation-target="accountTab" class="preferences-panel__tab-content" style="display:none;">
          <div class="pref-section" style="margin-bottom: 20px; padding: 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px;">
            <div class="pref-section__label" style="margin-bottom: 6px; color: #1e40af; font-weight: 600;">Keep your lists</div>
            <p style="font-size: 0.85rem; color: #1e3a8a; margin-bottom: 12px;">
              <% if current_user.hosted_ephemeral? && current_user.on_trial? %>
                <%= pluralize(current_user.trial_days_remaining, "day") %> left on this server. Export or clone the repo.
              <% else %>
                Export a JSON copy, or run the app from source.
              <% end %>
            </p>
            <%= link_to "Export data", export_trial_data_path, class: "pref-save-btn", style: "width: 100%; background: #2563eb; color: white; margin: 0; display: block; text-align: center; text-decoration: none;" %>
          </div>
          <%= form_with model: current_user, url: settings_path, method: :patch, local: true, class: "space-y-4", html: { "data-no-enter-submit" => "true" } do |form| %>
            <div class="pref-section">
              <div class="pref-section__label">Name</div>
              <%= form.text_field :name, class: "pref-input", placeholder: "Your name" %>
            </div>
            <div class="pref-section">
              <div class="pref-section__label">Email</div>
              <%= form.email_field :email_address, class: "pref-input" %>
            </div>
            <div class="pref-section">
              <div class="pref-section__label">Current Password</div>
              <%= form.password_field :current_password, class: "pref-input", placeholder: "Required for email/password changes" %>
            </div>
            <div class="pref-section">
              <div class="pref-section__label">New Password</div>
              <%= form.password_field :password, class: "pref-input", placeholder: "Leave blank to keep current" %>
            </div>
            <div class="pref-section">
              <div class="pref-section__label">Confirm Password</div>
              <%= form.password_field :password_confirmation, class: "pref-input", placeholder: "Confirm new password" %>
            </div>
            <div class="pref-section">
              <%= form.submit "Save Account", class: "pref-save-btn" %>
            </div>
          <% end %>
          <div class="pref-section" style="margin-top: 16px;">
            <button type="button" class="pref-save-btn" style="background-color: transparent; color: #4b5563; border: 1px solid #d1d5db;" onclick="window.showLogoutModal()">Sign out</button>
          </div>
          <div class="pref-section pref-section--danger" style="margin-top: 32px; border-top: 1px solid #ffebee; padding-top: 16px;">
            <%= link_to "Delete Account", delete_account_path, class: "pref-danger-link" %>
          </div>
        </div>
      </div>
      <%# Trial users: logo and app name at bottom of left panel %>
      <% if current_user.on_trial? %>
      <div class="preferences-panel__footer">
        <%= image_tag "peponito.png", alt: "Peponi.to", class: "preferences-panel__footer-logo", width: 36, height: 36 %>
        <span class="preferences-panel__footer-name">Peponi.to</span>
      </div>
      <% end %>
    </div>
  </div>

  <%# ── Notes Side Panel (slides from left, wider than preferences) ── %>
  <div data-controller="notes-panel"
       data-action="open-notes-panel@window->notes-panel#open keydown@document->notes-panel#closeOnEscape click@document->notes-panel#closeOnOverlay">

    <%# Overlay %>
    <div data-notes-panel-target="overlay" class="side-drawer__overlay" style="display:none;"></div>

    <%# Drawer %>
    <div data-notes-panel-target="drawer" class="side-drawer notes-drawer">

      <%# Header: todo title + close button %>
      <div class="notes-drawer__header">
        <div class="notes-drawer__title-row">
          <span class="notes-drawer__color-dot"></span>
          <h2 class="notes-drawer__title" data-notes-panel-target="title">Add a note to this task</h2>
        </div>
        <button data-action="click->notes-panel#close" class="side-drawer__close" aria-label="Close notes">&times;</button>
      </div>

      <%# Toolbar: formatting + date %>
      <div class="notes-drawer__toolbar">
        <div class="notes-drawer__format-btns">
          <button type="button" class="notes-fmt-btn" data-action="click->notes-panel#bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
          <button type="button" class="notes-fmt-btn notes-fmt-btn--italic" data-action="click->notes-panel#italic" title="Italic" aria-label="Italic"><em>I</em></button>
          <button type="button" class="notes-fmt-btn" data-action="click->notes-panel#insertLink" title="Insert link" aria-label="Insert link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button type="button" class="notes-fmt-btn" data-action="click->notes-panel#addSubtask" title="Add subtask" aria-label="Add subtask">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </button>
          <button type="button" class="notes-fmt-btn" data-action="click->notes-panel#insertBullet" title="Bullet list" aria-label="Bullet list">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
          <button type="button" class="notes-fmt-btn" data-action="click->notes-panel#insertImage" title="Insert image" aria-label="Insert image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </button>
        </div>
        <span class="notes-drawer__date" data-notes-panel-target="date"></span>
      </div>

      <%# Editor body %>
      <div class="notes-drawer__body">
        <div class="notes-drawer__editor"
             data-notes-panel-target="editor"
             data-action="input->notes-panel#onEditorInput"
             contenteditable="true"
             data-placeholder="Add notes"></div>

        <%# Subtask list %>
        <div class="notes-drawer__subtasks" data-notes-panel-target="subtaskList"></div>
      </div>

      <%# Save indicator %>
      <div class="notes-drawer__footer">
        <span class="notes-drawer__saved" data-notes-panel-target="savedIndicator"></span>
      </div>

      <%# Link insertion modal %>
      <div class="notes-link-modal" data-notes-panel-target="linkModal" style="display:none;">
        <div class="notes-link-modal__card">
          <div class="notes-link-modal__header">
            <h3 class="notes-link-modal__title">Insert Link</h3>
            <button type="button" class="notes-link-modal__close" data-action="click->notes-panel#closeLinkModal" aria-label="Close">&times;</button>
          </div>
          <input type="url"
                 class="notes-link-modal__input"
                 data-notes-panel-target="linkInput"
                 placeholder="https://example.com"
                 data-action="keydown->notes-panel#linkInputKeydown">
          <div class="notes-link-modal__actions">
            <button type="button" class="notes-link-modal__btn notes-link-modal__btn--cancel" data-action="click->notes-panel#closeLinkModal">Cancel</button>
            <button type="button" class="notes-link-modal__btn notes-link-modal__btn--insert" data-action="click->notes-panel#confirmLink">Insert</button>
          </div>
        </div>
      </div>

      <%# Hidden file input for image picker — opens device file explorer / camera / gallery %>
      <input type="file"
             accept="image/*"
             data-notes-panel-target="imageFileInput"
             data-action="change->notes-panel#onImageFileSelected"
             class="notes-image-file-input">
    </div>
  </div>

  <script>
  // ── Accent colour ──
  function applyAccentColor(color) {
    document.documentElement.style.setProperty('--user-accent', color);
    document.documentElement.style.setProperty('--accent', color);
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/app/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf, 'X-HTTP-Method-Override': 'PATCH' },
      body: JSON.stringify({ user: { accent_color: color } })
    }).catch(() => {});
  }

  // ── Font family ──
  function applyFontFamily(value, stack) {
    if (stack) {
      document.documentElement.style.setProperty('--user-font', stack);
    }
    if (value === 'handwritten') {
      document.body.classList.add('body--font-handwritten');
    } else {
      document.body.classList.remove('body--font-handwritten');
    }
    document.querySelectorAll('.pref-font-btn').forEach(b => b.classList.remove('pref-font-btn--active'));
    const active = document.querySelector(`.pref-font-btn[data-font-value="${value}"]`);
    if (active) active.classList.add('pref-font-btn--active');
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/app/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf, 'X-HTTP-Method-Override': 'PATCH' },
      body: JSON.stringify({ user: { font_family: value } })
    }).catch(() => {});
  }

  // ── Show/Hide completed ──
  function toggleCompletedTodos(show) {
    document.querySelectorAll('.todo-item--done').forEach(el => { el.style.display = show ? '' : 'none'; });
    localStorage.setItem('showCompleted', show);
  }

  // ── Roll over unfinished to-dos ──
  function toggleRollOver(enabled) {
    var yesEl = document.getElementById('pref-roll-over-yes');
    var noEl = document.getElementById('pref-roll-over-no');
    if (yesEl) yesEl.classList.toggle('pref-toggle-btn--active', enabled);
    if (noEl) noEl.classList.toggle('pref-toggle-btn--active', !enabled);
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/app/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf, 'X-HTTP-Method-Override': 'PATCH' },
      body: JSON.stringify({ user: { roll_over: enabled } })
    }).catch(function() {});
  }

  // ── Lists placement (bottom vs right side panel) ──
  function toggleListsPlacement(placement) {
    var bottomEl = document.getElementById('pref-lists-bottom');
    var rightEl = document.getElementById('pref-lists-right');
    if (bottomEl) bottomEl.classList.toggle('pref-toggle-btn--active', placement === 'bottom');
    if (rightEl) rightEl.classList.toggle('pref-toggle-btn--active', placement === 'right');
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/app/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf, 'X-HTTP-Method-Override': 'PATCH' },
      body: JSON.stringify({ user: { lists_placement: placement } })
    }).then(function() {
      window.location.reload();
    }).catch(function() {});
  }

  // Apply saved preference on page load
  document.addEventListener('turbo:load', function() {
    const show = localStorage.getItem('showCompleted') !== 'false';
    if (!show) document.querySelectorAll('.todo-item--done').forEach(el => { el.style.display = 'none'; });
    const celebEl = document.getElementById('pref-celebrations');
    if (celebEl) celebEl.checked = localStorage.getItem('celebrations') !== 'false';
  });
  </script>

<% end %>
