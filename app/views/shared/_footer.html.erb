<!-- Footer -->
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Link Sections - 3 columns above -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Product Links -->
      <div>
        <h3 class="font-semibold mb-4">Product</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Features", "#features", class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Why Todo-it", why_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Pricing", pricing_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "How to Use", how_to_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
      
      <!-- Support Links -->
      <div>
        <h3 class="font-semibold mb-4">Support</h3>
        <ul class="space-y-2 text-gray-400">
          <li><a href="mailto:support@todo-it.app" class="hover:text-white transition-colors">Contact Support</a></li>
          <li><%= link_to "Sign In", login_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Create Account", signup_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
      
      <!-- Legal Links -->
      <div>
        <h3 class="font-semibold mb-4">Legal</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Privacy Policy", privacy_policy_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Terms of Service", terms_of_service_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
    </div>
    
    <!-- Brand Section - Full width at bottom -->
    <div class="border-t border-gray-700 pt-8">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="logo-checkbox mr-3" style="filter: brightness(0) invert(1);"></div>
          <span class="text-2xl font-bold mr-3">Todo-it</span>
        </div>
        <p class="text-gray-400 text-sm">
          Beautiful notebook-style todo pages that make productivity feel personal and delightful. • © 2025 Todo-it. Made with ❤️ in Bolton, UK.
        </p>
      </div>
    </div>
</footer>
