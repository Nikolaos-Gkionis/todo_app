<footer class="mkt-footer">
  <div class="mkt-inner">
    <div class="mkt-footer__grid mkt-footer__grid--compact">

      <!-- Brand -->
      <div>
        <div class="mkt-footer__brand-name">
          <div class="logo-checkbox" style="filter: brightness(0) invert(1);"></div>
          Todo-it
        </div>
        <p class="mkt-footer__brand-desc">
          Beautiful notebook-style todo pages. Private by design.
          Try free for 7 days, download forever for $9.99.
          <a href="mailto:support@todo-it.app" class="mkt-footer__link">Contact support</a>.
        </p>
        <p class="mkt-footer__tagline">Made with care in Bolton, UK.</p>
      </div>

      <!-- Legal -->
      <div>
        <div class="mkt-footer__col-title">Legal</div>
        <ul class="mkt-footer__links">
          <li><%= link_to "Privacy Policy", privacy_policy_path, class: "mkt-footer__link" %></li>
          <li><%= link_to "Terms of Service", terms_of_service_path, class: "mkt-footer__link" %></li>
        </ul>
      </div>

    </div>

    <div class="mkt-footer__bottom">
      <p class="mkt-footer__copyright">&copy; 2025 Todo-it. All rights reserved.</p>
      <p class="mkt-footer__copyright">Beautiful notebook-style todo pages &middot; Private by design</p>
    </div>
  </div>
</footer>
