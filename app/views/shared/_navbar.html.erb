      <div class="mobile-menu__header">
        <%= link_to (defined?(root_path) ? root_path : pages_path), class: "flex items-center" do %>
          <%= image_tag "peponito.png", alt: "Peponi.to", class: "navbar__logo-img navbar__logo-img--nav mr-3", width: 50, height: 50 %>
          <span class="navbar__logo-text">Peponi.to</span>
        <% end %>
        <button type="button" class="mobile-menu__close-btn mobile-menu-close">
          <span class="sr-only">Close menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
