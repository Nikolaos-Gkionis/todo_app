      <!-- Mobile Menu Content -->
      <div class="mobile-menu__content">
        <% if @marketing_nav %>
          <!-- Marketing Mobile Navigation -->
          <div class="mobile-menu__nav-list">
            <%= link_to "Home", root_path, class: "mobile-menu__nav-link #{current_page?(root_path) ? 'mobile-menu__nav-link--active' : ''}" %>
            <%= link_to "Why", why_path, class: "mobile-menu__nav-link #{current_page?(why_path) ? 'mobile-menu__nav-link--active' : ''}" %>
            <%= link_to "Pricing", pricing_path, class: "mobile-menu__nav-link #{current_page?(pricing_path) ? 'mobile-menu__nav-link--active' : ''}" %>
            <%= link_to "How to Use", how_to_path, class: "mobile-menu__nav-link #{current_page?(how_to_path) ? 'mobile-menu__nav-link--active' : ''}" %>
