<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="mkt-hero">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.5rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      Get in touch
    </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
      Contact us
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto;">
      Have a question, feedback, or need help? Send us a message and we'll get back to you soon.
    </p>
  </div>
</section>

<!-- Contact Form -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-reveal" data-scroll-reveal-target="item" style="max-width: 32rem; margin: 0 auto;">

      <% if flash[:alert] %>
        <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-red-800" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: contact_path, local: true, method: :post, class: "space-y-6" do |form| %>

        <!-- Honeypot: hidden from humans, bots fill it -->
        <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true"
               style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">

        <div>
          <%= form.label :name, "Name (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name,
                value: params[:name],
                placeholder: "Your name",
                class: "w-full form-input px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email,
                value: params[:email],
                placeholder: "your@email.com",
                required: true,
                class: "w-full form-input px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= form.label :message, "Message", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :message,
                value: params[:message],
                placeholder: "How can I help?",
                required: true,
                rows: 5,
                class: "w-full form-input px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-y" %>
        </div>

        <div>
          <%= form.submit "Send message",
                class: "mkt-btn mkt-btn--primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render 'shared/footer' %>
</div>
