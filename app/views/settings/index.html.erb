<div class="container mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <%= link_to "← Back to Pages", pages_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold">Account Settings</h1>
    <p class="text-gray-600 mt-2">Manage your account information and preferences</p>
  </div>

  <div class="max-w-2xl space-y-8">
    <%# Prominent Buy CTA: show for anyone who hasn't purchased (hidden when running as installed PWA via JS) %>
    <% unless current_user.device_downloaded? %>
    <div class="notebook-card bg-blue-50 border-blue-200 border" data-standalone-hide="buy">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-blue-900 mb-1">Enjoying Peponi.to?</h2>
          <p class="text-sm text-blue-800">Purchase once to own it forever and install the PWA on up to three devices. Trial users stay on the website until then. On Omarchy you can use a free local overlay with no account.</p>
        </div>
        <%= button_to "Buy Download (£9.99)",
              create_checkout_session_path,
              method: :post,
              data: { turbo: false },
              class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 flex-shrink-0" %>
      </div>
    </div>
    <% end %>

    <!-- Account Information Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Account Information</h2>

      <%= form_with model: @user, url: settings_path, method: :patch, local: true, class: "space-y-6" do |form| %>
        <!-- Display validation errors -->
        <% if @user.errors.any? %>
          <div class="text-red-700 mb-4">
            <h3 class="font-medium mb-2">
              ⚠️ <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
            </h3>
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Name Update -->
        <div>
          <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :name,
                placeholder: "Enter your name",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Email Update -->
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.email_field :email_address,
                placeholder: "Enter your email",
                required: true,
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Current Password (required for email/password changes) -->
        <div>
          <%= form.label :current_password, "Current Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :current_password,
                placeholder: "Enter your current password to make changes",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
          <p class="text-sm text-gray-500 mt-1">Required to update your email or password. Optional for name changes.</p>
        </div>

        <!-- New Password (optional) -->
        <div>
          <%= form.label :password, "New Password (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password,
                placeholder: "Leave blank to keep current password",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Confirm New Password -->
        <div>
          <%= form.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password_confirmation,
                placeholder: "Confirm your new password",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Submit Button -->
        <div>
          <button type="submit" class="text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue cursor-pointer bg-transparent border-0 inline-block">
            Update Account
          </button>
        </div>
      <% end %>
    </div>

    <!-- Appearance / Advanced Settings -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Appearance</h2>
      <p class="text-gray-600 text-sm mb-4">Customize accent color and typography. These settings apply across all themes.</p>

      <%= form_with model: @user, url: settings_path, method: :patch, local: true, data: { turbo: false }, html: { id: "appearance-form", "data-turbo": "false" }, class: "space-y-6" do |form| %>
        <!-- Accent color picker -->
        <div>
          <%= form.label :accent_color, "Accent color", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex flex--align-center gap-4">
            <input type="color"
                   name="user[accent_color]"
                   id="user_accent_color"
                   value="<%= @user.accent_color.presence || '#9966CC' %>"
                   class="h-10 w-16 cursor-pointer rounded border border-gray-300">
            <input type="text"
                   id="user_accent_color_hex"
                   value="<%= @user.accent_color.presence || '#9966CC' %>"
                   class="form-input w-24 font-mono text-sm"
                   placeholder="#3b82f6"
                   maxlength="7"
                   autocomplete="off">
            <span class="text-sm text-gray-500">or leave default blue</span>
          </div>
          <p class="text-sm text-gray-500 mt-1">Used for links, buttons, and highlights.</p>
        </div>

        <!-- Font family -->
        <div>
          <%= form.label :font_family, "Typography", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.select :font_family,
                options_for_select([
                  [ "Default (handwritten)", "default" ],
                  [ "Serif (Lora)", "serif" ],
                  [ "Sans Serif (Inter)", "sans_serif" ]
                ], @user.font_family || "default"),
                {},
                class: "form-input w-full max-w-xs" %>
          <p class="text-sm text-gray-500 mt-1">Choose a font for your todo text.</p>
        </div>

        <div>
          <button type="submit" class="text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue cursor-pointer bg-transparent border-0 inline-block">
            Save Appearance
          </button>
        </div>
      <% end %>

      <script>
      (function() {
        var colorInput = document.getElementById('user_accent_color');
        var hexInput = document.getElementById('user_accent_color_hex');
        var form = colorInput && colorInput.closest('form');
        if (colorInput && hexInput) {
          colorInput.addEventListener('input', function() {
            hexInput.value = this.value;
          });
          hexInput.addEventListener('input', function() {
            if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
              colorInput.value = this.value;
            }
          });
          if (form) {
            form.addEventListener('submit', function() {
              if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
                colorInput.value = hexInput.value;
              }
            });
          }
        }
      })();
      </script>
    </div>

    <!-- Trial & Download Status Section -->
    <% unless current_user.device_downloaded? %>
      <div class="notebook-card">
        <h2 class="text-xl font-semibold mb-6">Trial & Download Status</h2>

        <% if current_user.trial_active? %>
        <div class="bg-blue-50 border border-blue-200 rounded-md p-4 mb-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">
                Free Trial Active
              </h3>
              <div class="mt-2 text-sm text-blue-700">
                <p>You have <strong><%= pluralize(current_user.trial_days_remaining, 'day') %></strong> remaining in your free trial.</p>
              </div>
            </div>
          </div>
        </div>
        <% end %>

        <!-- Purchase Options - Only show buy button for non-purchased users -->
        <% unless current_user.device_downloaded? %>
        <div class="border-t border-gray-200 pt-4" data-standalone-hide="buy">
          <p class="text-sm text-gray-600 mb-3">Purchase the app to continue using Peponi.to:</p>
          <div class="flex flex-wrap gap-3">
            <%= button_to "Buy App (£9.99)",
                  create_checkout_session_path,
                  method: :post,
                  data: { turbo: false },
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>          </div>
        </div>
        <% end %>

        <!-- Download Options - Only show for purchased users -->
        <% if current_user.device_downloaded? %>
        <div class="border-t border-gray-200 pt-4">
          <div class="bg-green-50 border border-green-200 rounded-md p-4 mb-4">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-green-800">App Purchased</h3>
                <div class="mt-2 text-sm text-green-700">
                  <p>You own Peponi.to! Download it on any device using the link below.</p>
                </div>
              </div>
            </div>
          </div>
          
          <p class="text-sm text-gray-600 mb-3">Download Peponi.to on any device:</p>
          <div class="flex flex-wrap gap-3">
            <%= link_to "Download App",
                  download_path,
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        </div>
        <% end %>

        <% if current_user.trial_expired? %>
        <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                Trial Expired
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <p>Your 7-day free trial has ended. Purchase Peponi.to to keep using your account.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Purchase App -->
        <div class="border-t border-gray-200 pt-4" data-standalone-hide="buy">
          <p class="text-sm text-gray-600 mb-3">Purchase the app to continue using Peponi.to:</p>
          <%= button_to "Buy App (£9.99)",
                create_checkout_session_path,
                method: :post,
                data: { turbo: false },
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
        </div>
      <% end %>

      <!-- Trial Management -->
      <div class="border-t border-gray-200 pt-4">
        <p class="text-sm text-gray-600 mb-3">Manage your trial and download:</p>
        <div class="flex flex-wrap gap-2">
          <%= link_to "View Trial Status",
                trial_status_path,
                class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
          <% if current_user.on_trial? %>
            <%= link_to "Export Data",
                  export_trial_data_path,
                  class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Account Actions Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Account Actions</h2>

      <div class="mb-6">
        <p class="text-sm text-gray-600 mb-3">Sign out of your account on this device.</p>
        <button type="button" class="text-gray-600 hover:text-gray-800 font-medium hand-underline inline-block bg-transparent border-0 cursor-pointer text-base p-0" onclick="window.showLogoutModal()">
          Sign out
        </button>
      </div>

      <h2 class="text-xl font-semibold mb-6 text-red-700 mt-8 border-t border-gray-200 pt-6">Danger Zone</h2>

      <div>
        <p class="text-sm text-gray-600 mb-3">Once you delete your account, there is no going back. Please be certain.</p>
        <%= link_to "Delete Account",
              delete_account_path,
              class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline--red" %>
      </div>
    </div>
  </div>
</div>
