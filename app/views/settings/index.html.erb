<div class="container mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <%= link_to "← Back to Pages", pages_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold">Account Settings</h1>
    <p class="text-gray-600 mt-2">Manage your account information and preferences</p>
  </div>

  <div class="max-w-2xl space-y-8">
    <!-- Account Information Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Account Information</h2>

      <%= form_with model: @user, url: settings_path, method: :patch, local: true, class: "space-y-6" do |form| %>
        <!-- Display validation errors -->
        <% if @user.errors.any? %>
          <div class="text-red-700 mb-4">
            <h3 class="font-medium mb-2">
              ⚠️ <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
            </h3>
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Name Update -->
        <div>
          <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :name,
                placeholder: "Enter your name",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Email Update -->
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.email_field :email_address,
                placeholder: "Enter your email",
                required: true,
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Current Password (required for email/password changes) -->
        <div>
          <%= form.label :current_password, "Current Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :current_password,
                placeholder: "Enter your current password to make changes",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          <p class="text-sm text-gray-500 mt-1">Required to update your email or password. Optional for name changes.</p>
        </div>

        <!-- New Password (optional) -->
        <div>
          <%= form.label :password, "New Password (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password,
                placeholder: "Leave blank to keep current password",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Confirm New Password -->
        <div>
          <%= form.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password_confirmation,
                placeholder: "Confirm your new password",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Submit Button -->
        <div>
          <button type="submit" class="text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline-blue cursor-pointer bg-transparent border-0 inline-block">
            Update Account
          </button>
        </div>
      <% end %>
    </div>

    <!-- Premium Status Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Subscription & Billing</h2>

      <% if @user.premium? %>
        <div class="bg-green-50 border border-green-200 rounded-md p-4 mb-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-green-800">
                Premium Account Active
              </h3>
              <div class="mt-2 text-sm text-green-700">
                <p>You have unlimited pages and access to all premium features.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Stripe Customer Portal Link -->
        <div class="border-t border-gray-200 pt-4">
          <p class="text-sm text-gray-600 mb-3">Manage your billing:</p>
          <%= link_to "Manage Billing",
                customer_portal_path,
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% else %>
        <div class="bg-orange-50 border border-orange-200 rounded-md p-4 mb-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-orange-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-orange-800">
                Free Account
              </h3>
              <div class="mt-2 text-sm text-orange-700">
                <p>You have <%= @user.remaining_pages %> page<%= 's' if @user.remaining_pages != 1 %> remaining and limited access to premium features.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Upgrade Link -->
        <div class="border-t border-gray-200 pt-4">
          <%= button_to "Upgrade to Premium",
                create_checkout_session_path,
                method: :post,
                data: { turbo: false },
                class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline-blue cursor-pointer bg-transparent border-0" %>
        </div>
      <% end %>
    </div>

    <!-- Account Actions Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6 text-red-700">Danger Zone</h2>

      <div class="border-t border-red-200 pt-4">
        <p class="text-sm text-gray-600 mb-3">Once you delete your account, there is no going back. Please be certain.</p>
        <%= link_to "Delete Account",
              delete_account_path,
              class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline-red" %>
      </div>
    </div>
  </div>
</div>
