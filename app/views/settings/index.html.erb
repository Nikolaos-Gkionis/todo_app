<div class="container mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <%= link_to "← Back to Pages", pages_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold">Account Settings</h1>
    <p class="text-gray-600 mt-2">Manage your account information and preferences</p>
  </div>

  <div class="max-w-2xl space-y-8">
    <%# Keep-it CTA: export and source, not a shop %>
    <div class="notebook-card bg-blue-50 border-blue-200 border">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-blue-900 mb-1">Keep your lists</h2>
          <p class="text-sm text-blue-800">
            <% if current_user.hosted_ephemeral? && current_user.on_trial? %>
              This hosted week has <strong><%= pluralize(current_user.trial_days_remaining, "day") %></strong> left, then I delete the account.
            <% else %>
              This instance is yours.
            <% end %>
            Export a JSON copy, or clone the repo and run it yourself.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "Export data",
                export_trial_data_path,
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
          <%= link_to "GitHub",
                github_source_url,
                target: "_blank",
                rel: "noopener",
                class: "inline-flex items-center px-4 py-2 border border-blue-300 text-sm font-medium rounded-md text-blue-800 bg-white hover:bg-blue-50" %>
        </div>
      </div>
    </div>

    <!-- Account Information Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Account Information</h2>

      <%= form_with model: @user, url: settings_path, method: :patch, local: true, class: "space-y-6" do |form| %>
        <!-- Display validation errors -->
        <% if @user.errors.any? %>
          <div class="text-red-700 mb-4">
            <h3 class="font-medium mb-2">
              ⚠️ <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
            </h3>
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Name Update -->
        <div>
          <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :name,
                placeholder: "Enter your name",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Email Update -->
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.email_field :email_address,
                placeholder: "Enter your email",
                required: true,
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Current Password (required for email/password changes) -->
        <div>
          <%= form.label :current_password, "Current Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :current_password,
                placeholder: "Enter your current password to make changes",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
          <p class="text-sm text-gray-500 mt-1">Required to update your email or password. Optional for name changes.</p>
        </div>

        <!-- New Password (optional) -->
        <div>
          <%= form.label :password, "New Password (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password,
                placeholder: "Leave blank to keep current password",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Confirm New Password -->
        <div>
          <%= form.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password_confirmation,
                placeholder: "Confirm your new password",
                class: "form-input w-full px-3 py-2 pulse-focus" %>
        </div>

        <!-- Submit Button -->
        <div>
          <button type="submit" class="text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue cursor-pointer bg-transparent border-0 inline-block">
            Update Account
          </button>
        </div>
      <% end %>
    </div>

    <!-- Appearance / Advanced Settings -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Appearance</h2>
      <p class="text-gray-600 text-sm mb-4">Customize accent color and typography. These settings apply across all themes.</p>

      <%= form_with model: @user, url: settings_path, method: :patch, local: true, data: { turbo: false }, html: { id: "appearance-form", "data-turbo": "false" }, class: "space-y-6" do |form| %>
        <!-- Accent color picker -->
        <div>
          <%= form.label :accent_color, "Accent color", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex flex--align-center gap-4">
            <input type="color"
                   name="user[accent_color]"
                   id="user_accent_color"
                   value="<%= @user.accent_color.presence || '#9966CC' %>"
                   class="h-10 w-16 cursor-pointer rounded border border-gray-300">
            <input type="text"
                   id="user_accent_color_hex"
                   value="<%= @user.accent_color.presence || '#9966CC' %>"
                   class="form-input w-24 font-mono text-sm"
                   placeholder="#3b82f6"
                   maxlength="7"
                   autocomplete="off">
            <span class="text-sm text-gray-500">or leave default blue</span>
          </div>
          <p class="text-sm text-gray-500 mt-1">Used for links, buttons, and highlights.</p>
        </div>

        <!-- Font family -->
        <div>
          <%= form.label :font_family, "Typography", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.select :font_family,
                options_for_select([
                  [ "Default (handwritten)", "default" ],
                  [ "Serif (Lora)", "serif" ],
                  [ "Sans Serif (Inter)", "sans_serif" ]
                ], @user.font_family || "default"),
                {},
                class: "form-input w-full max-w-xs" %>
          <p class="text-sm text-gray-500 mt-1">Choose a font for your todo text.</p>
        </div>

        <div>
          <button type="submit" class="text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue cursor-pointer bg-transparent border-0 inline-block">
            Save Appearance
          </button>
        </div>
      <% end %>

      <script>
      (function() {
        var colorInput = document.getElementById('user_accent_color');
        var hexInput = document.getElementById('user_accent_color_hex');
        var form = colorInput && colorInput.closest('form');
        if (colorInput && hexInput) {
          colorInput.addEventListener('input', function() {
            hexInput.value = this.value;
          });
          hexInput.addEventListener('input', function() {
            if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
              colorInput.value = this.value;
            }
          });
          if (form) {
            form.addEventListener('submit', function() {
              if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
                colorInput.value = hexInput.value;
              }
            });
          }
        }
      })();
      </script>
    </div>

    <!-- Your data -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Your data</h2>
      <p class="text-sm text-gray-600 mb-3">Download a JSON copy of your lists. Handy before a hosted week ends, or when you move to your own instance.</p>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Export data",
              export_trial_data_path,
              class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= link_to "Install on this device",
              install_pwa_path,
              class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      </div>
    </div>

    <!-- Account Actions Section -->
    <div class="notebook-card">
      <h2 class="text-xl font-semibold mb-6">Account Actions</h2>

      <div class="mb-6">
        <p class="text-sm text-gray-600 mb-3">Sign out of your account on this device.</p>
        <button type="button" class="text-gray-600 hover:text-gray-800 font-medium hand-underline inline-block bg-transparent border-0 cursor-pointer text-base p-0" onclick="window.showLogoutModal()">
          Sign out
        </button>
      </div>

      <h2 class="text-xl font-semibold mb-6 text-red-700 mt-8 border-t border-gray-200 pt-6">Danger Zone</h2>

      <div>
        <p class="text-sm text-gray-600 mb-3">Once you delete your account, there is no going back. Please be certain.</p>
        <%= link_to "Delete Account",
              delete_account_path,
              class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline--red" %>
      </div>
    </div>
  </div>
</div>
