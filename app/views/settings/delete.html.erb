<div class="container mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <%= link_to "← Back to Settings", settings_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block hand-underline hand-underline--blue" %>
    <h1 class="text-3xl font-bold text-red-700">Delete Account</h1>
    <p class="text-gray-600 mt-2">This action cannot be undone. This will permanently delete your account and all associated data.</p>
  </div>

  <div class="max-w-2xl">
    <!-- Warning Section -->
    <div class="notebook-card bg-red-50 border-red-200">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            Are you absolutely sure?
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <p class="mb-2">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
            <ul class="list-disc pl-5 space-y-1">
              <li>All your pages and todos will be permanently deleted</li>
              <li>Your account information will be removed</li>
              <li>You will lose access to any premium features</li>
              <li>This action is irreversible</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Confirmation Form -->
    <div class="notebook-card mt-6">
      <h2 class="text-xl font-semibold mb-6">Confirm Account Deletion</h2>

      <%= form_with url: settings_path, method: :delete, local: true, class: "space-y-6" do |form| %>
        <!-- Display validation errors -->
        <% if alert %>
          <div class="text-red-700 mb-4">
            ⚠️ <%= alert %>
          </div>
        <% end %>

        <div>
          <%= form.label :confirm_deletion, "Please type DELETE to confirm", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :confirm_deletion,
                placeholder: "Type DELETE here",
                required: true,
                class: "form-input w-full px-3 py-2 pulse-focus",
                style: "font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif !important;" %>
          <p class="text-sm text-gray-500 mt-1">This is to ensure you really want to delete your account.</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex space-x-4">
          <%= form.submit "Delete Account Permanently",
                class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline--red cursor-pointer bg-transparent border-0",
                data: { confirm: "Are you sure you want to delete your account? This action cannot be undone!" } %>

          <%= link_to "Cancel",
                settings_path,
                class: "text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline--gray" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
