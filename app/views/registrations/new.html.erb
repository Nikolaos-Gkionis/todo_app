<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-sm w-full space-y-8">
    <!-- Back link -->
    <div class="text-center">
      <%= link_to "← Back to Home", root_path, class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue" %>
    </div>
    
    <div>
      <h1 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        Create your account
      </h1>
    </div>
    
    <%= form_with model: @user, url: signup_path, local: true, class: "mt-8 space-y-6" do |form| %>
      <!-- Display validation errors -->
      <% if @user.errors.any? %>
        <div class="text-red-700 mb-4 text-center" role="alert">
          <h3 class="font-medium mb-2">
            ⚠️ <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
          </h3>
          <ul class="list-disc pl-5 space-y-1 text-left">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name,
                placeholder: "Name",
                required: true,
                class: "w-full form-input" %>
        </div>
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email_address,
                placeholder: "Email",
                required: true,
                class: "w-full form-input" %>
        </div>
        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.password_field :password, 
                placeholder: "Password", 
                required: true,
                class: "w-full form-input" %>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.password_field :password_confirmation, 
                placeholder: "Confirm Password", 
                required: true,
                class: "w-full form-input" %>
        </div>
      </div>

      <div>
        <%= form.submit "Create Account", 
              class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline-blue cursor-pointer bg-transparent border-0 w-full flex justify-center" %>
      </div>
      
      <div class="text-center">
        <p class="text-sm text-gray-600">
          Already have an account? 
          <%= link_to "Sign in", login_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
        </p>
      </div>
    <% end %>
  </div>
</div>