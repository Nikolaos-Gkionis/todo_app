<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<section class="mkt-hero mkt-hero--auth">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.25rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      7 days on this server. Then I delete the account.
        </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
      Create your account
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto;">
      Email and a password. That’s the whole signup.
    </p>
  </div>
</section>

<section class="mkt-section bg-white" style="padding-top: 0;">
  <div class="mkt-inner">
    <div class="mkt-auth-card mkt-reveal" data-scroll-reveal-target="item">
      <% if @user.errors.any? %>
        <div class="mkt-auth-errors" role="alert">
          <p class="mkt-auth-errors__title">
            <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
          </p>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: signup_path, local: true, class: "mkt-auth-form" do |form| %>
        <div>
          <%= form.label :name, "Name", class: "mkt-auth-label" %>
          <%= form.text_field :name,
                placeholder: "Your name",
                required: true,
                autocomplete: "name",
                class: "form-input mkt-auth-input" %>
        </div>
        <div>
          <%= form.label :email_address, "Email", class: "mkt-auth-label" %>
          <%= form.email_field :email_address,
                placeholder: "you@example.com",
                required: true,
                autocomplete: "email",
                class: "form-input mkt-auth-input" %>
        </div>
        <div>
          <%= form.label :password, "Password", class: "mkt-auth-label" %>
          <%= form.password_field :password,
                placeholder: "At least 6 characters",
                required: true,
                autocomplete: "new-password",
                class: "form-input mkt-auth-input" %>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirm Password", class: "mkt-auth-label" %>
          <%= form.password_field :password_confirmation,
                placeholder: "Confirm Password",
                required: true,
                autocomplete: "new-password",
                class: "form-input mkt-auth-input" %>
        </div>

        <%= form.submit "Create Account", class: "mkt-btn mkt-btn--primary mkt-auth-submit" %>
      <% end %>

      <p class="mkt-auth-alt">
        Already have an account?
        <%= link_to "Sign in", login_path %>
      </p>
    </div>
  </div>
</section>

<%= render 'shared/footer' %>
</div>
