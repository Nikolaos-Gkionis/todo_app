<%# Post-payment PWA install guide — no marketing mix, stays in app flow with FAB/account %>
<div class="download-header">
  <div class="container">
    <div class="download-header__content">
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-bottom: 1rem;">
        <% back_to_download_path = params[:token].present? ? download_path(token: @download_token) : download_path %>
        <%= link_to back_to_download_path, class: "download-header__back", style: "display: inline-flex; align-items: center; gap: 0.5rem; color: #4b5563; text-decoration: none; font-size: 0.95rem;" do %>
          ← Back to download
        <% end %>
        <%= link_to app_root_path, class: "download-header__back", style: "display: inline-flex; align-items: center; gap: 0.5rem; color: #4b5563; text-decoration: none; font-size: 0.95rem;" do %>
          ← Back to app
        <% end %>
      </div>
      <h1 class="download-header__title">📱 Install Peponi.to as a PWA</h1>
      <p class="download-header__subtitle">
        Your app, on your device — no browser chrome, full screen, viewport lock.
      </p>
    </div>
  </div>
</div>

<div class="download-instructions">
  <div class="container">
    <h3 class="download-instructions__title">Step-by-step guide</h3>
    <p style="margin-bottom: 1.5rem; color: #4b5563;">
      After downloading the app bundle, follow the instructions below for your device.
      The FAB (☰) and account icon in the app give you theme, preferences, and settings.
    </p>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 56rem; margin: 0 auto;" class="install-guide-grid">
      <%# Mobile %>
      <div style="background: #fff; border: 1px solid #D8D4CC; border-radius: 1rem; padding: 1.75rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem; background: #dbeafe; color: #2563eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📱</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: #4E5C64;">Mobile</div>
          <div style="font-size: 0.85rem; color: #6b7280;">iOS &amp; Android</div>
        </div>
        <ol style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Download the app</strong> — Click "Download App" from your download page.</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Open in browser</strong> — Open the file in Safari (iOS) or Chrome (Android).</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Add to Home Screen</strong> — <strong>iOS:</strong> Share → "Add to Home Screen" &nbsp;|&nbsp; <strong>Android:</strong> Menu (⋮) → "Add to Home Screen"</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Launch</strong> — Tap the Peponi.to icon for full screen, no browser chrome.</li>
        </ol>
      </div>

      <%# Desktop %>
      <div style="background: #fff; border: 1px solid #D8D4CC; border-radius: 1rem; padding: 1.75rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem; background: #dcfce7; color: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">💻</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: #4E5C64;">Desktop</div>
          <div style="font-size: 0.85rem; color: #6b7280;">Windows, Mac &amp; Linux</div>
        </div>
        <ol style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Download the app</strong> — Click "Download App" from your download page.</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Open in Chrome or Edge</strong> — Open the downloaded file in your browser.</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Install</strong> — Look for the install icon (⊕) in the address bar, or use the menu → "Install app".</li>
          <li style="font-size: 0.95rem; color: #4b5563; line-height: 1.6;"><strong>Launch</strong> — Find Peponi.to in Applications or your dock.</li>
        </ol>
      </div>
    </div>

    <%# Benefits %>
    <div style="margin-top: 2.5rem; text-align: center;">
      <h3 style="font-size: 1.15rem; font-weight: 700; color: #4E5C64; margin-bottom: 1.5rem;">Why install as a PWA?</h3>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 42rem; margin: 0 auto;">
        <div style="text-align: center;">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">⚡</div>
          <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem;">Lightning Fast</div>
          <p style="font-size: 0.85rem; color: #6b7280; line-height: 1.5;">Loads instantly, works offline</p>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🔒</div>
          <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem;">Private &amp; Secure</div>
          <p style="font-size: 0.85rem; color: #6b7280; line-height: 1.5;">Your data stays on your device</p>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">✨</div>
          <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem;">Native Feel</div>
          <p style="font-size: 0.85rem; color: #6b7280; line-height: 1.5;">Full screen, viewport lock</p>
        </div>
      </div>
    </div>

    <%# CTA: Download or Back to app %>
    <div style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      <% go_to_download_path = params[:token].present? ? download_path(token: params[:token]) : download_path %>
      <%= link_to go_to_download_path, class: "download-button download-button--primary" do %>
        📥 Go to Download page
      <% end %>
      <%= link_to app_root_path, class: "download-button download-button--secondary" do %>
        Back to app
      <% end %>
    </div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .install-guide-grid { grid-template-columns: 1fr !important; }
    .install-guide-grid + div [style*="grid-template-columns: repeat(3)"] { grid-template-columns: 1fr !important; }
  }
</style>
