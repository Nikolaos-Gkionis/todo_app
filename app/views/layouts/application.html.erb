<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || (logged_in? && current_user&.app_title.presence) || "Peponi.to" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA manifest: only for paid users (trial users cannot install) — full URL helps Chrome show install icon %>
    <% if logged_in? && current_user&.can_install_pwa? %>
      <%= tag.link rel: "manifest", href: pwa_manifest_url(format: :json), crossorigin: "use-credentials" %>
    <% end %>

    <!-- Favicon and App Icons -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#ffffff">
    
    <!-- App Meta Tags -->
    <meta name="description" content="Peponi.to - Organise tasks by day. 100% Yours.">
    <meta name="author" content="Peponi.to">
    <meta property="og:title" content="Peponi.to - Organise Your Days">
    <meta property="og:description" content="Reduced mental clutter. Offline-first. Zero-Cloud. Private by design.">
    <meta property="og:type" content="website">

    <%# Preconnect to fonts for snappy font switching %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# Custom BEM-based CSS system - no Tailwind needed! %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# User accent & font (Advanced Settings) - only when logged in %>
    <% if logged_in? && current_user %>
      <style>
        :root {
          --user-accent: <%= current_user.accent_color.presence || '#9966CC' %>;
          <% if (stack = font_stack_for(current_user)) %>
          --user-font: <%= raw stack %>;
          <% else %>
          --user-font: inherit;
          <% end %>
        }
      </style>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= 'body--font-handwritten' if logged_in? && current_user&.font_family == 'handwritten' %><%= " #{yield :body_class}" if content_for?(:body_class) %>" id="app-body" data-controller="app-keyboard" data-purchased="<%= (current_user&.device_downloaded?) ? 'true' : 'false' %><%= ' data-marketing-page="true"' if controller_name == 'marketing' || controller_name == 'contact' %>" style="<%= "height: 100vh; overflow: hidden; height: 100dvh;" if logged_in? %><%= 'font-family: var(--user-font);' if logged_in? && current_user && font_stack_for(current_user) %>">
    <%# Hidden div for Turbo Stream form-reset target (todo create clears input without full reload) %>
    <div id="turbo-form-reset-target" hidden aria-hidden="true"></div>
    <!-- Skip to main content - first focusable for keyboard/screen reader users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Load theme immediately to prevent flash -->
    <script>
      (function() {
        function applyTheme(theme) {
          const body = document.getElementById('app-body');
          if (!body) return;
          
          // Remove all theme classes
          body.className = body.className.replace(/theme-\w+/g, '');
          
          // Add new theme class
          body.classList.add(`theme-${theme}`);
          
          // Update background class based on theme
          if (theme === 'lined') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-lined');
          } else if (theme === 'graph') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-graph');
          } else if (theme === 'vintage') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-vintage');
          } else if (theme === 'dark') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-dark');
          } else {
            // Classic theme
            body.classList.add('notebook-background');
            body.classList.remove('theme-lined', 'theme-graph', 'theme-vintage', 'theme-dark');
          }
          
          // Update theme-color meta tag so PWA status bar matches app background (native feel)
          var themeColorMeta = document.querySelector('meta[name="theme-color"]');
          if (themeColorMeta) {
            themeColorMeta.setAttribute('content', theme === 'dark' ? '#282a36' : '#ffffff');
          }
        }
        
        // Marketing pages: never apply app themes (dark/lined/etc) — always light for correct H1/colour visibility
        const isMarketing = document.body.getAttribute('data-marketing-page') === 'true';
        const savedTheme = isMarketing ? 'classic' : (localStorage.getItem('notebook-theme') || 'classic');
        applyTheme(savedTheme);
        
        // Store the function globally for later use
        window.applyThemeGlobal = applyTheme;
      })();
    </script>
  <!-- FAB Navigation (only for authenticated app pages) -->
  <% if controller_name != 'marketing' && logged_in? %>
    <%= render 'shared/fab_navigation' %>
  <% end %>



  <!-- Flash Messages Removed per User Request -->

    <main id="main-content">
      <%= yield %>
    </main>

    <!-- Sign Out Confirmation Modal -->
    <div data-logout-target="modal" class="logout-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="logoutModalLabel" aria-hidden="true" onclick="if(event.target === this) window.hideLogoutModal()">
      <div class="logout-modal__backdrop">
        <div class="logout-modal__dialog">
          <div class="logout-modal__content">
            <div class="logout-modal__header">
              <h2 class="logout-modal__title" id="logoutModalLabel">Confirm Sign Out</h2>
              <button type="button" class="logout-modal__close" onclick="window.hideLogoutModal()" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="logout-modal__body">
              <p>Are you sure you want to sign out?</p>
              <p class="logout-modal__subtext">You'll need to sign in again to access your todos.</p>
            </div>
            <div class="logout-modal__footer">
              <button type="button" class="logout-modal__btn logout-modal__btn--secondary" onclick="window.hideLogoutModal()">
                Cancel
              </button>
              <button type="button" class="logout-modal__btn logout-modal__btn--primary" onclick="window.confirmLogout()">
                Sign Out
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Warning / Confirmation Modal (reusable for delete actions) -->
    <div id="confirm-modal" class="confirm-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirmModalLabel" aria-hidden="true" onclick="if(event.target === this) window.hideConfirmModal()">
      <div class="confirm-modal__backdrop">
        <div class="confirm-modal__dialog">
          <div class="confirm-modal__content">
            <div class="confirm-modal__icon" aria-hidden="true">
              <!-- Warning triangle icon -->
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            </div>
            <h2 class="confirm-modal__title" id="confirmModalLabel">Are you sure?</h2>
            <p class="confirm-modal__message" id="confirmModalMessage">This action cannot be undone.</p>
            <div class="confirm-modal__footer">
              <button type="button" class="confirm-modal__btn confirm-modal__btn--no" onclick="window.hideConfirmModal()">
                No
              </button>
              <button type="button" class="confirm-modal__btn confirm-modal__btn--yes" id="confirmModalYes">
                Yes
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Theme Switching JavaScript -->
    <script>
      // Global logout modal function
      window.showLogoutModal = function() {
        const modal = document.querySelector('[data-logout-target="modal"]');
        if (modal) {
          window._logoutModalPreviousFocus = document.activeElement;
          modal.classList.add("show");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          const closeBtn = modal.querySelector('.logout-modal__close');
          if (closeBtn) closeBtn.focus();
          else modal.focus();
          window._logoutModalFocusTrap = function(e) {
            if (e.key !== 'Tab') return;
            var focusables = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
            focusables = [].slice.call(focusables).filter(function(el) { return el.offsetParent !== null; });
            var first = focusables[0], last = focusables[focusables.length - 1];
            if (e.shiftKey) {
              if (document.activeElement === first) { e.preventDefault(); last.focus(); }
            } else {
              if (document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
          };
          document.addEventListener('keydown', window._logoutModalFocusTrap);
        } else { console.error("Logout modal not found!"); }
      };

      window.hideLogoutModal = function() {
        const modal = document.querySelector('[data-logout-target="modal"]');
        if (modal) {
          modal.classList.remove("show");
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
          if (window._logoutModalFocusTrap) {
            document.removeEventListener('keydown', window._logoutModalFocusTrap);
            window._logoutModalFocusTrap = null;
          }
          if (window._logoutModalPreviousFocus && window._logoutModalPreviousFocus.focus) {
            window._logoutModalPreviousFocus.focus();
          }
        }
      };

      window.confirmLogout = function() {
        // Create a form and submit it to logout
        const form = document.createElement("form");
        form.method = "POST";
        form.action = "/logout";
        
        // Add CSRF token
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");
        const tokenInput = document.createElement("input");
        tokenInput.type = "hidden";
        tokenInput.name = "authenticity_token";
        tokenInput.value = csrfToken;
        
        // Add method override for DELETE
        const methodInput = document.createElement("input");
        methodInput.type = "hidden";
        methodInput.name = "_method";
        methodInput.value = "delete";
        
        form.appendChild(tokenInput);
        form.appendChild(methodInput);
        document.body.appendChild(form);
        form.submit();
      };

      // Global confirm modal functions
      window.showConfirmModal = function(options) {
        // options: { message, onConfirm }
        var modal = document.getElementById('confirm-modal');
        if (!modal) return;

        // Set custom message if provided
        var msgEl = document.getElementById('confirmModalMessage');
        if (msgEl && options && options.message) {
          msgEl.textContent = options.message;
        }

        // Wire up the "Yes" button to run the confirm callback
        var yesBtn = document.getElementById('confirmModalYes');
        var newYes = yesBtn.cloneNode(true);
        yesBtn.parentNode.replaceChild(newYes, yesBtn);
        newYes.addEventListener('click', function() {
          window.hideConfirmModal();
          if (options && typeof options.onConfirm === 'function') {
            options.onConfirm();
          }
        });

        // Show modal
        window._confirmModalPreviousFocus = document.activeElement;
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        newYes.focus();
      };

      window.hideConfirmModal = function() {
        var modal = document.getElementById('confirm-modal');
        if (!modal) return;
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (window._confirmModalPreviousFocus && window._confirmModalPreviousFocus.focus) {
          window._confirmModalPreviousFocus.focus();
        }
      };

      // Theme management functions
function applyTheme(theme) {
          const body = document.getElementById('app-body');
          if (!body) return;
          
          // Remove all theme classes
          body.className = body.className.replace(/theme-\w+/g, '');
          
          // Add new theme class
          body.classList.add(`theme-${theme}`);
          
          // Update background class based on theme
          if (theme === 'lined') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-lined');
          } else if (theme === 'graph') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-graph');
          } else if (theme === 'vintage') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-vintage');
          } else if (theme === 'dark') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-dark');
          } else {
            // Classic theme
            body.classList.add('notebook-background');
            body.classList.remove('theme-lined', 'theme-graph', 'theme-vintage', 'theme-dark');
          }
          
          // Update theme-color meta tag so status bar matches app background (native PWA feel)
          const themeColorMeta = document.querySelector('meta[name="theme-color"]');
          if (themeColorMeta) {
            themeColorMeta.setAttribute('content', theme === 'dark' ? '#282a36' : '#ffffff');
          }
        }
      
      function updateActiveButton(theme) {
        const buttons = document.querySelectorAll('[data-theme]');
        buttons.forEach(btn => btn.classList.remove('active'));
        const activeButton = document.querySelector(`[data-theme="${theme}"]`);
        if (activeButton) {
          activeButton.classList.add('active');
        }
      }
      
      function setupThemeSelector() {
        const themeButtons = document.querySelectorAll('[data-theme]');
        
        // Marketing pages: never apply app themes (preserves H1/colour visibility)
        const isMarketing = document.body.getAttribute('data-marketing-page') === 'true';
        const savedTheme = isMarketing ? 'classic' : (localStorage.getItem('notebook-theme') || 'classic');
        applyTheme(savedTheme);
        
        // Only set up theme selector if theme buttons exist (projects index page only)
        if (themeButtons.length > 0) {
          // Update active button on page load
          updateActiveButton(savedTheme);
          
          // Remove existing event listeners to prevent duplicates
          themeButtons.forEach(button => {
            // Clone the button to remove all event listeners
            const newButton = button.cloneNode(true);
            button.parentNode.replaceChild(newButton, button);
          });
          
          // Add click listeners to theme buttons
          document.querySelectorAll('[data-theme]').forEach(button => {
            button.addEventListener('click', function() {
              const theme = this.dataset.theme;
              applyTheme(theme);
              localStorage.setItem('notebook-theme', theme);
              updateActiveButton(theme);
            });
          });
        }
        
        // Mobile theme toggle functionality
        const mobileToggle = document.getElementById('theme-toggle-mobile');
        const mobileDropdown = document.getElementById('theme-dropdown-mobile');
        
        if (mobileToggle && mobileDropdown) {
          // Remove existing event listeners
          const newMobileToggle = mobileToggle.cloneNode(true);
          mobileToggle.parentNode.replaceChild(newMobileToggle, mobileToggle);
          
          // Add new event listeners
          document.getElementById('theme-toggle-mobile').addEventListener('click', function() {
            mobileDropdown.classList.toggle('hidden');
          });
          
          // Close dropdown when clicking outside
          document.addEventListener('click', function(e) {
            const currentToggle = document.getElementById('theme-toggle-mobile');
            const currentDropdown = document.getElementById('theme-dropdown-mobile');
            if (currentToggle && currentDropdown && 
                !currentToggle.contains(e.target) && !currentDropdown.contains(e.target)) {
              currentDropdown.classList.add('hidden');
            }
          });
        }
      }
      
      function setupFlashMessages() {
        // Flash messages removed
      }
      
      // Hide Buy CTA when running as installed PWA (standalone) — user has already "downloaded"
      // Hide Account tab when PWA + purchased (user has bought and is using installed app)
      function hideBuyIfStandalone() {
        var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (isStandalone) {
          document.querySelectorAll('[data-standalone-hide="buy"]').forEach(function(el) { el.style.display = 'none'; });
        }
        // Account tab: hide when standalone AND user has purchased (device_downloaded)
        if (isStandalone && document.body.dataset.purchased === 'true') {
          document.querySelectorAll('[data-standalone-hide="account-tab"]').forEach(function(el) { el.style.display = 'none'; });
        }
      }

      // Initialize on DOM ready
      document.addEventListener('DOMContentLoaded', function() {
        setupThemeSelector();
        setupFlashMessages();
        hideBuyIfStandalone();
      });
      
      // Re-initialize after Turbo navigation
      document.addEventListener('turbo:load', function() {
        setupThemeSelector();
        setupFlashMessages();
        hideBuyIfStandalone();
      });
      
      // Store the function globally for immediate use
      window.applyThemeGlobal = applyTheme;
    </script>

    <%# PWA Service Worker: only for paid users (trial users cannot install) %>
    <% if logged_in? && current_user&.can_install_pwa? %>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/service-worker.js')
            .then(function(registration) {
              console.log('ServiceWorker registration successful');
            })
            .catch(function(err) {
              console.log('ServiceWorker registration failed: ', err);
            });
        });
      }
    </script>
    <% end %>
  </body>
</html>
