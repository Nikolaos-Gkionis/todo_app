<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Todo-it" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <!-- Favicon and App Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon-large.svg">
    <meta name="theme-color" content="#4a5568">
    
    <!-- App Meta Tags -->
    <meta name="description" content="Todo-it - Beautiful notebook-style todo app with hand-drawn aesthetics">
    <meta name="author" content="Todo-it App">
    <meta property="og:title" content="Todo-it - Beautiful Todo App">
    <meta property="og:description" content="Organize your tasks in a beautiful notebook-style interface">
    <meta property="og:type" content="website">

    <%# Custom BEM-based CSS system - no Tailwind needed! %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="notebook-background handwritten" id="app-body">
    <!-- Load theme immediately to prevent flash -->
    <script>
      (function() {
        function applyTheme(theme) {
          const body = document.getElementById('app-body');
          if (!body) return;
          
          // Remove all theme classes
          body.className = body.className.replace(/theme-\w+/g, '');
          
          // Add new theme class
          body.classList.add(`theme-${theme}`);
          
          // Update background class based on theme
          if (theme === 'lined') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-lined');
          } else if (theme === 'graph') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-graph');
          } else if (theme === 'vintage') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-vintage');
          } else if (theme === 'dark') {
            body.classList.remove('notebook-background');
            body.classList.add('theme-dark');
          } else {
            // Classic theme
            body.classList.add('notebook-background');
            body.classList.remove('theme-lined', 'theme-graph', 'theme-vintage', 'theme-dark');
          }
        }
        
        const savedTheme = localStorage.getItem('notebook-theme') || 'classic';
        applyTheme(savedTheme);
        
        // Store the function globally for later use
        window.applyThemeGlobal = applyTheme;
      })();
    </script>
  <!-- FAB Navigation (only for authenticated app pages) -->
  <% if controller_name != 'marketing' && logged_in? %>
    <%= render 'shared/fab_navigation' %>
  <% end %>


  <!-- Theme Selector - Only show on pages index page -->
  <% if controller_name == 'pages' && action_name == 'index' %>
    <div class="theme-selector">
      <!-- Mobile Icon Toggle -->
      <div class="theme-toggle--mobile md:hidden">
        <button class="theme-toggle__btn" id="theme-toggle-mobile" title="Themes">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"/>
          </svg>
        </button>
      </div>
      
      <!-- Desktop Theme Selector -->
      <div class="theme-selector-desktop hidden md:block">
        <div class="text-xs text-gray-600 mb-2 text-center font-medium">
          Themes
        </div>
        <div class="flex flex-wrap justify-center">
          <button class="theme-btn--classic active" data-theme="classic" title="Classic Dotted"></button>
          <button class="theme-btn--lined" data-theme="lined" title="Lined Paper"></button>
          <button class="theme-btn--graph" data-theme="graph" title="Graph Paper"></button>
          <button class="theme-btn--vintage" data-theme="vintage" title="Vintage Paper"></button>
          <button class="theme-btn--dark" data-theme="dark" title="Dark Mode"></button>
        </div>
      </div>
      
      <!-- Mobile Theme Dropdown -->
      <div class="theme-selector--mobile hidden md:hidden" id="theme-dropdown-mobile">
        <div class="text-xs text-gray-600 mb-2 text-center font-medium">
          Themes
        </div>
        <div class="grid grid--cols-2 grid--gap-4">
          <button class="theme-btn--classic active flex items-center justify-center p-2" data-theme="classic" title="Classic Dotted">
            <span class="text-xs">Classic</span>
          </button>
          <button class="theme-btn--lined flex items-center justify-center p-2" data-theme="lined" title="Lined Paper">
            <span class="text-xs">Lined</span>
          </button>
          <button class="theme-btn--graph flex items-center justify-center p-2" data-theme="graph" title="Graph Paper">
            <span class="text-xs">Graph</span>
          </button>
          <button class="theme-btn--vintage flex items-center justify-center p-2" data-theme="vintage" title="Vintage Paper">
            <span class="text-xs">Vintage</span>
          </button>
          <button class="theme-btn--dark flex items-center justify-center p-2" data-theme="dark" title="Dark Mode">
            <span class="text-xs">Dark</span>
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Flash Messages -->
  <% if notice %>
    <div class="flash-message flash-message--success" data-auto-dismiss="true">
      ✅ <%= notice %>
    </div>
  <% end %>
  
  <% if alert %>
    <div class="flash-message flash-message--error" data-auto-dismiss="true">
      ⚠️ <%= alert %>
    </div>
  <% end %>

  <% if flash[:trial] %>
    <div class="flash-message flash-message--trial" data-auto-dismiss="true">
      <%= flash[:trial] %>
    </div>
  <% end %>

    <%= yield %>

    <!-- Logout Confirmation Modal -->
    <div data-logout-target="modal" class="logout-modal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true" onclick="if(event.target === this) window.hideLogoutModal()">
      <div class="logout-modal__backdrop">
        <div class="logout-modal__dialog">
          <div class="logout-modal__content">
            <div class="logout-modal__header">
              <h5 class="logout-modal__title" id="logoutModalLabel">Confirm Logout</h5>
              <button type="button" class="logout-modal__close" onclick="window.hideLogoutModal()" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="logout-modal__body">
              <p>Are you sure you want to logout?</p>
              <p class="logout-modal__subtext">You'll need to sign in again to access your todos.</p>
            </div>
            <div class="logout-modal__footer">
              <button type="button" class="logout-modal__btn logout-modal__btn--secondary" onclick="window.hideLogoutModal()">
                Cancel
              </button>
              <button type="button" class="logout-modal__btn logout-modal__btn--primary" onclick="window.confirmLogout()">
                Logout
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Theme Switching JavaScript -->
    <script>
      // Global logout modal function
      window.showLogoutModal = function() {
        const modal = document.querySelector('[data-logout-target="modal"]');
        if (modal) {
          modal.classList.add("show");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          modal.focus();
        } else {
          console.error("Logout modal not found!");
        }
      };

      window.hideLogoutModal = function() {
        const modal = document.querySelector('[data-logout-target="modal"]');
        if (modal) {
          modal.classList.remove("show");
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      };

      window.confirmLogout = function() {
        // Create a form and submit it to logout
        const form = document.createElement("form");
        form.method = "POST";
        form.action = "/logout";
        
        // Add CSRF token
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");
        const tokenInput = document.createElement("input");
        tokenInput.type = "hidden";
        tokenInput.name = "authenticity_token";
        tokenInput.value = csrfToken;
        
        // Add method override for DELETE
        const methodInput = document.createElement("input");
        methodInput.type = "hidden";
        methodInput.name = "_method";
        methodInput.value = "delete";
        
        form.appendChild(tokenInput);
        form.appendChild(methodInput);
        document.body.appendChild(form);
        form.submit();
      };

      // Theme management functions
      function applyTheme(theme) {
        const body = document.getElementById('app-body');
        if (!body) return;
        
        // Remove all theme classes
        body.className = body.className.replace(/theme-\w+/g, '');
        
        // Add new theme class
        body.classList.add(`theme-${theme}`);
        
        // Update background class based on theme
        if (theme === 'lined') {
          body.classList.remove('notebook-background');
          body.classList.add('theme-lined');
        } else if (theme === 'graph') {
          body.classList.remove('notebook-background');
          body.classList.add('theme-graph');
        } else if (theme === 'vintage') {
          body.classList.remove('notebook-background');
          body.classList.add('theme-vintage');
        } else if (theme === 'dark') {
          body.classList.remove('notebook-background');
          body.classList.add('theme-dark');
        } else {
          // Classic theme
          body.classList.add('notebook-background');
          body.classList.remove('theme-lined', 'theme-graph', 'theme-vintage', 'theme-dark');
        }
      }
      
      function updateActiveButton(theme) {
        const buttons = document.querySelectorAll('[data-theme]');
        buttons.forEach(btn => btn.classList.remove('active'));
        const activeButton = document.querySelector(`[data-theme="${theme}"]`);
        if (activeButton) {
          activeButton.classList.add('active');
        }
      }
      
      function setupThemeSelector() {
        const themeButtons = document.querySelectorAll('[data-theme]');
        
        // Load saved theme from localStorage and apply it
        const savedTheme = localStorage.getItem('notebook-theme') || 'classic';
        applyTheme(savedTheme);
        
        // Only set up theme selector if theme buttons exist (projects index page only)
        if (themeButtons.length > 0) {
          // Update active button on page load
          updateActiveButton(savedTheme);
          
          // Remove existing event listeners to prevent duplicates
          themeButtons.forEach(button => {
            // Clone the button to remove all event listeners
            const newButton = button.cloneNode(true);
            button.parentNode.replaceChild(newButton, button);
          });
          
          // Add click listeners to theme buttons
          document.querySelectorAll('[data-theme]').forEach(button => {
            button.addEventListener('click', function() {
              const theme = this.dataset.theme;
              applyTheme(theme);
              localStorage.setItem('notebook-theme', theme);
              updateActiveButton(theme);
            });
          });
        }
        
        // Mobile theme toggle functionality
        const mobileToggle = document.getElementById('theme-toggle-mobile');
        const mobileDropdown = document.getElementById('theme-dropdown-mobile');
        
        if (mobileToggle && mobileDropdown) {
          // Remove existing event listeners
          const newMobileToggle = mobileToggle.cloneNode(true);
          mobileToggle.parentNode.replaceChild(newMobileToggle, mobileToggle);
          
          // Add new event listeners
          document.getElementById('theme-toggle-mobile').addEventListener('click', function() {
            mobileDropdown.classList.toggle('hidden');
          });
          
          // Close dropdown when clicking outside
          document.addEventListener('click', function(e) {
            const currentToggle = document.getElementById('theme-toggle-mobile');
            const currentDropdown = document.getElementById('theme-dropdown-mobile');
            if (currentToggle && currentDropdown && 
                !currentToggle.contains(e.target) && !currentDropdown.contains(e.target)) {
              currentDropdown.classList.add('hidden');
            }
          });
        }
      }
      
      function setupFlashMessages() {
        const flashMessages = document.querySelectorAll('.flash-message[data-auto-dismiss="true"]:not([data-timeout-set])');
        flashMessages.forEach(function(message) {
          message.setAttribute('data-timeout-set', 'true'); // Prevent multiple timeouts
          setTimeout(function() {
            if (message && message.parentNode) {
              message.style.opacity = '0';
              setTimeout(function() {
                if (message && message.parentNode) {
                  message.parentNode.removeChild(message);
                }
              }, 500); // Wait for fade animation to complete
            }
          }, 3000); // Show for 3 seconds
        });
      }
      
      // Initialize on DOM ready
      document.addEventListener('DOMContentLoaded', function() {
        setupThemeSelector();
        setupFlashMessages();
      });
      
      // Re-initialize after Turbo navigation
      document.addEventListener('turbo:load', function() {
        setupThemeSelector();
        setupFlashMessages();
      });
      
      // Store the function globally for immediate use
      window.applyThemeGlobal = applyTheme;
    </script>
  </body>
</html>
