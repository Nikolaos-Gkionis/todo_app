<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="mkt-hero">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.5rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      Simple, honest pricing
    </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
      Try free. Own forever.
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto 0;">
      Start with a 7-day free trial on our servers - no credit card, no commitment.
      Pay once to download the full app to your device and keep it forever.
    </p>
  </div>
</section>

<!-- Pricing Cards -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-pricing-grid">

      <!-- Free Trial -->
      <div class="mkt-pricing-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <div style="margin-bottom: 2rem;">
          <div class="mkt-pricing-card__label">Free Trial</div>
          <div class="mkt-pricing-price">£0</div>
          <div class="mkt-pricing-period">7 days on our servers</div>
        </div>

        <ul class="mkt-feature-list">
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>7-day full access trial</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>All features included</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>All 5 themes, 160 combinations</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Unlimited pages &amp; tasks</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>No credit card required</span>
          </li>
          <li>
            <span class="mkt-feature-cross">-</span>
            <span class="mkt-feature-text--muted">Data expires after 7 days</span>
          </li>
          <li>
            <span class="mkt-feature-cross">-</span>
            <span class="mkt-feature-text--muted">Hosted on our servers</span>
          </li>
        </ul>

        <%= link_to signup_path, class: "mkt-btn mkt-btn--outline", style: "width: 100%; justify-content: center;" do %>
          Start free trial
        <% end %>
      </div>

      <!-- Download Forever -->
      <div class="mkt-pricing-card mkt-pricing-card--featured mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 120ms">
        <div class="mkt-pricing-badge">Most popular</div>

        <div style="margin-bottom: 2rem;">
          <div class="mkt-pricing-card__label mkt-pricing-card__label--blue">Download to Device</div>
          <div class="mkt-pricing-price mkt-pricing-price--blue">£9.99</div>
          <div class="mkt-pricing-period">One-time payment - own it forever</div>
        </div>

        <ul class="mkt-feature-list">
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span><strong>Download to your device as a PWA</strong></span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Works on phone, tablet &amp; desktop</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Stays logged in like YouTube or Spotify</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Works completely offline</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>All 5 themes, 4 fonts, 8 accents — 160 combinations included</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Install on up to 3 devices</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Your data lives on your device</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span>Personal email support</span>
          </li>
          <li>
            <span class="mkt-feature-check">&#10003;</span>
            <span><strong>No monthly fees. Ever.</strong></span>
          </li>
        </ul>

        <% if logged_in? %>
          <% if current_user.device_downloaded? %>
            <%= link_to "Download App",
                  download_path,
                  class: "mkt-btn mkt-btn--primary",
                  style: "width: 100%; justify-content: center; display: inline-flex;" %>
          <% else %>
            <%= button_to "Download to Device",
                  create_checkout_session_path,
                  method: :post,
                  data: { turbo: false },
                  class: "mkt-btn mkt-btn--primary",
                  style: "width: 100%; justify-content: center; border: none;" %>
          <% end %>
        <% else %>
          <%= link_to signup_path, class: "mkt-btn mkt-btn--primary", style: "width: 100%; justify-content: center;" do %>
            Start free trial &rarr;
          <% end %>
        <% end %>
      </div>

    </div>

    <!-- Why this model -->
    <div class="mkt-reveal" data-scroll-reveal-target="item" style="text-align: center; margin-top: 3.5rem; max-width: 42rem; margin-left: auto; margin-right: auto;">
      <p style="color: #4E5C64; font-size: 1rem; line-height: 1.75; margin-bottom: 0.75rem;">
        <strong>Why this model?</strong> We believe software should feel like owning a planner, not renting one.
        Try it free, fall in love, then pay once and keep it forever.
      </p>
      <p style="font-size: 0.875rem; color: #4E5C64;">
        7-day free trial &nbsp;&middot;&nbsp; 7-day money-back guarantee &nbsp;&middot;&nbsp; Secure payment via Polar
      </p>
    </div>

    <!-- Trust signals -->
    <div class="mkt-grid-3" style="margin-top: 3.5rem; max-width: 56rem; margin-left: auto; margin-right: auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; text-align: center; padding: 1.5rem; background: #F2F5EF; border-radius: 0.875rem;">
        <div class="mkt-trust-icon bg-green-100 text-green-600" style="margin: 0 auto 0.875rem;">
          <%= inline_icon "lock-closed" %>
        </div>
        <div style="font-weight: 600; color: #4E5C64; margin-bottom: 0.375rem; font-size: 0.925rem;">Privacy First</div>
        <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">No tracking, no ads, no data mining</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms; text-align: center; padding: 1.5rem; background: #F0EDEA; border-radius: 0.875rem;">
        <div class="mkt-trust-icon bg-blue-100 text-blue-600" style="margin: 0 auto 0.875rem;">
          <%= inline_icon "circle-stack" %>
        </div>
        <div style="font-weight: 600; color: #4E5C64; margin-bottom: 0.375rem; font-size: 0.925rem;">Data Ownership</div>
        <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Your data lives on your device, not ours</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 160ms; text-align: center; padding: 1.5rem; background: #FBF2F3; border-radius: 0.875rem;">
        <div class="mkt-trust-icon bg-purple-100 text-purple-600" style="margin: 0 auto 0.875rem;">
          <%= inline_icon "device-phone-mobile" %>
        </div>
        <div style="font-weight: 600; color: #4E5C64; margin-bottom: 0.375rem; font-size: 0.925rem;">Works Offline</div>
        <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">No internet required after downloading</p>
      </div>
    </div>

  </div>
</section>

<!-- FAQ (Accordion) -->
<section class="mkt-section mkt-section--cream mkt-reveal" data-scroll-reveal-target="item">
  <div class="mkt-inner">
    <div class="mkt-section-intro">
      <span class="mkt-label">FAQ</span>
      <h2 class="mkt-heading">Common questions</h2>
    </div>

    <div class="mkt-faq-list" data-controller="faq">

      <div class="mkt-faq-item is-open" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>What happens after my 7-day trial?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            After 7 days, your trial data expires and your account access ends. You can purchase the £9.99 download
            at any point during - or shortly after - your trial to keep your data forever on your own device.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>Can I download to my device during the trial?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            Yes! You can purchase and download the app at any point during your 7-day trial.
            Your trial data is transferred to your device when you download, so nothing is lost.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>Do you offer refunds?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            Yes - we offer a 7-day money-back guarantee. If Task Days isn't right for you,
            <%= link_to "contact us", contact_path %> within 7 days for a full refund, no questions asked.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>How does downloading to my device actually work?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            After payment you'll receive a download link. Task Days is a Progressive Web App (PWA) — you open it in your browser
            and install it to your home screen or applications folder, just like a native app.
            No app store. No gatekeepers. It stays logged in and works offline from that point.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>Can I use it on multiple devices?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            Yes - your purchase allows you to install on up to 3 devices you own (phone, tablet, laptop, desktop).
            Each device gets its own independent copy, like having 3 separate planners.
            Data stays local to each device with no sync between them.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>How is my data protected?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            During your trial, data is encrypted on our servers. After download, your data lives entirely on your device -
            encrypted and completely private. We never sell or share your information, and we collect zero analytics.
          </p>
        </div>
      </div>

      <div class="mkt-faq-item" data-faq-target="item">
        <div class="mkt-faq-q mkt-faq-q--toggle" data-action="click->faq#toggle">
          <span>Is there a free tier after the trial?</span>
          <svg class="mkt-faq-chevron" data-faq-chevron viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        </div>
        <div data-faq-answer>
          <p class="mkt-faq-a">
            The 7-day trial is completely free with no credit card required. After that, it's a one-time £9.99 payment
            to download to your device. No free tier with limitations - just try it free, then own it forever.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="mkt-cta mkt-reveal" data-scroll-reveal-target="item">
  <div class="mkt-inner">
    <h2 class="mkt-cta__title">Start organising your days</h2>
    <p class="mkt-cta__subtitle">
      Try free for 7 days on our servers. No credit card. Download forever for £9.99 when you're ready.
    </p>
    <%= link_to signup_path, class: "mkt-btn mkt-btn--white" do %>
      Start free trial
    <% end %>
    <p class="mkt-cta__trust">No credit card required &nbsp;&middot;&nbsp; 7-day money-back guarantee</p>
  </div>
</section>

<%= render 'shared/footer' %>
</div>
