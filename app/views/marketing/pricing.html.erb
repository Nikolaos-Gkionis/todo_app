<!-- Navigation -->
<%= render 'shared/navbar' %>

<!-- Pricing Hero -->
<section class="py-20 bg-gradient-to-br from-blue-50 to-indigo-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl font-bold text-gray-900 mb-6">Simple, Honest Pricing</h1>
    <p class="text-xl text-gray-600 mb-8">
      Try free for 30 days on our servers, then pay once to download to your device forever.
    </p>
  </div>
</section>

<!-- Pricing Cards -->
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-4xl mx-auto">
      
      <!-- Free Plan -->
      <div class="bg-white border-2 border-gray-200 rounded-2xl p-8 relative">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Free Trial</h3>
          <div class="text-4xl font-bold text-gray-900 mb-2">$0</div>
          <p class="text-gray-600">30 days on our servers</p>
        </div>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">30-day free trial</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">Hosted on our servers</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">All features included</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">All 5 beautiful themes included</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">No credit card required</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-unchecked mr-3 scale-75"></div>
            <span class="text-gray-400">Data expires after 30 days</span>
          </li>
        </ul>
        
        <%= link_to signup_path, class: "w-full bg-gray-100 hover:bg-gray-200 text-gray-700 py-3 px-6 rounded-lg font-semibold transition-colors text-center block" do %>
          Start Free Trial
        <% end %>
      </div>
      
      <!-- Premium Plan -->
      <div class="bg-white border-2 border-blue-500 rounded-2xl p-8 relative shadow-lg">
        <!-- Popular Badge -->
        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
          <span class="bg-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold">
            ⭐ Most Popular
          </span>
        </div>
        
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Download to Device</h3>
          <div class="text-4xl font-bold text-blue-600 mb-2">$9.99</div>
          <p class="text-gray-600">One-time payment, download forever</p>
        </div>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700 font-medium">Download to your device:</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">✨ Works completely offline</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">🎨 All 5 beautiful themes included</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">📱 Install on any device</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">🔄 Your data stays on your device</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">📧 Priority email support</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span class="text-gray-700">🚀 No monthly fees ever</span>
          </li>
        </ul>
        
        <% if logged_in? %>
          <%= button_to "Download to Device",
                create_checkout_session_path,
                method: :post,
                data: { turbo: false },
                class: "w-full bg-blue-600 hover:bg-blue-700 text-white py-3 px-6 rounded-lg font-semibold transition-colors text-center cursor-pointer border-0" %>
        <% else %>
          <%= link_to signup_path, class: "w-full bg-blue-600 hover:bg-blue-700 text-white py-3 px-6 rounded-lg font-semibold transition-colors text-center block" do %>
            Start Free Trial
          <% end %>
        <% end %>
      </div>
    </div>
    
    <!-- Value Proposition -->
    <div class="text-center mt-16">
      <p class="text-gray-600 mb-4">
        💡 <strong>Why this model?</strong> Try free for 30 days on our servers, then download to your device forever. 
        No monthly surprises, no ongoing fees, your data stays with you.
      </p>
      <p class="text-sm text-gray-500">
        30-day free trial • 30-day money-back guarantee • Secure payment via Stripe
      </p>
    </div>
    
    <!-- Trust Signals -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="text-center p-4 bg-green-50 rounded-lg">
        <div class="text-green-600 text-2xl mb-2">🔒</div>
        <h3 class="font-semibold text-gray-900 mb-1">Privacy First</h3>
        <p class="text-sm text-gray-600">No tracking, no ads, no data mining</p>
      </div>
      <div class="text-center p-4 bg-blue-50 rounded-lg">
        <div class="text-blue-600 text-2xl mb-2">💾</div>
        <h3 class="font-semibold text-gray-900 mb-1">Data Ownership</h3>
        <p class="text-sm text-gray-600">Your data lives on your device</p>
      </div>
      <div class="text-center p-4 bg-purple-50 rounded-lg">
        <div class="text-purple-600 text-2xl mb-2">📱</div>
        <h3 class="font-semibold text-gray-900 mb-1">Works Offline</h3>
        <p class="text-sm text-gray-600">No internet required after download</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Frequently Asked Questions</h2>
    
    <div class="space-y-8">
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">What happens after my 30-day trial?</h3>
        <p class="text-gray-600">
          After 30 days, your trial data expires and you'll need to download the app to your device to continue. 
          Pay once to download and keep your data forever on your own device.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Can I download to my device anytime?</h3>
        <p class="text-gray-600">
          Yes! During your 30-day trial, you can download the app to your device anytime. 
          Your trial data will be transferred to your device when you download.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Do you offer refunds?</h3>
        <p class="text-gray-600">
          Yes! We offer a 30-day money-back guarantee. If Todo-it isn't right for you, 
          contact us within 30 days for a full refund, no questions asked.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">How do I download to my device?</h3>
        <p class="text-gray-600">
          After payment, you'll get a download link for your device. The app works as a PWA (Progressive Web App) 
          that you can install on any device - phone, tablet, or computer.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">How is my data protected?</h3>
        <p class="text-gray-600">
          During the trial, your data is encrypted on our servers. After download, your data lives entirely on your device, 
          encrypted and private. We never sell your information.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">What if I don't like it?</h3>
        <p class="text-gray-600">
          We offer a 30-day money-back guarantee. If Todo-it isn't right for you, contact us within 30 days 
          for a full refund, no questions asked. We want you to be completely satisfied.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Can I use it on multiple devices?</h3>
        <p class="text-gray-600">
          Yes! Once you download the app, you can install it on any device you own - phone, tablet, laptop, desktop. 
          Your data syncs between devices when you're online.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Is there a free version?</h3>
        <p class="text-gray-600">
          The 30-day trial is completely free with no credit card required. After that, it's a one-time payment 
          to download to your device. No free tier with limitations - just try it free, then own it forever.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="py-20 bg-blue-600">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl font-bold text-white mb-4">Start Your Beautiful Todo Journey</h2>
    <p class="text-xl text-blue-100 mb-8">
      Try Todo-it free for 30 days on our servers, then download to your device forever.
    </p>
    
    <%= link_to signup_path, class: "bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-colors inline-block" do %>
      🚀 Start Free Trial
    <% end %>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-2">
        <div class="flex items-center mb-4">
          <div class="logo-checkbox mr-3" style="filter: brightness(0) invert(1);"></div>
          <span class="text-2xl font-bold">Todo-it</span>
        </div>
        <p class="text-gray-400 mb-4">
          Beautiful notebook-style todo pages that make productivity feel personal and delightful.
        </p>
        <p class="text-gray-500 text-sm">
          © 2025 Todo-it. Made with ❤️ for productivity enthusiasts.
        </p>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Product</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Home", root_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Why Todo-it", why_path, class: "hover:text-white transition-colors" %></li>
          <li><span class="text-white">Pricing</span></li>
          <li><%= link_to "How to Use", how_to_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Account</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Sign In", login_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Create Account", signup_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
    </div>
  </div>
</footer>