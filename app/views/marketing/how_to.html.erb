<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="mkt-hero">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.5rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      Getting started in minutes
    </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
      How to use Peponi.to
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto;">
      Beautiful productivity, mastered in three steps. No tutorials, no onboarding flows -
      just open it and start writing.
    </p>
  </div>
</section>

<!-- Getting Started -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Getting started</span>
      <h2 class="mkt-heading">Three steps to beautiful productivity</h2>
    </div>

    <div class="mkt-steps">

      <!-- Step 1 -->
      <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">1</div>
          <h3 class="mkt-step__title">Create your first Page</h3>
          <p class="mkt-step__text">
            Start with a blank slate, no clutter, no templates. Think of Days like sections in a notebook:
            "Today", "Tomorrow", "Next 4 days". Your lists begin empty and grow naturally.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Click "Add task.." at the middle of each day.</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Start writing - that&rsquo;s it</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/empty.png", alt: "Empty page ready for your first tasks", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">2</div>
          <h3 class="mkt-step__title">Add tasks and hover for options</h3>
          <p class="mkt-step__text">
            Tap a task to highlight it and see its full form, bold, colour, notes, and recurrence. Add rich notes for complex tasks.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Tap a task to mark as completed or hover for options</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Add notes, set dates, or tweak settings</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Tap the task again to mark as completed when done</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/highlight.png", alt: "Highlighted task with full details visible", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">3</div>
          <h3 class="mkt-step__title">Rename, reorder &amp; arrange</h3>
          <p class="mkt-step__text">
            Edit any task by tapping to rename or refine the title. Drag and drop to reorder — just like moving sticky notes.
            Your order and changes are saved instantly.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Tap a task to rename or edit</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Grab the ⋮⋮ handle to drag and reorder</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Your list always reflects your priorities</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/rename.png", alt: "Rename and reorder tasks", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- View options -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">View options</span>
      <h2 class="mkt-heading">Choose your horizon</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Focus on today, or spread across the week. Tap the FAB to switch between Focus (1 day), 2, 4, or 7-day views.
      </p>
    </div>

    <div class="mkt-reveal" data-scroll-reveal-target="item" style="max-width: 40rem; margin: 0 auto;">
      <%= image_tag "new-images/preferences.png", alt: "View days: Focus, 2, 4, or 7 days", class: "w-full rounded-xl shadow-md border border-gray-200" %>
    </div>
  </div>
</section>

<!-- Themes showcase -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Themes</span>
      <h2 class="mkt-heading">A style for every mood</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Classic, Lined, Graph, Vintage, Dark Mode. Five themes, four fonts, eight accent colours — 160 combinations.
      </p>
    </div>

    <div class="mkt-grid-3">
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <%= image_tag "new-images/lined.png", alt: "Lined Paper theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Lined Paper</div>
          <div class="mkt-theme-desc">Clean lines for structured thinking</div>
        </div>
      </div>
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 100ms">
        <%= image_tag "new-images/graph.png", alt: "Graph theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Graph</div>
          <div class="mkt-theme-desc">Grid layout for clarity</div>
        </div>
      </div>
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 200ms">
        <%= image_tag "new-images/vintage.png", alt: "Vintage theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Vintage</div>
          <div class="mkt-theme-desc">Warm, nostalgic feel</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Date picker & scheduling -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Schedule</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Set dates for any task</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          Tap the date field to open the picker. Schedule tasks for today, tomorrow, or any day. Move tasks between days by dragging — your plan stays flexible.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/date-picker.png", alt: "Date picker for scheduling tasks", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Recurring tasks -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Recurrence</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Repeat tasks automatically</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          Set a task to repeat daily, weekly, or on custom days. Perfect for habits, stand-ups, or anything that happens again and again.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/recurrence-1.png", alt: "Recurring task options", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Notes & details -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Notes</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Add details when you need them</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          Expand any task to add notes, sub-steps, or context. Keep the main list minimal — details appear when you tap.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/notes-full.png", alt: "Task with notes expanded", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Defer: Not yet & At some point -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Defer</span>
      <h2 class="mkt-heading">Park it for later</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Not ready? Mark tasks "Not yet" or "At some point" — they stay on your list without cluttering today.
      </p>
    </div>

    <div class="mkt-grid-2" style="max-width: 50rem; margin: 0 auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <%= image_tag "new-images/notyet.png", alt: "Not yet — defer a task", class: "w-full rounded-xl shadow-md border border-gray-200" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem; text-align: center;">Not yet</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms">
        <%= image_tag "new-images/atssomepoint.png", alt: "At some point — defer to later", class: "w-full rounded-xl shadow-md border border-gray-200" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem; text-align: center;">At some point</p>
      </div>
    </div>
  </div>
</section>

<!-- Fonts -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Typography</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Pick your font</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          System UI, Monospace, Serif, or Handwritten. Change it in the FAB preferences — your list adapts to your taste.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/monospace.png", alt: "Monospace font option", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Account & download -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Account</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Download when you&rsquo;re ready</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          After your trial, your account page is where you download the app forever. One-time payment — no subscription, no lock-in.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/account.png", alt: "Account page and download", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Mobile experience -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Mobile</span>
      <h2 class="mkt-heading">Works beautifully on your phone</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Full week view, tap to add, calendar at your fingertips. Install as a PWA for a native app feel — no app store needed.
      </p>
    </div>

    <div class="mkt-grid-3" style="align-items: end; max-width: 56rem; margin: 0 auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; text-align: center;">
        <%= image_tag "new-images/pixel7.png", alt: "Peponi.to on Pixel 7", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">App on phone</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms; text-align: center;">
        <%= image_tag "new-images/mob-calendar.png", alt: "Mobile calendar view", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">Calendar on mobile</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 160ms; text-align: center;">
        <%= image_tag "new-images/mob-tap.png", alt: "Tap to add task on mobile", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">Tap to add</p>
      </div>
    </div>
  </div>
</section>

<!-- PWA Installation -->
<section class="mkt-section bg-white" id="install-pwa">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Install as a PWA</span>
      <h2 class="mkt-heading">Your app, on your device</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        After downloading, install Peponi.to as a Progressive Web App for a native experience —
        no app store, no browser chrome, instant launch.
      </p>
    </div>

    <div class="mkt-grid-2--wide-gap" style="max-width: 60rem; margin: 0 auto;">

      <!-- Mobile -->
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; background: white; border: 1px solid #D8D4CC; border-radius: 1.25rem; padding: 2.25rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div class="mkt-trust-icon bg-blue-100 text-blue-600" style="margin: 0 auto 1rem;">
            <%= inline_icon "device-phone-mobile" %>
          </div>
          <div style="font-size: 1.2rem; font-weight: 700; color: #4E5C64; margin-bottom: 0.25rem;">Mobile</div>
          <div style="font-size: 0.875rem; color: #4E5C64;">iOS &amp; Android</div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F0EDEA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">1</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Download the app</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">After payment, click "Download App" from your account page.</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F0EDEA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">2</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Open in your browser</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Open the file in Safari (iOS) or Chrome (Android).</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F0EDEA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">3</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Add to Home Screen</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;"><strong>iOS:</strong> Tap share &rarr; "Add to Home Screen"<br><strong>Android:</strong> Tap menu (&#8942;) &rarr; "Add to Home Screen"</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F0EDEA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">4</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Launch from your home screen</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Tap the Peponi.to icon — it opens full screen, no browser chrome.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop -->
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 120ms; background: white; border: 1px solid #D8D4CC; border-radius: 1.25rem; padding: 2.25rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div class="mkt-trust-icon bg-green-100 text-green-600" style="margin: 0 auto 1rem;">
            <%= inline_icon "laptop" %>
          </div>
          <div style="font-size: 1.2rem; font-weight: 700; color: #4E5C64; margin-bottom: 0.25rem;">Desktop</div>
          <div style="font-size: 0.875rem; color: #4E5C64;">Windows, Mac &amp; Linux</div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F2F5EF; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">1</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Download the app</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">After payment, click "Download App" from your account page.</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F2F5EF; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">2</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Open in Chrome or Edge</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Open the downloaded file in Chrome, Edge, or Safari.</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F2F5EF; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">3</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Click the install icon</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Look for the install icon (&#8862;) in the address bar, or use the browser menu to "Install app".</p>
            </div>
          </div>
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F2F5EF; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">4</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Launch from Applications</div>
              <p style="font-size: 0.85rem; color: #4E5C64; line-height: 1.6;">Find Peponi.to in your applications folder or dock and launch it like any other app.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- PWA benefits -->
    <div class="mkt-reveal" data-scroll-reveal-target="item" style="margin-top: 4rem; text-align: center;">
      <h3 style="font-size: 1.375rem; font-weight: 700; color: #4E5C64; margin-bottom: 2.5rem; letter-spacing: -0.01em;">Why install as a PWA?</h3>
