<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="mkt-hero">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.5rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      Getting started
    </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
      How to use Peponi.to
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto;">
      Open it, write a task, that’s it. The rest (themes, lists, how many days you see,
      even the app’s name) is in Settings, or a click away.
    </p>
  </div>
</section>

<!-- Getting Started -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Getting started</span>
      <h2 class="mkt-heading">Three things you’ll do on day one</h2>
    </div>

    <div class="mkt-steps">

      <!-- Step 1 -->
      <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">1</div>
          <h3 class="mkt-step__title">Add a task to a day</h3>
          <p class="mkt-step__text">
            Each column is a day. Click “Add task..” in the middle of a column and type.
            Press Enter. That’s a task on that day.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Click “Add task..” under any day</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Type and press Enter</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/empty.png", alt: "Empty day ready for your first tasks", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">2</div>
          <h3 class="mkt-step__title">Hover (or tap) for options</h3>
          <p class="mkt-step__text">
            Hover a task on desktop, or tap it on a phone, to mark it done, make it bold or starred,
            set it to repeat, or open notes. Notes can hold extra detail, sub-steps, links, and images.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Tap the box to mark it done</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Use the toolbar for bold, star, repeat, and notes</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Click the title to rename the task</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/highlight.png", alt: "Highlighted task with full details visible", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
        <div>
          <div class="mkt-step__number">3</div>
          <h3 class="mkt-step__title">Drag it where it belongs</h3>
          <p class="mkt-step__text">
            Grab the ⋮⋮ handle to reorder tasks, or drag them onto another day.
            Changes save as you go.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.625rem;">
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Reorder within a day</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Drop onto another day to reschedule</span>
            </div>
            <div class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3" style="transform: scale(0.8); flex-shrink: 0;"></div>
              <span style="font-size: 0.925rem; color: #4E5C64;">Or park it in a Not Yet list (see below)</span>
            </div>
          </div>
        </div>
        <div>
          <div class="mkt-step__visual app-preview">
            <%= image_tag "new-images/drag-task.png", alt: "Dragging a task from one day onto another", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Make it yours: rename app -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Make it yours</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Rename the app</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          The name at the top of the planner is yours to change. Click it, type something else
          (up to 30 characters), and save. Call it Peponi.to, your nickname, the name of your studio,
          whatever you actually want to see every day. This only changes the title on screen.
          It doesn’t change your account or the website address.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/rename.png", alt: "Click the title at the top to rename the app", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- View options -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">View options</span>
      <h2 class="mkt-heading">Choose how many days you see</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Open Settings (the cog, top left). Under View Days, pick <strong>T</strong> for Today only,
        or 2, 3, 4, 5, 6, or 7 days. Today mode also has a simple timer (15, 25, or 45 minutes)
        if you want a focus session.
      </p>
    </div>

    <div class="mkt-reveal" data-scroll-reveal-target="item" style="max-width: 40rem; margin: 0 auto;">
      <%= image_tag "new-images/preferences.png", alt: "View days: Today, or 2 through 7 days", class: "w-full rounded-xl shadow-md border border-gray-200" %>
    </div>
  </div>
</section>

<!-- Settings -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Settings</span>
      <h2 class="mkt-heading">What’s in the cog</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        One panel. Preferences on the first tab, your account on the second.
        Press <kbd class="mkt-kbd">s</kbd> to open it, or <kbd class="mkt-kbd">?</kbd> for the full shortcut list.
      </p>
    </div>

    <div class="mkt-grid-2" style="max-width: 52rem; margin: 0 auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; background: white; border: 1px solid #D8D4CC; border-radius: 1.25rem; padding: 1.75rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; color: #4E5C64; margin: 0 0 0.75rem;">Preferences</h3>
        <ul class="mkt-omarchy-list" style="margin: 0;">
          <li>Theme: Classic, Lined, Graph, Vintage, Dark</li>
          <li>Font: System UI, Monospace, Serif, Handwritten</li>
          <li>Accent colour: eight swatches</li>
          <li>View days: Today, or 2 through 7</li>
          <li>Show or hide completed tasks</li>
          <li>Roll unfinished tasks to the next day when you open the app</li>
          <li>Lists placement: bottom of the screen, or a panel on the right</li>
        </ul>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms; background: white; border: 1px solid #D8D4CC; border-radius: 1.25rem; padding: 1.75rem;">
        <h3 style="font-size: 1.05rem; font-weight: 700; color: #4E5C64; margin: 0 0 0.75rem;">Account</h3>
        <ul class="mkt-omarchy-list" style="margin: 0;">
          <li>Name, email, password</li>
          <li>Export your data before the hosted week ends</li>
          <li>Sign out, or delete the account</li>
          <li>Clone the repo if you want to keep it</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Themes showcase -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Themes</span>
      <h2 class="mkt-heading">Five themes, mix as you like</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Classic, Lined, Graph, Vintage, Dark. Pair any of them with a font and an accent colour.
        160 combinations, all included.
      </p>
    </div>

    <div class="mkt-grid-3">
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <%= image_tag "new-images/lined.png", alt: "Lined Paper theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Lined Paper</div>
          <div class="mkt-theme-desc">Ruled, like a notebook</div>
        </div>
      </div>
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 100ms">
        <%= image_tag "new-images/graph.png", alt: "Graph theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Graph</div>
          <div class="mkt-theme-desc">A grid behind the days</div>
        </div>
      </div>
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 200ms">
        <%= image_tag "new-images/vintage.png", alt: "Vintage theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Vintage</div>
          <div class="mkt-theme-desc">Warmer paper</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Date picker & scheduling -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Schedule</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Jump to a date</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          Use the arrows for the previous or next day (or Shift plus arrows for a week).
          Press <kbd class="mkt-kbd">c</kbd>, or tap the calendar icon, to pick any date.
          You can also drag a task onto another day.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/date-picker.png", alt: "Date picker for jumping to a day", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Recurring tasks -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Recurrence</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Repeat a task</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          From the task toolbar, set something to repeat daily, weekly, or on days you choose.
          Handy for habits, stand-ups, bins, anything that comes round again.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/recurrence-1.png", alt: "Recurring task options", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Notes & details -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Notes</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Add detail when you need it</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          Open notes from the toolbar. Write extra context, tick off sub-steps, drop in a link or a photo.
          The main list stays short; the detail is there when you open it.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/notes-full.png", alt: "Task with notes expanded", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Defer: Not yet lists -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Lists</span>
      <h2 class="mkt-heading">Park it for later</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Not ready for a day? Put it in a list. Create as many lists as you like, click a tab to rename it
        (Not yet, At some point, Shopping, whatever you actually use), and choose in Settings whether
        lists sit at the bottom or slide in from the right. Press <kbd class="mkt-kbd">y</kbd> to open them,
        <kbd class="mkt-kbd">Shift</kbd>+<kbd class="mkt-kbd">n</kbd> to make a new list while they’re open.
      </p>
    </div>

    <div class="mkt-grid-2" style="max-width: 50rem; margin: 0 auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <%= image_tag "new-images/notyet.png", alt: "Not yet list, a place to park tasks", class: "w-full rounded-xl shadow-md border border-gray-200" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem; text-align: center;">A list you can name yourself</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms">
        <%= image_tag "new-images/atssomepoint.png", alt: "Another list, named however you like", class: "w-full rounded-xl shadow-md border border-gray-200" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem; text-align: center;">As many lists as you need</p>
      </div>
    </div>
  </div>
</section>

<!-- Fonts -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Typography</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Pick your font</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          System UI, Monospace, Serif, or Handwritten. Change it in Settings.
          Same place as themes and accent colour.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/monospace.png", alt: "Monospace font option", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Keyboard shortcuts -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Keyboard</span>
      <h2 class="mkt-heading">Shortcuts, if you want them</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        They work when you’re not typing in a field. Press <kbd class="mkt-kbd">?</kbd> in the app to see this list anytime.
      </p>
    </div>
    <div class="mkt-keys-table-wrap mkt-reveal" data-scroll-reveal-target="item" style="max-width: 36rem; margin: 0 auto;">
      <table class="mkt-keys-table">
        <thead>
          <tr>
            <th>Key</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr><td><kbd class="mkt-kbd">n</kbd></td><td>New task</td></tr>
          <tr><td><kbd class="mkt-kbd">Shift</kbd>+<kbd class="mkt-kbd">n</kbd></td><td>New list (when Not Yet is open)</td></tr>
          <tr><td><kbd class="mkt-kbd">y</kbd></td><td>Toggle Not Yet</td></tr>
          <tr><td><kbd class="mkt-kbd">s</kbd></td><td>Open Settings</td></tr>
          <tr><td><kbd class="mkt-kbd">t</kbd></td><td>Go to Today</td></tr>
          <tr><td><kbd class="mkt-kbd">&larr;</kbd> / <kbd class="mkt-kbd">&rarr;</kbd></td><td>Previous / next day</td></tr>
          <tr><td><kbd class="mkt-kbd">c</kbd></td><td>Calendar</td></tr>
          <tr><td><kbd class="mkt-kbd">x</kbd></td><td>Show or hide completed tasks</td></tr>
          <tr><td><kbd class="mkt-kbd">Esc</kbd></td><td>Close a panel or modal</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Account & download -->
<section class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-step mkt-step--reverse mkt-reveal" data-scroll-reveal-target="item">
      <div>
        <span class="mkt-label">Account</span>
        <h2 class="mkt-heading" style="margin-top: 0.5rem;">Export, then run it yourself</h2>
        <p class="mkt-step__text" style="margin-bottom: 0;">
          The hosted site is a week on my server. Export your lists from Settings, then clone the repo.
          On your own instance you can Add to Home Screen. I am not a cloud for your todos.
        </p>
      </div>
      <div class="mkt-step__visual app-preview">
        <%= image_tag "new-images/account.png", alt: "Account page and download", class: "w-full rounded-xl shadow-2xl border border-gray-200" %>
      </div>
    </div>
  </div>
</section>

<!-- Mobile experience -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--amber">Mobile</span>
      <h2 class="mkt-heading">Works on your phone</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Add tasks, open the calendar, swipe through days. On your own instance you can install it as a PWA
        so it sits on your home screen. A shortcut to peponi.to only lasts for the hosted week.
      </p>
    </div>

    <div class="mkt-grid-3" style="align-items: end; max-width: 56rem; margin: 0 auto;">
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; text-align: center;">
        <%= image_tag "new-images/pixel7.png", alt: "Peponi.to on Pixel 7", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">App on phone</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms; text-align: center;">
        <%= image_tag "new-images/mob-calendar.png", alt: "Mobile calendar view", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">Calendar on mobile</p>
      </div>
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 160ms; text-align: center;">
        <%= image_tag "new-images/mob-tap.png", alt: "Tap to add task on mobile", class: "w-full rounded-xl shadow-lg border border-gray-200", style: "max-width: 200px; margin: 0 auto; display: block;" %>
        <p style="font-size: 0.875rem; color: #4E5C64; margin-top: 0.75rem;">Tap to add</p>
      </div>
    </div>
  </div>
</section>

<!-- PWA Installation -->
<section class="mkt-section mkt-section--cream" id="install-pwa">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Install as a PWA</span>
      <h2 class="mkt-heading">Your app, on your device</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        On your own instance, install Peponi.to as a Progressive Web App.
        Full screen, no browser chrome, launches from your home screen or dock.
        On peponi.to that shortcut still talks to my server, and the account is deleted after a week.
      </p>
    </div>

    <div class="mkt-grid-2--wide-gap" style="max-width: 60rem; margin: 0 auto;">

      <!-- Mobile -->
      <div class="mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms; background: white; border: 1px solid #D8D4CC; border-radius: 1.25rem; padding: 2.25rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div class="mkt-trust-icon bg-blue-100 text-blue-600" style="margin: 0 auto 1rem;">
            <%= inline_icon "device-phone-mobile" %>
          </div>
          <div style="font-size: 1.2rem; font-weight: 700; color: #4E5C64; margin-bottom: 0.25rem;">Mobile</div>
          <div style="font-size: 0.875rem; color: #4E5C64;">iOS &amp; Android</div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="flex items-start" style="gap: 1rem;">
            <div style="width: 1.75rem; height: 1.75rem; background: #F0EDEA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; color: #4E5C64;">1</div>
            <div>
              <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem; margin-bottom: 0.2rem;">Download the app</div>
