<!-- Navigation -->
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="py-20 bg-gradient-to-br from-blue-50 to-indigo-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl font-bold text-gray-900 mb-6">How to Use Todo-it</h1>
    <p class="text-xl text-gray-600 mb-8">
      Try free for 7 days on our servers, then download to your device forever. 
      Master the art of beautiful productivity in just a few simple steps.
    </p>
  </div>
</section>

<!-- Getting Started -->
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Getting Started</h2>
    
    <div class="space-y-12">
      <!-- Step 1 -->
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="md:w-1/2">
          <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <span class="text-xl font-bold text-blue-600">1</span>
          </div>
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">Create Your First Page</h2>
          <p class="text-gray-600 mb-4">
            Think of pages like notebook sections. Create a page for "Daily Tasks," "Work Projects," 
            "Shopping List," or any way you organize your life.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Click "New Page" from your dashboard
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Give it a meaningful name and description
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Start adding todos!
            </li>
          </ul>
        </div>
        <div class="md:w-1/2">
          <div class="bg-gray-100 rounded-lg p-6 notebook-background">
            <div class="bg-white rounded-lg p-4 shadow-sm">
              <div class="font-semibold text-gray-900 mb-2">📝 Daily Tasks</div>
              <p class="text-sm text-gray-600">My personal todo list for today</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Step 2 -->
      <div class="flex flex-col md:flex-row-reverse items-center gap-8">
        <div class="md:w-1/2">
          <div class="bg-green-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <span class="text-xl font-bold text-green-600">2</span>
          </div>
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">Add Beautiful Todos</h2>
          <p class="text-gray-600 mb-4">
            Each todo can have a title, detailed notes, and an optional due date. 
            The hand-drawn checkboxes make every completion feel satisfying.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Click "Add a new todo..." to expand the form
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Add due dates for time-sensitive tasks
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Use notes for additional context
            </li>
          </ul>
        </div>
        <div class="md:w-1/2">
          <div class="bg-gray-100 rounded-lg p-6 notebook-background">
            <div class="space-y-3">
              <div class="flex items-center">
                <div class="hand-checkbox hand-checkbox-checked mr-3"></div>
                <span class="text-gray-500 line-through">Review marketing copy</span>
              </div>
              <div class="flex items-center">
                <div class="hand-checkbox hand-checkbox-unchecked mr-3"></div>
                <div class="flex-1">
                  <span class="text-gray-700">Plan team meeting</span>
                  <div class="mt-1">
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium border border-orange-300 text-orange-700 bg-orange-50">
                      📅 Today
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Step 3 -->
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="md:w-1/2">
          <div class="bg-purple-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <span class="text-xl font-bold text-purple-600">3</span>
          </div>
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">Organize & Prioritize</h2>
          <p class="text-gray-600 mb-4">
            Drag and drop todos to reorder them by priority. Todo-it automatically sorts 
            by due dates, putting urgent tasks at the top.
          </p>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Drag the handle (⋮⋮) to reorder todos
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Overdue items appear in red
            </li>
            <li class="flex items-center">
              <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
              Due today items appear in orange
            </li>
          </ul>
        </div>
        <div class="md:w-1/2">
          <div class="bg-gray-100 rounded-lg p-6 notebook-background">
            <div class="space-y-2">
              <div class="flex items-center">
                <div class="text-gray-400 mr-2">⋮⋮</div>
                <div class="hand-checkbox hand-checkbox-unchecked mr-3"></div>
                <span class="text-red-600 font-medium">Overdue task</span>
              </div>
              <div class="flex items-center">
                <div class="text-gray-400 mr-2">⋮⋮</div>
                <div class="hand-checkbox hand-checkbox-unchecked mr-3"></div>
                <span class="text-orange-600 font-medium">Due today</span>
              </div>
              <div class="flex items-center">
                <div class="text-gray-400 mr-2">⋮⋮</div>
                <div class="hand-checkbox hand-checkbox-unchecked mr-3"></div>
                <span class="text-gray-700">Regular task</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pro Tips -->
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Pro Tips</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <div class="bg-yellow-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
          <span class="text-2xl">🎨</span>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Choose Your Theme</h2>
        <p class="text-gray-600">
          Switch between Classic Dotted, Lined Paper, Graph, Vintage, and Dark Mode themes - all included free. 
          Find the style that matches your mood and workspace.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
          <span class="text-2xl">📱</span>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Works on Mobile</h2>
        <p class="text-gray-600">
          During your trial, Todo-it works beautifully on phones and tablets. After download, 
          install it as a PWA on any device for a native app-like experience.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <div class="bg-green-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
          <span class="text-2xl">⚡</span>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Magical Animations</h2>
        <p class="text-gray-600">
          Watch new todos appear with typewriter effects, enjoy smooth checkbox animations, 
          and experience delightful form transitions that make productivity fun.
        </p>
      </div>
      
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <div class="bg-purple-100 rounded-full w-12 h-12 flex items-center justify-center mb-4">
          <span class="text-2xl">🔄</span>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Stay Organized</h2>
        <p class="text-gray-600">
          Create separate pages for different areas of your life. Work, personal, shopping, 
          hobbies - organize your todos the way that makes sense to you.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- PWA Installation Instructions -->
<section class="py-20 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Install as a PWA</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        After your trial, download Todo-it to your device and install it as a Progressive Web App 
        for a native app-like experience.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Mobile Installation -->
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <div class="text-center mb-8">
          <div class="text-6xl mb-4">📱</div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Mobile Installation</h2>
          <p class="text-gray-600">Works on iOS and Android devices</p>
        </div>
        
        <div class="space-y-6">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Download the App</h3>
              <p class="text-gray-600 text-sm">After your trial, click "Download App" to get the app bundle.</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Open in Browser</h3>
              <p class="text-gray-600 text-sm">Open the downloaded file in your mobile browser (Safari, Chrome, etc.).</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Add to Home Screen</h3>
              <p class="text-gray-600 text-sm">
                <strong>iOS:</strong> Tap the share button, then "Add to Home Screen"<br>
                <strong>Android:</strong> Tap the menu (⋮) and select "Add to Home Screen"
              </p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-sm">4</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Launch from Home Screen</h3>
              <p class="text-gray-600 text-sm">Tap the Todo-it icon on your home screen to launch the app.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop Installation -->
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <div class="text-center mb-8">
          <div class="text-6xl mb-4">💻</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Desktop Installation</h3>
          <p class="text-gray-600">Works on Windows, Mac, and Linux</p>
        </div>
        
        <div class="space-y-6">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
              <span class="text-green-600 font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Download the App</h3>
              <p class="text-gray-600 text-sm">After your trial, click "Download App" to get the app bundle.</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
              <span class="text-green-600 font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Open in Browser</h3>
              <p class="text-gray-600 text-sm">Open the downloaded file in Chrome, Edge, or Safari.</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
              <span class="text-green-600 font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Install Prompt</h3>
              <p class="text-gray-600 text-sm">
                Look for the install icon (⊞) in your browser's address bar and click it, 
                or use the browser menu to install the app.
              </p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
              <span class="text-green-600 font-bold text-sm">4</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Launch from Applications</h3>
              <p class="text-gray-600 text-sm">Find Todo-it in your applications folder or desktop and launch it.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Benefits of PWA Installation -->
    <div class="mt-16 text-center">
      <h3 class="text-2xl font-bold text-gray-900 mb-8">Why Install as a PWA?</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="font-semibold text-gray-900 mb-2">Lightning Fast</h3>
          <p class="text-gray-600 text-sm">Works instantly, no internet required after installation</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-4">🔒</div>
          <h3 class="font-semibold text-gray-900 mb-2">Private & Secure</h3>
          <p class="text-gray-600 text-sm">Your data stays on your device, completely private</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-4">📱</div>
          <h3 class="font-semibold text-gray-900 mb-2">Native Feel</h3>
          <p class="text-gray-600 text-sm">Works like a native app with full screen and notifications</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 bg-blue-600">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl font-bold text-white mb-4">Ready to Get Started?</h2>
    <p class="text-xl text-blue-100 mb-8">
      Try free for 7 days on our servers, then download to your device forever. 
      No credit card required.
    </p>
    
    <%= link_to signup_path, class: "bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-colors inline-block" do %>
      🚀 Start Free Trial
    <% end %>
  </div>
</section>

<%= render 'shared/footer' %>