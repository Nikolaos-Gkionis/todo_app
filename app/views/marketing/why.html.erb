<!-- Navigation -->
<%= render 'shared/navbar' %>

<!-- Hero Section -->
<section class="py-20 bg-gradient-to-br from-blue-50 to-indigo-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
      Why we built
      <span class="text-blue-600">Todo-it</span>
    </h1>
    <p class="text-xl text-gray-600 mb-8 leading-relaxed max-w-3xl mx-auto">
      Try it free for 30 days on our servers, then download to your device forever. 
      Because your mind deserves clarity, not clutter.
    </p>
  </div>
</section>

<!-- Main Content -->
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Against Lock-In -->
    <div class="mb-16">
      <div class="flex items-start space-x-6">
        <div class="flex-shrink-0">
          <div class="bg-red-100 rounded-full w-16 h-16 flex items-center justify-center">
            <span class="text-2xl">🔒</span>
          </div>
        </div>
        <div class="flex-grow">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Try Before You Own</h2>
          <p class="text-lg text-gray-600 mb-4">
            Most todo apps lock you in immediately. We offer a 30-day free trial on our servers, 
            then you download the full app to your device forever.
          </p>
          <p class="text-gray-600">
            <strong>Endless Features = Endless Stress</strong><br>
            Most apps overwhelm you with projects, tags, reminders, notifications. 
            This one just asks: What's today?
          </p>
        </div>
      </div>
    </div>

    <!-- Against Subscriptions -->
    <div class="mb-16">
      <div class="flex items-start space-x-6">
        <div class="flex-shrink-0">
          <div class="bg-orange-100 rounded-full w-16 h-16 flex items-center justify-center">
            <span class="text-2xl">💳</span>
          </div>
        </div>
        <div class="flex-grow">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Against Subscriptions</h2>
          <p class="text-lg text-gray-600 mb-4">
            $5/month adds up to $60/year. In 3 years, you've bought the same app three times. 
            Here, you pay once and download the app to your device forever.
          </p>
          <p class="text-gray-600">
            <strong>Yours Forever</strong><br>
            Pay once. Download to your device. It's not another subscription — it's your daily ritual.
          </p>
        </div>
      </div>
    </div>

    <!-- Against the App Store Tax -->
    <div class="mb-16">
      <div class="flex items-start space-x-6">
        <div class="flex-shrink-0">
          <div class="bg-yellow-100 rounded-full w-16 h-16 flex items-center justify-center">
            <span class="text-2xl">🏪</span>
          </div>
        </div>
        <div class="flex-grow">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Against the App Store Tax</h2>
          <p class="text-lg text-gray-600 mb-4">
            30% fees, arbitrary bans, endless approvals. 
            Download directly from us — no app store gatekeepers, no ongoing fees.
          </p>
          <p class="text-gray-600">
            <strong>A Notebook, Reimagined</strong><br>
            Each day begins with a fresh page. Just like pen and paper. 
            Clear. Focused. Human.
          </p>
        </div>
      </div>
    </div>

    <!-- For Digital Sovereignty -->
    <div class="mb-16">
      <div class="flex items-start space-x-6">
        <div class="flex-shrink-0">
          <div class="bg-green-100 rounded-full w-16 h-16 flex items-center justify-center">
            <span class="text-2xl">🛡️</span>
          </div>
        </div>
        <div class="flex-grow">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">For Digital Sovereignty</h2>
          <p class="text-lg text-gray-600 mb-4">
            After the trial, your data lives on your device. Offline-first, encrypted by default, 
            no servers to depend on.
          </p>
          <p class="text-gray-600">
            <strong>No Noise</strong><br>
            No ads, no nudges, no streaks. The only thing in front of you: your day.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Philosophy Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Philosophy</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        We believe in the power of simplicity and the importance of digital independence.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Tech Community Values -->
      <div class="bg-white rounded-lg p-8 shadow-sm">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">For the Tech Community</h3>
        <p class="text-gray-600 mb-4">
          "Software should feel like owning a notebook, not renting one."
        </p>
        <ul class="space-y-2 text-gray-600">
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>30-day free trial on servers</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>Download to your device forever</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>No vendor lock-in</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>One-time payment model</span>
          </li>
        </ul>
      </div>
      
      <!-- Lifestyle Values -->
      <div class="bg-white rounded-lg p-8 shadow-sm">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">For Mindful Productivity</h3>
        <p class="text-gray-600 mb-4">
          "Because life's too short for complicated todo apps."
        </p>
        <ul class="space-y-2 text-gray-600">
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>Minimalist design</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>Focus on today</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>No distractions</span>
          </li>
          <li class="flex items-center">
            <div class="hand-checkbox hand-checkbox-checked mr-3 scale-75"></div>
            <span>Beautiful simplicity</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="py-20 bg-blue-600">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl font-bold text-white mb-4">
      Ready to experience the difference?
    </h2>
    <p class="text-xl text-blue-100 mb-8">
      Try Todo-it free for 30 days on our servers, then download to your device forever.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to signup_path, class: "bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-colors" do %>
        ✨ Start Your Free Trial
      <% end %>
      <%= link_to pricing_path, class: "border-2 border-white hover:bg-white hover:text-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-colors" do %>
        View Pricing
      <% end %>
    </div>
    
    <p class="text-blue-200 mt-6 text-sm">
      Join thousands who've chosen simplicity over complexity
    </p>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-2">
        <div class="flex items-center mb-4">
          <div class="logo-checkbox mr-3" style="filter: brightness(0) invert(1);"></div>
          <span class="text-2xl font-bold">Todo-it</span>
        </div>
        <p class="text-gray-400 mb-4">
          Beautiful notebook-style todo pages that make productivity feel personal and delightful.
        </p>
        <p class="text-gray-500 text-sm">
          © 2025 Todo-it. Made with ❤️ for productivity enthusiasts.
        </p>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Product</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Home", root_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Pricing", pricing_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "How to Use", how_to_path, class: "hover:text-white transition-colors" %></li>
          <li><span class="text-white">Why Todo-it</span></li>
        </ul>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Account</h3>
        <ul class="space-y-2 text-gray-400">
          <li><%= link_to "Sign In", login_path, class: "hover:text-white transition-colors" %></li>
          <li><%= link_to "Create Account", signup_path, class: "hover:text-white transition-colors" %></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
