<div class="marketing-landing" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<!-- Hero -->
<section class="mkt-hero">
  <div class="mkt-inner">
    <div class="mkt-hero__grid">

      <!-- Left: Copy -->
      <div>
        <div class="mkt-hero__eyebrow">
          <span class="mkt-hero__eyebrow-dot"></span>
          Try it here for a week. Then run it yourself.
        </div>

        <h1 class="mkt-hero__title">
          Organise your tasks, every day.
          <span class="mkt-hero__title-handwritten">Your way.</span>
        </h1>

        <p class="mkt-hero__subtitle">
          I built this for myself. I like it. I like the Omarchy plugin.
          This is the age of AI — anyone with a little grind can build this, or better.
          You are welcome to have it.
        </p>

        <div class="mkt-hero__cta-group">
          <%= link_to signup_path, class: "mkt-btn mkt-btn--primary" do %>
            Try it here &rarr;
          <% end %>
          <%= link_to github_source_url, class: "mkt-btn mkt-btn--ghost", target: "_blank", rel: "noopener" do %>
            Run it yourself
          <% end %>
        </div>

        <div class="mkt-hero__trust-strip">
          <span class="mkt-hero__trust-item">A week on my server</span>
          <span class="mkt-hero__trust-item">Then I delete the data</span>
          <span class="mkt-hero__trust-item">MIT, from source</span>
          <span class="mkt-hero__trust-item">No tracking</span>
        </div>
      </div>

      <!-- Right: App mockup (floating portal) -->
      <div class="mkt-portal">
        <div class="mkt-portal__frame">
          <%= image_tag "new-images/4day-classic.png", alt: "Peponi.to Focus or multi-day view" %>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Feature strip -->
<div class="mkt-strip mkt-reveal" data-scroll-reveal-target="item">
  <div class="mkt-inner">
    <div class="mkt-strip__grid">
      <div class="mkt-strip__item">
        <span class="mkt-strip__dot"></span>
        Tasks organised by day
      </div>
      <div class="mkt-strip__item">
        <span class="mkt-strip__dot"></span>
        Themes, fonts, and colours included
      </div>
      <div class="mkt-strip__item">
        <span class="mkt-strip__dot"></span>
        Rename the app. Name your lists.
      </div>
    </div>
  </div>
</div>

<!-- Features -->
<section id="features" class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Features</span>
      <h2 class="mkt-heading">A planner that stays out of the way</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Write what needs doing today. Park the rest in lists you name yourself.
        Switch how many days you see, how it looks, and even what the app is called.
      </p>
    </div>

    <div class="mkt-grid-3">

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <div class="mkt-card__icon bg-blue-100 text-blue-600">
          <%= inline_icon "calendar" %>
        </div>
        <div class="mkt-card__title">One day, or a whole week</div>
        <p class="mkt-card__text">
          In Settings, pick Today only, or 2, 3, 4, 5, 6, or 7 days side by side.
          Drag tasks between days when plans change.
        </p>
      </div>

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms">
        <div class="mkt-card__icon bg-green-100 text-green-600">
          <%= inline_icon "sparkles" %>
        </div>
        <div class="mkt-card__title">Make it yours</div>
        <p class="mkt-card__text">
          Click the title at the top and rename the app (up to 30 characters).
          Create Not Yet lists, name them, and put them at the bottom or on the right.
        </p>
      </div>

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 160ms">
        <div class="mkt-card__icon bg-purple-100 text-purple-600">
          <%= inline_icon "device-phone-mobile" %>
        </div>
        <div class="mkt-card__title">Try it here, keep it by running it</div>
        <p class="mkt-card__text">
          The hosted site is a week on my server. After that I delete the account.
          Clone the repo to keep your lists. On your own instance you can Add to Home Screen.
        </p>
      </div>

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 240ms">
        <div class="mkt-card__icon bg-orange-100 text-orange-600">
          <%= inline_icon "shield-check" %>
        </div>
        <div class="mkt-card__title">No social logins</div>
        <p class="mkt-card__text">
          Email and password. No Google, Facebook, or Apple. I don’t mine your tasks for ads,
          and I don’t run analytics on you.
        </p>
      </div>

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 320ms">
        <div class="mkt-card__icon bg-yellow-100 text-yellow-600">
          <%= inline_icon "circle-stack" %>
        </div>
        <div class="mkt-card__title">Export anytime</div>
        <p class="mkt-card__text">
          Download a copy of your data whenever you want. Delete your account whenever you want.
          On Omarchy, local mode never sends tasks to peponi.to at all.
        </p>
      </div>

      <div class="mkt-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 400ms">
        <div class="mkt-card__icon bg-indigo-100 text-indigo-600">
          <%= inline_icon "paint-brush" %>
        </div>
        <div class="mkt-card__title">Themes, fonts, colours</div>
        <p class="mkt-card__text">
          Classic, Lined, Graph, Vintage, and Dark. Four fonts. Eight accent colours.
          That’s 160 combinations, all in Settings, all included.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- Omarchy desktop helper -->
<section id="omarchy" class="mkt-section mkt-section--cream">
  <div class="mkt-inner">
    <div class="mkt-split mkt-reveal" data-scroll-reveal-target="item">
      <div class="mkt-split__copy">
        <span class="mkt-label">Omarchy</span>
        <h2 class="mkt-heading" style="text-align: left;">Your Focus day, on the Linux desktop</h2>
        <p class="mkt-subheading" style="margin: 0; text-align: left; max-width: 36rem;">
          This is what I actually use. On <a href="https://omarchy.org/" class="mkt-inline-link">Omarchy</a>,
          stay local: tasks never leave this machine. Or sign in once during your hosted week
          to copy existing tasks here. After that, new work stays on this machine.
          Open it from the bar, step days with arrows,
          Not Yet with <kbd class="mkt-kbd">y</kbd>, today with <kbd class="mkt-kbd">t</kbd>.
        </p>
        <div class="mkt-omarchy-choice">
          <div class="mkt-omarchy-choice__card">
            <div class="mkt-omarchy-choice__label">Local</div>
            <h3 class="mkt-omarchy-choice__title">No account</h3>
            <p class="mkt-omarchy-choice__text">
              Tasks stay on this Linux machine. Nothing is sent to peponi.to.
            </p>
          </div>
          <div class="mkt-omarchy-choice__card">
            <div class="mkt-omarchy-choice__label">Optional</div>
            <h3 class="mkt-omarchy-choice__title">Signed in once</h3>
            <p class="mkt-omarchy-choice__text">
              Copy existing tasks onto this machine. After that they live here. I am not your cloud.
            </p>
          </div>
        </div>
        <ul class="mkt-omarchy-list">
          <li>One-command install for Omarchy plugins</li>
          <li>Start local, or sign in once if you want a snapshot of hosted lists</li>
          <li>Bar toggle on the left, centre, or right. Your choice</li>
        </ul>
        <div class="mkt-hero__cta-group" style="margin-top: 1.5rem;">
          <%= link_to how_to_path(anchor: "omarchy"), class: "mkt-btn mkt-btn--primary" do %>
            How to use on Omarchy &rarr;
          <% end %>
          <a href="https://github.com/Nikolaos-Gkionis/peponi-omarchy" class="mkt-btn mkt-btn--ghost" target="_blank" rel="noopener">
            GitHub
          </a>
        </div>
        <p style="margin-top: 0.85rem;">
          <code class="mkt-code-chip">omarchy plugin add … --enable</code>
        </p>
      </div>
      <div class="mkt-split__media">
        <div class="mkt-portal__frame mkt-portal__frame--flat">
          <%= image_tag "new-images/peponi-omarchy.png", alt: "Peponi One Day overlay on Omarchy Linux, focused day view with Not Yet drawer" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Themes Showcase -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label">Themes</span>
      <h2 class="mkt-heading">Pick a look, then tweak it</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        Five themes, four fonts, eight accent colours. 160 combinations. <br>
        Classic, Lined, Graph, Vintage, Dark. Change them in Settings whenever you like.
      </p>
    </div>

    <div class="mkt-grid-3">

      <!-- Classic -->
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <%= image_tag "new-images/3days.png", alt: "Classic Theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Classic</div>
          <div class="mkt-theme-desc">Clean and quiet</div>
        </div>
      </div>

      <!-- Graph -->
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 100ms">
        <%= image_tag "new-images/graph.png", alt: "Graph Theme", class: "w-full rounded-xl shadow-md border border-gray-200 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Graph</div>
          <div class="mkt-theme-desc">A grid if you like structure</div>
        </div>
      </div>

      <!-- Dark -->
      <div class="mkt-theme-card mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 200ms">
        <%= image_tag "new-images/dark-mode.png", alt: "Dark Mode Theme", class: "w-full rounded-xl shadow-md border border-gray-700 mkt-theme-img" %>
        <div class="mkt-theme-label">
          <div class="mkt-theme-name">Dark Mode</div>
          <div class="mkt-theme-desc">Easier at night</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Privacy & Trust -->
<section class="mkt-section bg-white">
  <div class="mkt-inner">
    <div class="mkt-section-intro mkt-reveal" data-scroll-reveal-target="item">
      <span class="mkt-label mkt-label--green">Privacy</span>
      <h2 class="mkt-heading">I collect as little as I can</h2>
      <p class="mkt-subheading" style="margin: 0 auto;">
        No ads. No tracking pixels. No “sign in with” buttons that phone home to someone else.
        You can export or delete everything from Settings.
      </p>
    </div>

    <div class="mkt-trust-grid">
      <div class="mkt-trust-item mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 0ms">
        <div class="mkt-trust-icon bg-green-100 text-green-600">
          <%= inline_icon "lock-closed" %>
        </div>
        <div class="mkt-trust-title">Email and password only</div>
        <p class="mkt-trust-text">No social logins, no big-tech tracking. Your notes are yours, not Google’s or Facebook’s.</p>
      </div>

      <div class="mkt-trust-item mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 80ms">
        <div class="mkt-trust-icon bg-blue-100 text-blue-600">
          <%= inline_icon "circle-stack" %>
        </div>
        <div class="mkt-trust-title">Run it yourself</div>
        <p class="mkt-trust-text">MIT. Clone the repo. Your SQLite file is the data. That is how you keep it.</p>
      </div>

      <div class="mkt-trust-item mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 160ms">
        <div class="mkt-trust-icon bg-purple-100 text-purple-600">
          <%= inline_icon "bolt" %>
        </div>
        <div class="mkt-trust-title">Local on your machine</div>
        <p class="mkt-trust-text">Self-host, or use the Omarchy overlay. A PWA against peponi.to is only a shortcut to my server for that week.</p>
      </div>

      <div class="mkt-trust-item mkt-reveal" data-scroll-reveal-target="item" style="--reveal-delay: 240ms">
        <div class="mkt-trust-icon bg-orange-100 text-orange-600">
          <%= inline_icon "shield-check" %>
        </div>
        <div class="mkt-trust-title">No ads. Ever.</div>
        <p class="mkt-trust-text">No banners, no upsells inside the planner, no push notifications nagging you. Just your list.</p>
      </div>
    </div>

    <div class="mkt-reveal" data-scroll-reveal-target="item" style="text-align: center; margin-top: 3rem;">
      <div style="display: inline-flex; align-items: center; gap: 1rem; background: #F2F5EF; border: 1px solid #B5C1A8; border-radius: 0.875rem; padding: 1rem 1.75rem;">
        <div class="mkt-trust-icon bg-green-100 text-green-600" style="margin: 0; flex-shrink: 0;">
          <%= inline_icon "shield-check" %>
        </div>
        <div style="text-align: left;">
          <div style="font-weight: 600; color: #4E5C64; font-size: 0.9rem;">GDPR</div>
          <div style="font-size: 0.825rem; color: #4E5C64;">Export or permanently delete your data at any time</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="mkt-cta mkt-reveal" data-scroll-reveal-target="item">
  <div class="mkt-inner">
    <h2 class="mkt-cta__title">Ready to organise your days?</h2>
    <p class="mkt-cta__subtitle">
      Try it here for a week. Then I delete the account.<br>
      Keep it by running it from source.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <%= link_to signup_path, class: "mkt-btn mkt-btn--white" do %>
        Try it here
      <% end %>
      <%= link_to github_source_url, class: "mkt-btn mkt-btn--ghost", target: "_blank", rel: "noopener" do %>
        GitHub
      <% end %>
    </div>
    <p class="mkt-cta__trust">No payment &nbsp;&middot;&nbsp; MIT &nbsp;&middot;&nbsp; Built for myself</p>
  </div>
</section>

<%= render 'shared/footer' %>
</div>
