<%# Web-safe, accessibility-friendly highlight colours: gray, red, orange, yellow, green, blue, purple %>
<% highlight_colors = [nil, '#CCCCCC', '#CC3333', '#FF9933', '#CC9900', '#009933', '#3366CC', '#9966CC'] %>
<div id="todo_<%= todo.id %>"
     data-id="<%= todo.id %>"
     data-controller="todo-actions<%= ' reveal-todo' if local_assigns[:reveal] %>"
     data-todo-actions-todo-id-value="<%= todo.id %>"
     class="todo-item<%= ' todo-item--done' if todo.completed? %><%= ' todo-item--bold' if todo.bold? %><%= ' todo-item--has-notes' if todo.notes.present? %>"
     <% if todo.highlight_color.present? %>style="background: <%= todo.highlight_color %>22;"<% end %>>

  <%# Checkbox: tap to mark complete/incomplete — minimal square box %>
  <%= form_with model: todo, method: :patch, local: false, class: "todo-item__complete-form flex-shrink-0", data: { todo_actions_target: "completeForm" } do |form| %>
    <%= form.hidden_field :completed, value: !todo.completed %>
    <div class="todo-checkbox-box <%= todo.completed? ? 'todo-checkbox-box--checked' : 'todo-checkbox-box--unchecked' %>"
         onclick="this.closest('form').requestSubmit()"
         role="button"
         tabindex="0"
         aria-label="<%= todo.completed? ? 'Mark as incomplete' : 'Mark as complete' %>"
         onkeydown="if(event.key==='Enter'||event.key===' ')this.closest('form').requestSubmit(); event.preventDefault();">
    </div>
  <% end %>

  <%# Title: tap to inline edit (cursor at end, no navigation) %>
  <% is_recurring = todo.recurrence_rule.present? || todo.title.to_s.downcase.match?(/\bevery\s+(day|other day|weekday|week|other week|month|year)\b/) %>
  <span class="todo-item__title-wrap" data-controller="inline-edit" data-inline-edit-initial-value-value="<%= h(todo.title) %>">
    <span class="todo-item__title<%= ' todo-item__title--done' if todo.completed? %>"
          data-inline-edit-target="display"
          data-action="click->inline-edit#startEdit"
          role="button"
          tabindex="0"
          aria-label="Edit: <%= todo.title %>"
          onkeydown="if(event.key==='Enter'||event.key===' ')event.preventDefault();this.click()">
      <%= todo.title %>
      <% if is_recurring %>
        <svg aria-label="Recurring task" style="display:inline-block; margin-left:4px; vertical-align:middle;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
      <% end %>
    </span>
    <%= form_with model: todo, method: :patch, local: false, class: "todo-item__edit-form", data: { inline_edit_target: "form" } do |f| %>
      <span class="todo-item__edit-inner" data-inline-edit-target="editContainer" style="display:none">
        <%= f.text_field :title, class: "todo-item__title-input", data: { inline_edit_target: "input" } %>
        <% if is_recurring %>
          <svg aria-label="Recurring task" style="display:inline-block; margin-left:4px; vertical-align:middle;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
        <% end %>
      </span>
    <% end %>
  </span>

  <%# Actions: toolbar (Bold, Star, Recurr, Notes) + Delete — hover on desktop, always visible on mobile %>
  <span class="todo-item__actions">
    <%# Style mini-toolbar — Bold, Star, Recurr, Notes (shown on hover; on mobile opens in modal) %>
    <span class="todo-item__toolbar" role="toolbar" aria-label="Style options">
      <%# Bold %>
      <%= form_with model: todo, method: :patch, local: false, class: "todo-toolbar__form" do |f| %>
        <%= f.hidden_field :bold, value: !todo.bold %>
        <button type="submit" class="todo-toolbar__btn<%= ' todo-toolbar__btn--active' if todo.bold? %>" title="Bold" aria-label="Toggle bold">
          <strong>B</strong>
        </button>
      <% end %>

      <%# Highlight colour picker (Star) %>
      <span class="todo-toolbar__highlight-wrap" title="Highlight">
        <button type="button" class="todo-toolbar__btn todo-toolbar__btn--highlight" onclick="this.nextElementSibling.classList.toggle('todo-highlight-picker--open')" aria-label="Highlight colour">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= todo.highlight_color.presence || 'none' %>" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </button>
        <div class="todo-highlight-picker" role="listbox">
          <% highlight_colors.each do |color| %>
            <%= form_with model: todo, method: :patch, local: false do |f| %>
              <%= f.hidden_field :highlight_color, value: color.to_s %>
              <button type="submit"
                      class="todo-highlight-color<%= ' todo-highlight-color--active' if todo.highlight_color == color.to_s %>"
                      style="background: <%= color || '#ffffff' %>; border: 1px solid #ccc;"
                      title="<%= color.nil? ? 'No highlight' : color %>"
                      aria-label="<%= color.nil? ? 'Remove highlight' : "Highlight #{color}" %>">
                <%= '✕' if color.nil? %>
              </button>
            <% end %>
          <% end %>
        </div>
      </span>

      <%# Recurrence %>
      <span class="todo-toolbar__recur-wrap" title="Recurrence">
        <button type="button" class="todo-toolbar__btn<%= ' todo-toolbar__btn--active' if todo.recurrence_rule.present? %>" onclick="this.nextElementSibling.classList.toggle('todo-recur-picker--open')" aria-label="Set recurrence">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        </button>
        <div class="todo-recur-picker" role="listbox">
          <% [nil, 'every day', 'every weekday', 'every week', 'every month', 'every year'].each do |rule| %>
            <%= form_with model: todo, method: :patch, local: false do |f| %>
              <%= f.hidden_field :recurrence_rule, value: rule.to_s %>
              <button type="submit"
                      class="todo-recur-option<%= ' todo-recur-option--active' if todo.recurrence_rule == rule.to_s %>"
                      aria-label="<%= rule.nil? ? 'No recurrence' : rule.capitalize %>">
                <%= rule.nil? ? 'None' : rule.capitalize %>
              </button>
            <% end %>
          <% end %>
        </div>
      </span>

      <%# Notes — inside toolbar at end (right) %>
      <button type="button"
              class="todo-item__notes-btn todo-toolbar__btn<%= ' todo-item__notes-btn--active' if todo.notes.present? %>"
              id="notes-btn-<%= todo.id %>"
              title="Notes"
              aria-label="Open notes for: <%= todo.title %>"
              onclick="window.dispatchEvent(new CustomEvent('open-notes-panel', { detail: { id: '<%= todo.id %>', title: '<%= j(todo.title) %>', notes: this.dataset.todoNotes } }))"
              data-todo-notes="<%= h(todo.notes.to_s) %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      </button>
    </span>

    <%# Delete — outside toolbar group %>
    <%= link_to todo_path(todo),
          data: { "turbo-method": :delete, confirm: "Delete?" },
          class: "todo-item__delete",
          title: "Delete",
          "aria-label" => "Delete: #{todo.title}" do %>
      ×
    <% end %>
  </span>

  <%# Mobile options modal (kept for potential future use; toolbar shown via CSS on mobile) %>
  <dialog id="todo-options-<%= todo.id %>" class="todo-options-modal" data-todo-actions-target="optionsModal" onclick="if(event.target===this)this.close()">
    <div class="todo-options-modal__content" onclick="event.stopPropagation()">
      <div class="todo-options-modal__toolbar">
        <%= form_with model: todo, method: :patch, local: false, class: "todo-toolbar__form" do |f| %>
          <%= f.hidden_field :bold, value: !todo.bold %>
          <button type="submit" class="todo-toolbar__btn<%= ' todo-toolbar__btn--active' if todo.bold? %>" title="Bold"><strong>B</strong></button>
        <% end %>
        <span class="todo-toolbar__highlight-wrap">
          <button type="button" class="todo-toolbar__btn todo-toolbar__btn--highlight" onclick="this.nextElementSibling.classList.toggle('todo-highlight-picker--open')"><svg width="14" height="14" viewBox="0 0 24 24" fill="<%= todo.highlight_color.presence || 'none' %>" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></button>
          <div class="todo-highlight-picker todo-highlight-picker--modal">
            <% highlight_colors.each do |color| %>
              <%= form_with model: todo, method: :patch, local: false do |f| %>
                <%= f.hidden_field :highlight_color, value: color.to_s %>
                <button type="submit" class="todo-highlight-color<%= ' todo-highlight-color--active' if todo.highlight_color == color.to_s %>" style="background: <%= color || '#ffffff' %>; border: 1px solid #ccc;"><%= '✕' if color.nil? %></button>
              <% end %>
            <% end %>
          </div>
        </span>
        <span class="todo-toolbar__recur-wrap">
          <button type="button" class="todo-toolbar__btn<%= ' todo-toolbar__btn--active' if todo.recurrence_rule.present? %>" onclick="this.nextElementSibling.classList.toggle('todo-recur-picker--open')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></button>
          <div class="todo-recur-picker">
            <% [nil, 'every day', 'every weekday', 'every week', 'every month', 'every year'].each do |rule| %>
              <%= form_with model: todo, method: :patch, local: false do |f| %>
                <%= f.hidden_field :recurrence_rule, value: rule.to_s %>
                <button type="submit" class="todo-recur-option<%= ' todo-recur-option--active' if todo.recurrence_rule == rule.to_s %>"><%= rule.nil? ? 'None' : rule.capitalize %></button>
              <% end %>
            <% end %>
          </div>
        </span>
        <button type="button" class="todo-toolbar__btn<%= ' todo-item__notes-btn--active' if todo.notes.present? %>" onclick="document.getElementById('todo-options-<%= todo.id %>').close(); window.dispatchEvent(new CustomEvent('open-notes-panel', { detail: { id: '<%= todo.id %>', title: '<%= j(todo.title) %>', notes: document.getElementById('notes-btn-<%= todo.id %>').dataset.todoNotes } }))" title="Notes">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        </button>
        <%= link_to todo_path(todo), data: { "turbo-method": :delete, confirm: "Delete?" }, class: "todo-options-modal__delete", title: "Delete" do %>×<% end %>
      </div>
      <form method="dialog"><button type="submit" class="todo-options-modal__close">Close</button></form>
    </div>
  </dialog>
</div>
