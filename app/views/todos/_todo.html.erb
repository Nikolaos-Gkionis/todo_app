<div id="todo_<%= todo.id %>" data-id="<%= todo.id %>" class="todo-item<%= ' todo-item--done' if todo.completed? %>">
  <%= form_with model: todo, method: :patch, local: false, class: "todo-item__form" do |form| %>
    <%= form.hidden_field :completed, value: !todo.completed %>
    <% is_recurring = todo.title.to_s.downcase.match?(/\bevery\s+(day|other day|weekday|week|other week|month|year)\b/) %>
    <button type="submit" class="todo-item__title<%= ' todo-item__title--done' if todo.completed? %>" aria-label="<%= todo.completed? ? 'Mark as incomplete' : 'Mark as complete' %>">
      <%= todo.title %>
      <% if is_recurring %>
        <svg aria-label="Recurring task" style="display:inline-block; margin-left:4px; vertical-align:middle;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2"><path d="M17 1l4 4-4 4"></path><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><path d="M7 23l-4-4 4-4"></path><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
      <% end %>
    </button>
  <% end %>

  <span class="todo-item__actions">
    <%= link_to todo_path(todo),
          data: { "turbo-method": :delete, confirm: "Delete?" },
          class: "todo-item__delete",
          title: "Delete",
          "aria-label" => "Delete: #{todo.title}" do %>
      ×
    <% end %>
  </span>
</div>
