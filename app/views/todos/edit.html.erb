<div class="edit-modal-overlay" id="edit-modal-overlay">
  <div class="edit-modal-container">
    <!-- Header -->
    <div class="mb-6 text-center">
      <h1 class="text-2xl font-bold mb-2">Edit Todo</h1>
      <p class="text-gray-600 text-sm">Update your todo details</p>
    </div>

    <!-- Edit Form -->
    <%= form_with(model: @todo, url: page_todo_path(@page, @todo), method: :patch, class: "space-y-6") do |f| %>
      <!-- Title -->
      <div class="form-group">
        <%= f.label :title, "What needs to be done?", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :title,
                         class: "w-full pulse-focus px-3 py-2 border-0 bg-transparent",
                         placeholder: "What needs to be done?",
                         required: true %>
      </div>

      <!-- Notes -->
      <div class="form-group">
        <%= f.label :notes, "Additional notes", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :notes,
                        class: "w-full pulse-focus px-3 py-2 border-0 bg-transparent resize-none",
                        placeholder: "Add any additional notes...",
                        rows: 3 %>
      </div>

      <!-- Due Date -->
      <div class="form-group">
        <%= f.label :due_date, "Due Date (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.date_field :due_date,
                         class: "w-full pulse-focus px-3 py-2 border-0 bg-transparent",
                         min: Date.current %>
      </div>

      <!-- Completed Status -->
      <div class="flex items-center space-x-3">
        <%= f.check_box :completed,
                        class: "hand-checkbox-input" %>
        <%= f.label :completed, "Mark as completed", class: "text-sm text-gray-700" %>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-between pt-6">
        <div class="flex space-x-4">
          <%= link_to "Cancel",
                      @page,
                      class: "text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline-gray text-sm" %>
          <%= link_to "Delete",
                      page_todo_path(@page, @todo),
                      method: :delete,
                      data: {
                        turbo_method: :delete,
                        confirm: "Are you sure you want to delete this todo?"
                      },
                      class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline-red text-sm" %>
        </div>

        <%= f.submit "Update Todo",
                    class: "text-green-600 hover:text-green-800 font-medium hand-underline hand-underline-green text-sm" %>
      </div>
    <% end %>
  </div>
</div>

<style>
/* Modal overlay that inherits background properly */
.edit-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

/* Theme-aware modal container */
.edit-modal-container {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 12px;
  padding: 2rem;
  max-width: 500px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow:
    0 10px 25px rgba(0, 0, 0, 0.1),
    0 0 0 1px rgba(255, 255, 255, 0.2);
}

/* Dark theme modal */
.theme-dark .edit-modal-container {
  background: rgba(31, 41, 55, 0.98);
  border: 1px solid rgba(75, 85, 99, 0.3);
  box-shadow:
    0 10px 25px rgba(0, 0, 0, 0.3),
    0 0 0 1px rgba(75, 85, 99, 0.2);
}

/* Lined paper theme */
.theme-lined .edit-modal-container {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(229, 231, 235, 0.3);
}

/* Graph paper theme */
.theme-graph .edit-modal-container {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(229, 231, 235, 0.3);
}

/* Vintage theme */
.theme-vintage .edit-modal-container {
  background: rgba(254, 249, 231, 0.98);
  border: 1px solid rgba(180, 83, 9, 0.2);
}

/* Form groups */
.form-group {
  margin-bottom: 1.5rem;
}

/* Hand-drawn checkbox input */
.hand-checkbox-input {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  cursor: pointer;
  background: url("data:image/svg+xml,%3csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M2,1.5 Q2.1,1.1 3.2,1.7 L14.4,2.3 Q16,2.1 16.2,3.6 L16.4,13.8 Q16,15.1 14.3,15.3 L3.6,15.1 Q2.1,15.4 1.8,14.1 L1.6,3.2 Q2.1,1.8 2,1.5 Z' stroke='%236b7280' stroke-width='1.2' fill='none' stroke-linecap='round'/%3e%3c/svg%3e") no-repeat center;
  background-size: contain;
  appearance: none;
  -webkit-appearance: none;
  border: none;
}

.hand-checkbox-input:checked {
  background: url("data:image/svg+xml,%3csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M2,1.5 Q2.1,1.1 3.2,1.7 L14.4,2.3 Q16,2.1 16.2,3.6 L16.4,13.8 Q16,15.1 14.3,15.3 L3.6,15.1 Q2.1,15.4 1.8,14.1 L1.6,3.2 Q2.1,1.8 2,1.5 Z' stroke='%236b7280' stroke-width='1.2' fill='none' stroke-linecap='round'/%3e%3cpath d='M4.2,9.1 Q5.4,10.3 6.5,11.4 Q10.2,7.7 13.7,5.1' stroke='%2316a34a' stroke-width='1.8' fill='none' stroke-linecap='round'/%3e%3c/svg%3e") no-repeat center;
  background-size: contain;
}

/* Dark theme checkbox */
.theme-dark .hand-checkbox-input {
  background: url("data:image/svg+xml,%3csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M2,1.5 Q2.1,1.1 3.2,1.7 L14.4,2.3 Q16,2.1 16.2,3.6 L16.4,13.8 Q16,15.1 14.3,15.3 L3.6,15.1 Q2.1,15.4 1.8,14.1 L1.6,3.2 Q2.1,1.8 2,1.5 Z' stroke='%23d1d5db' stroke-width='1.2' fill='none' stroke-linecap='round'/%3e%3c/svg%3e") no-repeat center;
}

.theme-dark .hand-checkbox-input:checked {
  background: url("data:image/svg+xml,%3csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M2,1.5 Q2.1,1.1 3.2,1.7 L14.4,2.3 Q16,2.1 16.2,3.6 L16.4,13.8 Q16,15.1 14.3,15.3 L3.6,15.1 Q2.1,15.4 1.8,14.1 L1.6,3.2 Q2.1,1.8 2,1.5 Z' stroke='%23d1d5db' stroke-width='1.2' fill='none' stroke-linecap='round'/%3e%3cpath d='M4.2,9.1 Q5.4,10.3 6.5,11.4 Q10.2,7.7 13.7,5.1' stroke='%2334d399' stroke-width='1.8' fill='none' stroke-linecap='round'/%3e%3c/svg%3e") no-repeat center;
}

/* Mobile responsive - full screen on mobile */
@media (max-width: 640px) {
  .edit-modal-overlay {
    padding: 0;
  }

  .edit-modal-container {
    margin: 0;
    border-radius: 0;
    min-height: 100vh;
    padding: 1.5rem;
    max-width: none;
  }
}

/* Pulse focus effect for inputs */
.pulse-focus:focus {
  animation: pulse-focus 0.3s ease-out;
}

@keyframes pulse-focus {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}
</style>

<script>
// Dynamically inherit the body's background and apply blur
document.addEventListener('DOMContentLoaded', function() {
  const overlay = document.getElementById('edit-modal-overlay');
  const body = document.body;

  // Copy background properties from body
  const bodyStyles = window.getComputedStyle(body);
  const backgroundColor = bodyStyles.backgroundColor;
  const backgroundImage = bodyStyles.backgroundImage;
  const backgroundSize = bodyStyles.backgroundSize;
  const backgroundPosition = bodyStyles.backgroundPosition;

  // Apply background to overlay
  overlay.style.backgroundColor = backgroundColor;
  overlay.style.backgroundImage = backgroundImage;
  overlay.style.backgroundSize = backgroundSize;
  overlay.style.backgroundPosition = backgroundPosition;

  // Add subtle blur effect
  overlay.style.backdropFilter = 'blur(1px)';
  overlay.style.webkitBackdropFilter = 'blur(1px)';
});
</script>