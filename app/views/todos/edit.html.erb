<div class="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-100 py-8">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Edit Todo</h1>
          <p class="text-gray-600 mt-1">Update your todo details</p>
        </div>
        <a href="<%= @page %>" class="text-purple-600 hover:text-purple-800 font-medium">
          ← Back to <%= @page.name %>
        </a>
      </div>
    </div>

    <!-- Edit Form -->
    <div class="bg-white rounded-xl shadow-lg p-6">
      <%= form_with(model: @todo, url: page_todo_path(@page, @todo), method: :patch, class: "space-y-6") do |f| %>
        <!-- Title -->
        <div>
          <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :title,
                           class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors",
                           placeholder: "What needs to be done?",
                           required: true %>
        </div>

        <!-- Notes -->
        <div>
          <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :notes,
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors resize-none",
                          placeholder: "Add any additional notes...",
                          rows: 4 %>
        </div>

        <!-- Due Date -->
        <div>
          <%= f.label :due_date, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :due_date,
                           class: "px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors" %>
        </div>

        <!-- Completed Status -->
        <div class="flex items-center">
          <%= f.check_box :completed,
                          class: "h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" %>
          <%= f.label :completed, class: "ml-2 block text-sm text-gray-700" %>
        </div>

        <!-- Submit Buttons -->
        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
          <div class="flex items-center space-x-4">
            <%= link_to "Cancel",
                        @page,
                        class: "px-4 py-2 text-gray-600 hover:text-gray-800 font-medium transition-colors" %>
            <%= link_to "Delete",
                        page_todo_path(@page, @todo),
                        method: :delete,
                        data: { confirm: "Are you sure you want to delete this todo?" },
                        class: "px-4 py-2 text-red-600 hover:text-red-800 font-medium transition-colors" %>
          </div>

          <%= f.submit "Update Todo",
                      class: "px-6 py-3 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
