<div class="container mx-auto px-4 py-8">
  <div class="mb-4">
    <%= link_to "← Back to #{@project.name}", @project, class: "text-blue-600 hover:text-blue-800" %>
  </div>
  
  <h1 class="text-2xl font-bold mb-6">Edit Todo</h1>
  
  <%= form_with model: [@project, @todo], local: true, data: { turbo: false }, class: "space-y-4" do |form| %>
    <!-- Display validation errors -->
    <% if @todo.errors.any? %>
      <div class="rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= pluralize(@todo.errors.count, "error") %> prohibited this todo from being saved:
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @todo.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div>
      <%= form.label :title, "Todo Title", class: "block text-sm font-medium mb-1" %>
      <%= form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "What needs to be done?" %>
    </div>
    
    <div>
      <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :notes, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", rows: 3, placeholder: "Add any additional details..." %>
    </div>
    
    <div class="flex items-center">
      <%= form.check_box :completed, class: "h-4 w-4 text-blue-600 mr-2" %>
      <%= form.label :completed, "Mark as completed", class: "text-sm font-medium" %>
    </div>
    
    <div class="flex space-x-3">
      <%= form.submit "Save Changes", class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500" %>
      <%= link_to "Cancel", @project, class: "bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-500" %>
      <%= link_to "Delete Todo", project_todo_path(@project, @todo), 
            data: { 
              "turbo-method": :delete,
              confirm: "Are you sure you want to delete this todo?" 
            },
            class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500" %>
    </div>
  <% end %>
</div>