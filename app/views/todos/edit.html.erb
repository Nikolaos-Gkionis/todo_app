<div class="container mx-auto px-4 py-8">
  <div class="mb-4">
    <%= link_to "← Back to #{@page.name}", @page, class: "text-blue-600 hover:text-blue-800" %>
  </div>
  
  <h1 class="text-2xl font-bold mb-6">Edit Todo</h1>
  
  <%= form_with model: [@page, @todo], local: true, data: { turbo: false }, class: "space-y-4" do |form| %>
    <!-- Display validation errors -->
    <% if @todo.errors.any? %>
      <div class="text-red-700 mb-4">
        <h3 class="font-medium mb-2">
          ⚠️ <%= pluralize(@todo.errors.count, "error") %> prohibited this todo from being saved:
        </h3>
        <ul class="list-disc pl-5 space-y-1">
          <% @todo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, "Todo Title", class: "block text-sm font-medium mb-1" %>
      <%= form.text_field :title, class: "w-full", placeholder: "What needs to be done?" %>
    </div>
    
    <div>
      <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :notes, class: "w-full", rows: 3, placeholder: "Add any additional details..." %>
    </div>
    
    <div>
      <%= form.label :due_date, "Due Date (optional)", class: "block text-sm font-medium mb-1" %>
      <%= form.date_field :due_date, class: "w-full px-3 py-2 border-0 bg-transparent", min: Date.current %>
    </div>
    
    <div class="flex items-center">
      <%= form.check_box :completed, class: "h-4 w-4 text-blue-600 mr-2" %>
      <%= form.label :completed, "Mark as completed", class: "text-sm font-medium" %>
    </div>
    
    <div class="flex space-x-3">
      <%= form.submit "Save Changes", class: "text-green-600 hover:text-green-800 font-medium hand-underline hand-underline-green cursor-pointer bg-transparent border-0" %>
      <%= link_to "Cancel", @page, class: "text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline-gray" %>
      <%= link_to "Delete Todo", page_todo_path(@page, @todo), 
            data: { 
              "turbo-method": :delete,
              confirm: "Are you sure you want to delete this todo?" 
            },
            class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline-red" %>
    </div>
  <% end %>
</div>