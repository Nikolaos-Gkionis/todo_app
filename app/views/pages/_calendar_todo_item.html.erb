<%# Compact todo item for calendar view - checkbox, title, edit/delete %>
<div class="calendar-todo-item flex flex--align-start p-2 rounded hover:bg-gray-50">
  <%= form_with model: todo, url: todo_path(todo), method: :patch, local: true, class: "flex flex--align-center mr-2 flex-shrink-0" do |form| %>
    <div class="hand-checkbox <%= todo.completed? ? 'hand-checkbox--checked' : 'hand-checkbox--unchecked' %>"
         onclick="this.closest('form').submit()"
         role="button"
         tabindex="0"
         aria-label="<%= todo.completed? ? 'Mark as incomplete' : 'Mark as complete' %>">
    </div>
    <%= form.hidden_field :completed, value: !todo.completed %>
  <% end %>

  <div class="flex--grow min-w-0">
    <div class="todo-title text-sm font-medium truncate <%= 'hand-strike-through text-gray-500' if todo.completed %>">
      <%= todo.title %>
    </div>
  </div>

  <div class="flex space-x-1 ml-1 flex-shrink-0">
    <!-- Edit button removed -->
    <%= link_to todo_path(todo),
                data: { turbo_method: :delete, turbo_confirm: "Delete this task?" },
                class: "text-gray-400 hover:text-red-500 p-1 opacity-0 group-hover:opacity-100 transition-opacity",
          "aria-label" => "Delete todo: #{todo.title}" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    <% end %>
  </div>
</div>
