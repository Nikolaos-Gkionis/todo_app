<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Edit Page</h1>
  
  <%= form_with model: @page, local: true, data: { turbo: false }, class: "space-y-4" do |form| %>
    <!-- Display validation errors -->
    <% if @page.errors.any? %>
      <div class="text-red-700 mb-4">
        <h3 class="font-medium mb-2">
          ⚠️ <%= pluralize(@page.errors.count, "error") %> prohibited this page from being saved:
        </h3>
        <ul class="list-disc pl-5 space-y-1">
          <% @page.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium mb-1" %>
      <%= form.text_field :name, class: "w-full form-input", placeholder: "What's this page about?", style: "font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif !important;" %>
    </div>
    
    <div>
      <%= form.label :description, class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :description, class: "w-full form-input", rows: 3, placeholder: "Add some notes or details...", style: "font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif !important;" %>
    </div>

    <div>
      <%= form.label :template, "Page style", class: "block text-sm font-medium mb-2" %>
      <div class="flex gap-4 flex-wrap">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :template, "minimal", class: "form-radio" %>
          <span>Minimal</span>
          <span class="text-sm text-gray-500">(simple list)</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :template, "calendar", class: "form-radio" %>
          <span>Calendar</span>
          <span class="text-sm text-gray-500">(weekly view)</span>
        </label>
      </div>
    </div>
    
    <div class="flex space-x-3">
      <%= form.submit "Save changes", class: "text-green-600 hover:text-green-800 font-medium hand-underline hand-underline-green cursor-pointer bg-transparent border-0" %>
      <%= link_to "Cancel", @page, class: "text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline-gray" %>
      <%= link_to "Delete Page", @page, 
            data: { 
              "turbo-method": :delete,
              confirm: "Are you sure? This will delete the page and all its todos!" 
            },
            class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline-red" %>
    </div>
  <% end %>
</div>