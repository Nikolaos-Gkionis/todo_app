<%# Calendar template: weekly columns, device date/time, todos by day, unscheduled at bottom %>
<div class="calendar-view" data-controller="device-datetime">
  <%# Device date/time header %>
  <div class="calendar-datetime mb-6 notebook-card py-4 px-5">
    <div class="flex flex-wrap items-center gap-4">
      <div>
        <div class="text-sm text-gray-500 uppercase tracking-wide">Date</div>
        <div data-device-datetime-target="date" class="text-lg font-semibold"></div>
      </div>
      <div>
        <div class="text-sm text-gray-500 uppercase tracking-wide">Time</div>
        <div data-device-datetime-target="time" class="text-lg font-mono font-semibold"></div>
      </div>
    </div>
  </div>

  <%# Weekly columns - horizontal scroll on mobile, grid on desktop %>
  <div class="calendar-week overflow-x-auto pb-4" data-controller="calendar-week" data-calendar-week-today-value="<%= @today_index %>">
    <div class="calendar-week__grid">
      <% @week_dates.each_with_index do |date, idx| %>
        <% is_today = date == Time.current.to_date %>
        <div class="calendar-day"
             data-calendar-day
             data-day-index="<%= idx %>">
          <div class="notebook-card p-4 <%= 'calendar-day--today' if is_today %>">
            <div class="calendar-day__date">
              <%= date.strftime('%d %b %Y').upcase %>
            </div>
            <div class="calendar-day__name <%= 'calendar-day__name--today' if is_today %>">
              <%= date.strftime('%A') %>
            </div>

            <% day_todos = (@todos_by_date[date] || []).sort_by { |t| [t.completed? ? 1 : 0, t.position] } %>
            <div class="space-y-2 min-h-[2rem]">
              <% day_todos.each do |todo| %>
                <%= render "pages/calendar_todo_item", todo: todo, page: @page %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Unscheduled todos at bottom %>
  <% if @unscheduled_todos.any? %>
    <div class="notebook-card mt-6 p-4">
      <h3 class="text-lg font-semibold mb-3 text-gray-600">Unscheduled</h3>
      <div class="space-y-2">
        <% @unscheduled_todos.each do |todo| %>
          <%= render "pages/calendar_todo_item", todo: todo, page: @page %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Add Todo form (with due_date for calendar) %>
  <div class="mt-6 notebook-card p-4">
    <button type="button" id="add-todo-trigger-cal" class="add-todo--collapsed w-full text-left" onclick="toggleAddTodoCalendar()" aria-label="Add a new todo">
      <p class="text-gray-700">✏️ Add a new todo...</p>
    </button>

    <div id="add-todo-form-cal" class="add-todo--expanded hidden form-slide-in mt-4">
      <h2 class="text-lg font-semibold mb-4">Add New Todo</h2>
      <%= form_with model: Todo.new, url: todos_path, local: true, class: "space-y-4" do |form| %>
        <%= form.hidden_field :page_id, value: @page.id %>
        <div>
          <%= form.label :title, "What needs to be done?", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :title, class: "form-input w-full pulse-focus", placeholder: "What needs to be done?", style: "font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif !important;" %>
        </div>

        <div>
          <%= form.label :due_date, "Due date (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.date_field :due_date, class: "form-input", value: Time.current.to_date %>
        </div>

        <div>
          <%= form.label :notes, "Additional notes (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :notes, class: "form-input w-full pulse-focus", placeholder: "Additional notes (optional)", rows: 2, style: "font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif !important;" %>
        </div>

        <div class="flex space-x-3">
          <%= form.submit "Add Todo", class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline--blue cursor-pointer bg-transparent border-0" %>
          <button type="button" onclick="toggleAddTodoCalendar()" class="text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline--gray cursor-pointer bg-transparent border-0">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
function toggleAddTodoCalendar() {
  const trigger = document.getElementById('add-todo-trigger-cal');
  const form = document.getElementById('add-todo-form-cal');
  if (trigger && form) {
    if (form.classList.contains('hidden')) {
      form.classList.remove('hidden');
      trigger.classList.add('hidden');
      const input = form.querySelector('input[name="todo[title]"]');
      if (input) input.focus();
    } else {
      form.classList.add('hidden');
      trigger.classList.remove('hidden');
      const f = form.querySelector('form');
      if (f) f.reset();
    }
  }
}
</script>
