<div class="container px-4 py-8">
  <!-- Page Header (shared across templates) -->
  <div class="mb-8">
    <%= link_to "← Back to Pages", pages_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <div class="flex flex--justify-between flex--align-start">
      <div>
        <div class="flex flex--align-center space-x-4 mb-2">
          <h1 class="text-xl md:text-3xl font-bold"><%= @page.name %></h1>
          <% if @page.total_todos_count > 0 %>
            <div class="flex flex--align-center space-x-3">
              <span class="text-lg font-medium text-gray-700 bg-gray-100 px-3 py-1 rounded-full">
                <%= @page.progress_text %>
              </span>
              <% if @page.completion_percentage > 0 %>
                <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full bg-green-500 transition-all duration-300"
                       style="width: <%= @page.completion_percentage %>%"></div>
                </div>
                <span class="text-sm text-gray-600"><%= @page.completion_percentage %>%</span>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if @page.description.present? %>
          <p class="text-gray-600 mt-2"><%= @page.description %></p>
        <% end %>
      </div>
      <div class="flex space-x-3 md:p-1">
        <%= link_to edit_page_path(@page),
              class: "text-green-600 hover:text-green-800 font-medium hand-underline hand-underline--green text-sm flex flex--align-center",
              title: "Edit page" do %>
          <svg class="w-4 h-4 md:hidden mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          <span class="hidden md:inline">Edit Page</span>
          <span class="md:hidden"></span>
        <% end %>
        <%= link_to @page,
              data: {
                "turbo-method": :delete,
                confirm: "Are you sure? This will delete the page and all its todos!"
              },
              class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline--red text-sm flex flex--align-center",
              title: "Delete page" do %>
          <svg class="w-4 h-4 md:hidden mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span class="hidden md:inline">Delete Page</span>
          <span class="md:hidden"></span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Branch on template: minimal (simple list) or calendar (weekly view) %>
  <% if @page.template == "calendar" %>
    <%= render "show_calendar" %>
  <% else %>
    <%= render "show_minimal" %>
  <% end %>
</div>
