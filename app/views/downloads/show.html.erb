<div class="download-header">
  <div class="container">
    <div class="download-header__content">
      <%= link_to app_root_path, class: "download-header__back", style: "display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; color: #4b5563; text-decoration: none; font-size: 0.95rem;" do %>
        ← Back to app
      <% end %>
      <h1 class="download-header__title">Take your lists with you</h1>
      <p class="download-header__subtitle">
        Export a JSON copy, then run Peponi.to from source if you want to keep it.
        A PWA on peponi.to is only a shortcut to this server for the hosted week.
      </p>
    </div>
  </div>
</div>

<div class="download-instructions">
  <div class="container">
    <h3 class="download-instructions__title">How to keep it</h3>

    <div class="download-instructions__steps">
      <div class="download-step">
        <div class="download-step__number">1</div>
        <div class="download-step__content">
          <h4 class="download-step__title">Export your data</h4>
          <p class="download-step__description">
            Download a JSON file of your pages and tasks.
          </p>
          <div class="download-step__action">
            <%= link_to "Export My Data", export_trial_data_path, class: "download-button download-button--secondary" %>
          </div>
        </div>
      </div>

      <div class="download-step">
        <div class="download-step__number">2</div>
        <div class="download-step__content">
          <h4 class="download-step__title">Run it yourself</h4>
          <p class="download-step__description">
            Clone the repo. Follow the README. Your SQLite file is the data.
          </p>
          <div class="download-step__action">
            <%= link_to "GitHub", github_source_url, class: "download-button download-button--primary", target: "_blank", rel: "noopener" %>
          </div>
        </div>
      </div>

      <div class="download-step">
        <div class="download-step__number">3</div>
        <div class="download-step__content">
          <h4 class="download-step__title">Optional: Add to Home Screen here</h4>
          <p class="download-step__description">
            On this hosted site that only lasts the week. On your own instance it stays.
          </p>
          <div class="download-step__action">
            <%= link_to "Install guide", install_pwa_path, class: "download-button download-button--secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
