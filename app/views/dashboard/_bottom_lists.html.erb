<%# Bottom lists drawer — closed by default; list columns only appear after the user creates a list %>
<div class="dashboard__lists" data-controller="collapsible-list" data-action="lists-drawer-expand@window->collapsible-list#expand">
  <div class="lists__body" data-collapsible-list-target="content">
    <% if @pages.any? %>
      <div class="lists__columns" data-controller="drag" data-drag-lists="true">
        <% @pages.each do |page| %>
          <div class="lists__column" data-page-id="<%= page.id %>">
            <%# Tasks live in their own list (like a week column) so Turbo can append into it %>
            <div class="lists__column-items"
                 data-controller="drag"
                 data-drag-page-id="<%= page.id %>"
                 id="todos_page_<%= page.id %>">
              <% page.todos.ordered.each do |todo| %>
                <% if todo.is_visual_break? %>
                  <%= render "todos/visual_break", todo: todo %>
                <% else %>
                  <%= render "todos/todo", todo: todo %>
                <% end %>
              <% end %>
            </div>
            <div class="lists__column-add" id="todo-page-add-<%= page.id %>">
              <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form", html: { id: "todo-form-page-#{page.id}" }, data: { controller: "todo-form", action: "keydown->todo-form#onKeydown submit->todo-form#onSubmit" } do |form| %>
                <%= form.hidden_field :page_id, value: page.id %>
                <%= form.text_field :title, class: "todo-input", autocomplete: "off", placeholder: "Add task.." %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard__empty-lists">
        <p class="dashboard__empty-text">No lists yet. Use + to create one.</p>
      </div>
    <% end %>
  </div>

  <div class="lists__titlebar" data-controller="list-scroll-arrows">
    <button data-action="click->collapsible-list#toggle"
            data-collapsible-list-target="chevronBtn"
            title="Toggle lists"
            aria-label="Toggle lists"
            class="lists__titlebar-chevron">
      <%# Starts pointing up (closed). Stimulus rotates it when the drawer opens. %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="collapsible-list__chevron" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg);"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    <div class="lists__titlebar-names"
         data-controller="drag"
         data-drag-lists="true"
         data-list-scroll-arrows-target="scrollContainer"
         id="lists-titlebar-names">
      <% @pages.each do |page| %>
        <div class="lists__titlebar-col" data-page-id="<%= page.id %>" style="flex: 0 0 280px;">
          <h3 class="lists__column-title" style="display:flex; justify-content:space-between; align-items:center; cursor:grab; margin:0;">
            <span style="display:flex; align-items:center; gap:6px;">
              <%# Grabber: three lines (not the old two-column dots) %>
              <span class="drag-handle lists__drag-handle" aria-label="Drag to reorder" role="img">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <rect y="2" width="16" height="2" rx="1"></rect>
                  <rect y="7" width="16" height="2" rx="1"></rect>
                  <rect y="12" width="16" height="2" rx="1"></rect>
                </svg>
              </span>
              <span id="list-name-display-<%= page.id %>"><%= page.name.upcase %></span>
            </span>
            <div style="position:relative;">
              <%# Options: pencil, so it is not another row of dots %>
              <button type="button" aria-label="List options" class="lists__options-btn" onclick="document.getElementById('options-dialog-<%= page.id %>').showModal()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                </svg>
              </button>
              <dialog id="options-dialog-<%= page.id %>" class="app-dialog app-dialog--compact">
                <div class="app-dialog__stack">
                  <div class="app-dialog__header" style="margin-bottom:8px;">
                    <span class="app-dialog__label">LIST OPTIONS</span>
                    <form method="dialog"><button type="submit" class="app-dialog__close" aria-label="Close">&times;</button></form>
                  </div>
                  <%= form_with model: page, url: page_path(page), method: :patch, local: true, id: "rename-list-form-#{page.id}", html: { "data-list-rename-form": true, "data-page-id": page.id }, class: "app-dialog__stack" do |f| %>
                    <%= f.text_field :name, class: "app-dialog__input", placeholder: "Rename list..." %>
                    <%= f.submit "Rename", class: "app-dialog__btn app-dialog__btn--primary" %>
                  <% end %>
                  <hr class="app-dialog__divider">
                  <%= form_with url: page_path(page), method: :delete, local: true, id: "delete-list-form-#{page.id}" do |f| %>
                    <button type="button"
                            class="app-dialog__danger"
                            onclick="document.getElementById('options-dialog-<%= page.id %>').close(); window.showConfirmModal({ message: 'This will permanently delete the list and all its todos. Are you sure?', onConfirm: function() { document.getElementById('delete-list-form-<%= page.id %>').submit(); } });">
                      Delete List
                    </button>
                  <% end %>
                </div>
              </dialog>
            </div>
          </h3>
        </div>
      <% end %>
      <button onclick="document.getElementById('new-list-dialog').showModal()" title="New list" aria-label="New list" class="lists__titlebar-add lists__titlebar-add--inline">+</button>
    </div>

    <div class="lists__titlebar-scroll-arrows" data-list-scroll-arrows-target="arrows">
      <button type="button" onclick="document.getElementById('lists-titlebar-names').scrollBy({left:-280,behavior:'smooth'})" title="Scroll left" aria-label="Scroll list headers left" class="lists__titlebar-scroll-btn">‹</button>
      <button type="button" onclick="document.getElementById('lists-titlebar-names').scrollBy({left:280,behavior:'smooth'})" title="Scroll right" aria-label="Scroll list headers right" class="lists__titlebar-scroll-btn">›</button>
    </div>
  </div>
</div>

<script>
  (function() {
    function setupListRenameForms() {
      document.querySelectorAll('[data-list-rename-form]').forEach(function(form) {
        if (form.dataset.listRenameBound) return;
        form.dataset.listRenameBound = 'true';

        form.addEventListener('submit', function(e) {
          e.preventDefault();

          var pageId = form.dataset.pageId;
          var nameInput = form.querySelector('input[name="page[name]"]');
          var display = document.getElementById('list-name-display-' + pageId);
          var dialog = document.getElementById('options-dialog-' + pageId);
          var submitBtn = form.querySelector('[type="submit"]');
          var newName = nameInput.value.trim();

          if (!newName) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Saving…';

          var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

          fetch(form.action, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
              'Accept': 'application/json'
            },
            body: JSON.stringify({ page: { name: newName } })
          })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (data.status === 'success') {
              if (display) display.textContent = data.name.toUpperCase();
              if (dialog) dialog.close();
            } else {
              alert('Could not rename: ' + (data.errors || []).join(', '));
            }
          })
          .catch(function() {
            alert('Something went wrong. Please try again.');
          })
          .finally(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Rename';
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', setupListRenameForms);
    document.addEventListener('turbo:load', setupListRenameForms);
  })();
</script>
