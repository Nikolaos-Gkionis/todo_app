<%# Focus mode: when view_days == 1, hide nav/title/FAB, center day, show pomodoro %>
<% lists_placement = @lists_placement.presence || "right" %>
<% body_classes = [ "lists-placement-#{lists_placement}" ] %>
<% body_classes.unshift("focus-mode") if (@view_days || 7) == 1 %>
<%= content_for :body_class, body_classes.join(" ") %>

<div class="dashboard<%= ' dashboard--focus-mode' if (@view_days || 7) == 1 %><%= " dashboard--lists-#{lists_placement}" unless (@view_days || 7) == 1 %><%= ' lists-collapsed' if (@view_days || 7) != 1 && lists_placement == 'bottom' %>"
     data-controller="date-picker"
     data-date-picker-base-path-value="<%= app_root_path %>"
     data-date-picker-start-date-value="<%= @start_date.strftime('%Y-%m-%d') %>">
  <%# ── Header (hidden in focus mode) ── %>
  <header class="dashboard__header<%= ' dashboard__header--hidden' if (@view_days || 7) == 1 %>" style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 10px 0; margin-bottom: 20px;">
    <div class="dashboard__header-left" style="display: flex; gap: 15px; align-items: center;">
      <!-- Search functionality removed per user request -->
    </div>
    <div class="dashboard__header-center" style="font-size: 1.5rem; font-weight: 800; letter-spacing: 0.1em; color: var(--user-accent); justify-self: center;">
      <%# Clickable app title — hover to reveal edit hint, click to open rename modal %>
      <span id="app-title-display"
            title="Click to rename"
            style="cursor: pointer; position: relative; transition: opacity 0.2s;"
            onmouseenter="this.querySelector('.app-title-edit-hint').style.opacity='1'"
            onmouseleave="this.querySelector('.app-title-edit-hint').style.opacity='0'"
            onclick="document.getElementById('app-title-dialog').showModal()">
        <%= current_user.app_title %>
        <span class="app-title-edit-hint"
              style="opacity: 0; transition: opacity 0.2s; font-size: 0.65rem; font-weight: 500; color: #aaa; margin-left: 4px; vertical-align: middle;">
          &#9998;
        </span>
      </span>
    </div>
    <div class="dashboard__header-right dashboard__nav-row" style="display: flex; gap: 12px; color: #2d2d2d; font-weight: bold; font-size: 1.2rem; align-items: center; justify-self: end;">
      <%= link_to "&laquo;".html_safe, app_root_path(start_date: @start_date - 7.days, days: @view_days), class: "dashboard__nav-btn", "aria-label" => "Previous week", title: "Previous week" %>
      <%= link_to "&lsaquo;".html_safe, app_root_path(start_date: @start_date - 1.day, days: @view_days), class: "dashboard__nav-btn", "aria-label" => "Previous day", title: "Previous day" %>
      <button type="button"
              class="calendar-picker__trigger"
              aria-label="Pick a date"
              title="Pick a date"
              data-action="click->date-picker#open">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </button>
      <%= link_to "&rsaquo;".html_safe, app_root_path(start_date: @start_date + 1.day, days: @view_days), class: "dashboard__nav-btn", "aria-label" => "Next day", title: "Next day" %>
      <%= link_to "&raquo;".html_safe, app_root_path(start_date: @start_date + 7.days, days: @view_days), class: "dashboard__nav-btn", "aria-label" => "Next week", title: "Next week" %>
    </div>
  </header>

  <%# ── Week View (60% height; centered single column in focus mode) ── %>
  <div class="dashboard__week-view dashboard__week-view--<%= @view_days == 1 ? 'focus' : 'multi' %>" style="grid-template-columns: repeat(<%= @view_days %>, 1fr);">
    <% @week_dates.each do |date| %>
      <%
        is_today = date == Time.current.to_date
        day_todos = (@todos_by_date[date] || []).sort_by { |t| [t.completed? ? 1 : 0, t.position] }
      %>
      <div class="week-col<%= ' week-col--today' if is_today %>">
        <div class="week-col__header">
          <span class="week-col__date"><%= date.strftime('%-d %b %Y').upcase %></span>
          <span class="week-col__day<%= ' week-col__day--today' if is_today %>"><%= date.strftime('%A').upcase %></span>
        </div>

        <div class="week-col__items"
             data-controller="drag"
             data-drag-date="<%= date %>"
             id="todos_date_<%= date %>">
          <% day_todos.each do |todo| %>
            <%= render "todos/todo", todo: todo %>
          <% end %>
        </div>

        <div class="week-col__add">
          <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form", html: { id: "todo-form-date-#{date}" }, data: { controller: "todo-form", action: "submit->todo-form#onSubmit" } do |form| %>
            <%= form.hidden_field :due_date, value: date %>
            <%= form.text_field :title, class: "todo-input", autocomplete: "off", placeholder: "Add task.." %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Focus mode only: pomodoro (no bottom lists section) ── %>
  <% focus_mode = (@view_days || 7) == 1 %>
  <% if focus_mode %>
    <div class="dashboard__focus-footer">
      <div class="focus-mode__pomodoro" data-controller="pomodoro" data-pomodoro-duration-value="25">
        <div class="pomodoro__controls">
          <div class="pomodoro__durations">
            <button type="button" class="pomodoro__duration-btn" data-action="click->pomodoro#setDuration" data-pomodoro-minutes-param="15">15 min</button>
            <button type="button" class="pomodoro__duration-btn pomodoro__duration-btn--active" data-action="click->pomodoro#setDuration" data-pomodoro-minutes-param="25">25 min</button>
            <button type="button" class="pomodoro__duration-btn" data-action="click->pomodoro#setDuration" data-pomodoro-minutes-param="45">45 min</button>
          </div>
          <div class="pomodoro__timer-row">
            <span class="pomodoro__display" data-pomodoro-target="display">25:00</span>
            <button type="button" class="pomodoro__play-btn" data-action="click->pomodoro#toggle" data-pomodoro-target="playBtn" aria-label="Play">▶</button>
            <button type="button" class="pomodoro__pause-btn" data-action="click->pomodoro#toggle" data-pomodoro-target="pauseBtn" aria-label="Pause" style="display:none;">⏸</button>
          </div>
        </div>
        <%= link_to "Exit Today mode", app_root_path(days: session[:dashboard_days_last_multi] || 7), class: "focus-mode__exit", data: { turbo_action: "replace" } %>
      </div>
      <dialog id="pomodoro-done-modal" class="pomodoro-done-modal" onclick="if(event.target===this)this.close()">
        <div class="pomodoro-done-modal__content" onclick="event.stopPropagation()">
          <h2 class="pomodoro-done-modal__title">Well done!</h2>
          <p class="pomodoro-done-modal__text">You completed a focus session. Take a short break.</p>
          <button type="button" class="pomodoro-done-modal__btn" onclick="document.getElementById('pomodoro-done-modal').close()">OK</button>
        </div>
      </dialog>
    </div>
  <% end %>

  <% unless focus_mode %>
    <% if lists_placement == "bottom" %>
      <%= render "dashboard/bottom_lists" %>
    <% end %>
  <% end %>

  <% if lists_placement == "right" %>
  <%# ── Right-hand "Not Yet" panel — slides from right, with tabs ── %>
  <div data-controller="not-yet-panel"
     data-not-yet-panel-settings-path-value="<%= settings_path %>"
     data-not-yet-panel-app-root-path-value="<%= app_root_path %>"
     data-not-yet-panel-open-on-load-value="<%= params[:panel] == 'open' %>"
     data-action="keydown@document->not-yet-panel#closeOnEscape keydown@document->not-yet-panel#handlePanelKeydown click@document->not-yet-panel#closeOnOverlay open-not-yet-panel@window->not-yet-panel#open toggle-not-yet-panel@window->not-yet-panel#toggle">
    <button type="button"
            data-action="click->not-yet-panel#toggle"
            class="not-yet-panel__trigger"
            title="Not Yet"
            aria-label="Open Not Yet list">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="not-yet-panel__chevron"><polyline points="6 18 12 12 6 6"/><polyline points="12 18 18 12 12 6"/></svg>
    </button>
    <div data-not-yet-panel-target="overlay" class="not-yet-panel__overlay" style="display:none;"></div>
    <div data-not-yet-panel-target="panel" class="not-yet-panel">
      <div class="not-yet-panel__header">
        <div class="not-yet-panel__tabs-row">
          <% if @pages.any? %>
            <% if @pages.size >= 2 %>
              <button type="button" class="not-yet-panel__tab-arrow" data-action="click->not-yet-panel#prevTab" aria-label="Previous tab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
            <% end %>
            <div class="not-yet-panel__tabs-wrap<%= ' not-yet-panel__tabs-wrap--scrollable' if @pages.size >= 3 %>">
              <% @pages.each_with_index do |page, idx| %>
                <button type="button"
                        class="not-yet-panel__tab<%= ' not-yet-panel__tab--active' if idx == 0 %>"
                        data-not-yet-panel-target="tab"
                        data-page-id="<%= page.id %>"
                        data-action="click->not-yet-panel#switchTab">
                  <span class="not-yet-panel__tab-label"
                        contenteditable="true"
                        spellcheck="false"
                        data-page-id="<%= page.id %>"
                        data-initial-name="<%= h(page.name) %>"
                        data-action="blur->not-yet-panel#saveTabName keydown->not-yet-panel#tabNameKeydown"
                        title="Click to edit"><%= h(page.name) %></span>
                  <span class="not-yet-panel__tab-actions">
                    <button type="button" class="not-yet-panel__tab-action" data-action="click->not-yet-panel#deleteTab" data-page-id="<%= page.id %>" title="Delete list" aria-label="Delete <%= page.name %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </span>
                </button>
              <% end %>
            </div>
            <button type="button" class="not-yet-panel__tab-plus" data-action="click->not-yet-panel#createTab" aria-label="Add new list">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <% if @pages.size >= 2 %>
              <button type="button" class="not-yet-panel__tab-arrow" data-action="click->not-yet-panel#nextTab" aria-label="Next tab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            <% end %>
          <% else %>
            <div class="not-yet-panel__tabs-wrap">
              <span class="not-yet-panel__tab-label" style="pointer-events:none; color:#888;"><%= h((current_user.respond_to?(:not_yet_panel_title) && current_user.not_yet_panel_title.presence) || 'Not Yet') %></span>
            </div>
            <button type="button" class="not-yet-panel__tab-plus" data-action="click->not-yet-panel#createTab" aria-label="Add new list">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          <% end %>
        </div>
        <button type="button" data-action="click->not-yet-panel#close" class="not-yet-panel__close" aria-label="Close">&times;</button>
      </div>
      <div class="not-yet-panel__body">
        <% if @pages.any? %>
          <% @pages.each_with_index do |page, idx| %>
            <div class="not-yet-panel__tab-pane<%= ' not-yet-panel__tab-pane--active' if idx == 0 %>"
                 data-not-yet-panel-target="tabPane"
                 data-page-id="<%= page.id %>">
              <div class="not-yet-panel__list">
                <div class="not-yet-panel__items" data-controller="drag" data-drag-page-id="<%= page.id %>" id="todos_page_<%= page.id %>">
                  <% page.todos.ordered.each do |todo| %>
                    <% if todo.is_visual_break? %>
                      <%= render "todos/visual_break", todo: todo %>
                    <% else %>
                      <%= render "todos/todo", todo: todo %>
                    <% end %>
                  <% end %>
                </div>
                <div class="not-yet-panel__add" id="todo-page-add-<%= page.id %>">
                  <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form", html: { id: "todo-form-page-#{page.id}" }, data: { controller: "todo-form", action: "keydown->todo-form#onKeydown submit->todo-form#onSubmit" } do |form| %>
                    <%= form.hidden_field :page_id, value: page.id %>
                    <%= form.text_field :title, class: "todo-input", autocomplete: "off", placeholder: "Add task.." %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="not-yet-panel__empty">
            <p>No Not Yet items yet.</p>
            <div class="not-yet-panel__add" id="not-yet-panel-add-empty">
              <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form", html: { id: "todo-form-not-yet-empty" }, data: { controller: "todo-form", action: "keydown->todo-form#onKeydown submit->todo-form#onSubmit" } do |form| %>
                <%= form.text_field :title, class: "todo-input", autocomplete: "off", placeholder: "Add task.." %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

  <%# ── Calendar Picker Modal (inside dashboard for Stimulus target scope) ── %>
  <dialog id="calendar-picker-modal"
          class="calendar-modal"
          data-date-picker-target="modal"
          onclick="if(event.target===this)this.close()">
    <div class="calendar-modal__content" onclick="event.stopPropagation()">
      <div class="calendar-modal__header">
        <h3 class="calendar-modal__title">Pick a date</h3>
        <form method="dialog">
          <button type="submit" class="calendar-modal__close" aria-label="Close">&times;</button>
        </form>
      </div>
      <%= link_to "Today", app_root_path, class: "calendar-modal__today-link", data: { turbo_frame: "_top" } %>
      <div class="calendar-modal__month-nav">
        <button type="button" class="calendar-modal__month-btn" data-action="click->date-picker#monthPrev" aria-label="Previous month">&lsaquo;</button>
        <span class="calendar-modal__month-label" data-date-picker-target="monthLabel">March 2026</span>
        <button type="button" class="calendar-modal__month-btn" data-action="click->date-picker#monthNext" aria-label="Next month">&rsaquo;</button>
      </div>
      <div class="calendar-modal__grid" data-date-picker-target="grid" role="grid">
        <%# Grid content is injected by Stimulus %>
      </div>
      <div class="calendar-modal__footer">
        <form method="dialog">
          <button type="submit" class="calendar-modal__cancel">Cancel</button>
        </form>
      </div>
    </div>
  </dialog>
</div>
<dialog id="new-list-dialog" class="app-dialog app-dialog--wide">
  <div class="app-dialog__header">
    <h3 class="app-dialog__title">Create New List</h3>
    <form method="dialog">
      <button type="submit" class="app-dialog__close" aria-label="Close">&times;</button>
    </form>
  </div>

  <%# Standard form submit (data-turbo=false) — full page load ensures new tab appears %>
  <%= form_with model: Page.new, url: pages_path, local: true, html: { "data-turbo": "false" }, class: "space-y-4" do |form| %>
    <div>
      <%= form.text_field :name, class: "app-dialog__input", placeholder: "What's this list about?", required: true, autofocus: true %>
    </div>

    <div class="app-dialog__actions">
      <button type="button" onclick="document.getElementById('new-list-dialog').close()" class="app-dialog__btn app-dialog__btn--secondary">Cancel</button>
      <%= form.submit "Create", class: "app-dialog__btn app-dialog__btn--primary" %>
    </div>
  <% end %>
</dialog>

<%# ── Rename App Title Modal ── %>
<dialog id="app-title-dialog" class="app-dialog">
  <div class="app-dialog__header">
    <h3 class="app-dialog__title">Rename Your App</h3>
    <form method="dialog">
      <button type="submit" class="app-dialog__close" aria-label="Close">&times;</button>
    </form>
  </div>

  <p class="app-dialog__hint">
    Give your app a custom name. This only changes the display title.
  </p>

  <form id="app-title-form" style="display: flex; flex-direction: column; gap: 16px;">
    <input type="text"
           id="app-title-input"
           class="app-dialog__input"
           value="<%= current_user.app_title %>"
           maxlength="30"
           required
           autofocus>

    <div class="app-dialog__actions app-dialog__actions--split">
      <span id="app-title-char-count" class="app-dialog__count"><%= current_user.app_title.length %>/30</span>
      <div style="display: flex; gap: 12px;">
        <button type="button" onclick="document.getElementById('app-title-dialog').close()" class="app-dialog__btn app-dialog__btn--secondary">Cancel</button>
        <button type="submit" id="app-title-save-btn" class="app-dialog__btn app-dialog__btn--primary">Save</button>
      </div>
    </div>
  </form>
</dialog>

<%# ── App Title Rename Script ── %>
<script>
  (function() {
    // Wait for DOM to be ready, then wire up the rename form
    function setupAppTitleRename() {
      var form    = document.getElementById('app-title-form');
      var input   = document.getElementById('app-title-input');
      var counter = document.getElementById('app-title-char-count');
      var display = document.getElementById('app-title-display');
      var dialog  = document.getElementById('app-title-dialog');
      var saveBtn = document.getElementById('app-title-save-btn');

      if (!form || !input) return;

      // Live character counter
      input.addEventListener('input', function() {
        counter.textContent = input.value.length + '/30';
      });

      // Reset input value each time the dialog opens
      dialog.addEventListener('close', function() {
        // Nothing needed — we update the input on successful save
      });

      // Submit handler — PATCH to settings endpoint via fetch
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        var newTitle = input.value.trim();
        if (newTitle.length === 0 || newTitle.length > 30) return;

        // Disable button while saving
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';

        var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        fetch('<%= settings_path %>', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            'Accept': 'application/json'
          },
          body: JSON.stringify({ user: { app_title: newTitle } })
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.status === 'success') {
            // Update the visible title on the page without a reload
            var titleSpan = display.childNodes[0];
            titleSpan.textContent = newTitle + ' ';
            dialog.close();
          } else {
            alert('Could not save: ' + (data.errors || []).join(', '));
          }
        })
        .catch(function() {
          alert('Something went wrong. Please try again.');
        })
        .finally(function() {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        });
      });
    }

    // Bind on initial load and after Turbo navigation
    document.addEventListener('DOMContentLoaded', setupAppTitleRename);
    document.addEventListener('turbo:load', setupAppTitleRename);
  })();
</script>

