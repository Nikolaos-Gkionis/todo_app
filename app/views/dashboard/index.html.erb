<div class="dashboard container px-4 py-8 max-w-7xl mx-auto">
  <div class="mb-8 flex justify-between items-center">
    <h1 class="text-3xl font-bold tracking-tight">Weekly Planner</h1>
    <div>
      <%= link_to "+ New List", new_page_path, class: "btn btn--primary bg-black text-white px-4 py-2 rounded-md hover:bg-gray-800 transition-colors" %>
    </div>
  </div>

  <div class="dashboard__week-view mb-16">
    <div class="calendar-scroll-container grid grid-cols-1 md:grid-cols-7 gap-4">
      <% @week_dates.each do |date| %>
        <%
          is_today = date == Time.current.to_date
          day_todos = (@todos_by_date[date] || []).sort_by { |t| [t.completed? ? 1 : 0, t.position] }
        %>
        <div class="week-view__column flex flex-col bg-gray-50/40 rounded-xl p-3 border <%= is_today ? 'border-black ring-1 ring-black shadow-sm bg-white' : 'border-gray-200' %>">
          <div class="column__header mb-4 px-1 flex justify-between items-baseline border-b border-gray-200 pb-2">
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wider"><%= date.strftime('%a') %></span>
            <span class="text-xl font-bold <%= is_today ? 'text-black' : 'text-gray-900' %>"><%= date.strftime('%d') %></span>
          </div>
          
          <div class="column__items flex-grow min-h-[60px]" 
               data-controller="drag" 
               data-drag-date="<%= date %>"
               id="todos_date_<%= date %>">
            <% day_todos.each do |todo| %>
              <%= render "todos/todo", todo: todo %>
            <% end %>
          </div>

          <div class="column__footer mt-3">
            <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form" do |form| %>
              <%= form.hidden_field :due_date, value: date %>
              <%= form.text_field :title, class: "w-full text-sm py-2 px-3 border border-gray-200 rounded shadow-sm focus:ring-1 focus:ring-black focus:border-black transition-shadow", placeholder: "Add task..." %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="dashboard__custom-lists mb-8">
    <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b border-black pb-2 inline-block">Custom Lists</h2>
    <div class="calendar-scroll-container grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% @pages.each do |page| %>
        <div class="custom-lists__list flex flex-col bg-white rounded-xl p-4 border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
          <div class="list__header mb-4 flex justify-between items-center border-b border-gray-100 pb-2">
            <%= link_to page.name, page_path(page), class: "font-semibold text-gray-800 hover:text-black truncate flex-grow" %>
            <div class="relative group ml-2 flex-shrink-0">
              <span class="w-3 h-3 rounded-full inline-block" style="background-color: <%= page.cover_color.presence || '#000' %>"></span>
            </div>
          </div>

          <div class="list__items flex-grow min-h-[60px]"
               data-controller="drag"
               data-drag-page-id="<%= page.id %>"
               id="todos_page_<%= page.id %>">
            <% page.todos.ordered.each do |todo| %>
              <%= render "todos/todo", todo: todo %>
            <% end %>
          </div>

          <div class="list__footer mt-3">
            <%= form_with model: Todo.new, url: todos_path, local: false, class: "todo-form" do |form| %>
              <%= form.hidden_field :page_id, value: page.id %>
              <%= form.text_field :title, class: "w-full text-sm py-2 px-3 border border-gray-200 rounded bg-gray-50 focus:bg-white focus:ring-1 focus:ring-black focus:border-black transition-all", placeholder: "Add to #{page.name}..." %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
