<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <%= link_to "← Back to app", app_root_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold">This hosted week</h1>
    <p class="text-gray-600 mt-2">
      <% if current_user.hosted_ephemeral? && current_user.on_trial? %>
        <%= pluralize(current_user.trial_days_remaining, "day") %> left on this server. Then I delete the account.
      <% elsif current_user.hosted_ephemeral? && current_user.trial_expired? %>
        This hosted week is over. Export if you still can, then run it from source.
      <% else %>
        This instance does not expire. It is yours.
      <% end %>
    </p>
  </div>

  <div class="max-w-xl space-y-4">
    <%= link_to "Export data", export_trial_data_path, class: "action-card__button action-card__button--primary" %>
    <%= link_to "Source on GitHub", github_source_url, class: "action-card__button action-card__button--secondary", target: "_blank", rel: "noopener" %>
  </div>
</div>
