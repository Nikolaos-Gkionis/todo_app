<div class="marketing-page" data-controller="scroll-reveal">
<%= render 'shared/navbar' %>

<section class="mkt-hero mkt-hero--auth">
  <div class="mkt-inner" style="text-align: center;">
    <span class="mkt-hero__eyebrow" style="margin-bottom: 1.25rem; display: inline-flex;">
      <span class="mkt-hero__eyebrow-dot"></span>
      Welcome back
    </span>
    <h1 class="mkt-hero__title" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
      Sign in to your account
    </h1>
    <p class="mkt-hero__subtitle" style="margin: 0 auto;">
      Same email and password you used to start your trial.
    </p>
  </div>
</section>

<section class="mkt-section bg-white" style="padding-top: 0;">
  <div class="mkt-inner">
    <div class="mkt-auth-card mkt-reveal" data-scroll-reveal-target="item">
      <% if flash[:alert] %>
        <div class="mkt-auth-errors" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: login_path, local: true, data: { turbo: false }, class: "mkt-auth-form" do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "mkt-auth-label" %>
          <%= form.email_field :email_address,
                placeholder: "you@example.com",
                required: true,
                autocomplete: "email",
                class: "form-input mkt-auth-input" %>
        </div>
        <div>
          <%= form.label :password, "Password", class: "mkt-auth-label" %>
          <%= form.password_field :password,
                placeholder: "Password",
                required: true,
                autocomplete: "current-password",
                class: "form-input mkt-auth-input" %>
        </div>

        <label class="mkt-auth-check">
          <%= form.check_box :remember_me, { class: "mkt-auth-check__input" }, "1", "0" %>
          <span>Keep me signed in</span>
        </label>

        <p class="mkt-auth-hint">
          Tick this if you install the app on your phone. You’ll stay signed in on that device.
        </p>

        <%= form.submit "Sign in", class: "mkt-btn mkt-btn--primary mkt-auth-submit" %>
      <% end %>

      <p class="mkt-auth-alt">
        Don’t have an account?
        <%= link_to "Start a free trial", signup_path %>
      </p>
    </div>
  </div>
</section>

<%= render 'shared/footer' %>
</div>
