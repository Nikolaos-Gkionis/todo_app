<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Peponi.to!</title>
    <style>
      /* Reset styles for email clients */
      body, table, td, p, a, li, blockquote {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }
      
      /* Import handwritten font */
      @import url('https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&display=swap');
      
      /* Main styles */
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        min-width: 100%;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        line-height: 1.6;
        color: #1f2937;
        font-size: 1.1rem;
      }
      
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(229, 231, 235, 0.3);
      }
      
      .header {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
        position: relative;
      }
      
      .header h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.5px;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .header p {
        margin: 10px 0 0 0;
        font-size: 1.25rem;
        opacity: 0.9;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .content {
        padding: 40px 30px;
      }
      
      .greeting {
        font-size: 1.25rem;
        margin-bottom: 20px;
        color: #1f2937;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        font-weight: 600;
      }
      
      .message {
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 30px;
        color: #4b5563;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .download-section {
        background-color: #f9fafb;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        margin: 30px 0;
        border: 2px dashed #d1d5db;
      }
      
      .download-button {
        display: inline-block;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: white;
        text-decoration: none;
        padding: 16px 32px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.125rem;
        margin: 20px 0;
        transition: all 0.2s ease;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      
      .download-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(37, 99, 235, 0.3);
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
      }
      
      .features {
        margin: 40px 0;
      }
      
      .feature {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding: 15px;
        background-color: #f9fafb;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
      }
      
      .feature-icon {
        font-size: 1.5rem;
        margin-right: 15px;
        width: 40px;
        text-align: center;
      }
      
      .feature-text {
        flex: 1;
      }
      
      .feature-title {
        font-weight: 600;
        margin-bottom: 5px;
        color: #1f2937;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        font-size: 1.1rem;
      }
      
      .feature-description {
        color: #4b5563;
        font-size: 1rem;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .footer {
        background-color: #f9fafb;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }
      
      .footer p {
        margin: 0 0 10px 0;
        color: #4b5563;
        font-size: 1rem;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .footer a {
        color: #2563eb;
        text-decoration: none;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      .footer a:hover {
        text-decoration: underline;
        color: #1d4ed8;
      }
      
      .support-info {
        background-color: #eff6ff;
        border-left: 4px solid #2563eb;
        padding: 20px;
        margin: 30px 0;
        border-radius: 0 12px 12px 0;
      }
      
      .support-info h3 {
        margin: 0 0 10px 0;
        color: #1d4ed8;
        font-size: 1.1rem;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        font-weight: 600;
      }
      
      .support-info p {
        margin: 0;
        color: #4b5563;
        font-size: 1rem;
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
      }
      
      /* Mobile responsiveness */
      @media only screen and (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }
        
        .header, .content, .footer {
          padding: 20px;
        }
        
        .header h1 {
          font-size: 28px;
        }
        
        .download-button {
          display: block;
          margin: 20px 0;
        }
        
        .feature {
          flex-direction: column;
          text-align: center;
        }
        
        .feature-icon {
          margin-right: 0;
          margin-bottom: 10px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="header">
        <h1>🎉 Welcome to <%= @app_name %>!</h1>
        <p>Your download is ready</p>
      </div>
      
      <!-- Main Content -->
      <div class="content">
        <div class="greeting">
          Hi <%= @user.display_name %>,
        </div>
        
        <div class="message">
          <p>Thanks for buying <%= @app_name %>. Your download is ready. After you install it, you can work offline. No monthly fee.</p>
        </div>
        
        <!-- Download Section -->
        <div class="download-section">
          <h2 style="margin: 0 0 15px 0; color: #333333;">📱 Download Your App</h2>
          <p style="margin: 0 0 20px 0; color: #666666;">Click the button below to download Peponi.to to your device:</p>
          <a href="<%= @download_url %>" class="download-button">Download Peponi.to</a>
          <p style="margin: 15px 0 0 0; font-size: 14px; color: #666666;">
            This link is secure and personalized for your account.
          </p>
        </div>
        
        <!-- Features Section -->
        <div class="features">
          <h2 style="margin: 0 0 20px 0; color: #333333;">What you get with your download:</h2>
          
          <div class="feature">
            <div class="feature-icon">📱</div>
            <div class="feature-text">
              <div class="feature-title">Offline Access</div>
              <div class="feature-description">Use your app anywhere, even without internet connection</div>
            </div>
          </div>
          
          <div class="feature">
            <div class="feature-icon">🎨</div>
            <div class="feature-text">
              <div class="feature-title">All Themes Included</div>
              <div class="feature-description">5 themes, 4 fonts, 8 accent colours. 160 combinations. Today, or 2 through 7 days. Rename the app if you like.</div>
            </div>
          </div>
          
          <div class="feature">
            <div class="feature-icon">💾</div>
            <div class="feature-text">
              <div class="feature-title">Your data, your device</div>
              <div class="feature-description">Export anytime. Delete anytime. Install on up to three devices you own.</div>
            </div>
          </div>
          
          <div class="feature">
            <div class="feature-icon">⚡</div>
            <div class="feature-text">
              <div class="feature-title">Opens from the home screen</div>
              <div class="feature-description">Install as a PWA. Full screen, works offline after install.</div>
            </div>
          </div>
        </div>
        
        <!-- PWA Install Guide (post-payment URL, no marketing mix) -->
        <div class="support-info">
          <h3>📱 How to install on your device</h3>
          <p>A short guide to install Peponi.to as a PWA: no app store, full screen, from your home screen or dock.</p>
          <p style="margin-top: 12px;"><a href="<%= @install_guide_url %>" class="download-button" style="display: inline-block; margin: 0;">View PWA install guide</a></p>
        </div>

        <!-- Support Section -->
        <div class="support-info">
          <h3>Need Help?</h3>
          <p>If you need a hand with the download, write to <a href="https://peponi.to/contact">support@peponi.to</a>.</p>
        </div>
        
        <div class="message">
          <p>Thanks for buying <%= @app_name %>.</p>
          
          <p>Nikolaos<br>
          <%= @app_name %></p>
        </div>
      </div>
      
      <!-- Footer -->
      <div class="footer">
        <p><strong><%= @app_name %></strong> · Tasks organised by day</p>
        <p>This email was sent to <%= @user.email_address %> because you purchased our app.</p>
        <p>
          <a href="https://peponi.to/contact">Contact Support</a> | 
          <a href="https://peponi.to">Visit Website</a>
        </p>
      </div>
    </div>
  </body>
</html>
