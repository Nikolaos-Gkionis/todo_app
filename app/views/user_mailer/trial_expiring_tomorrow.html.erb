<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trial Expires Tomorrow - Todo-it</title>
    <style>
      /* Reset styles for email clients */
      body, table, td, p, a, li, blockquote {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }
      
      /* Import handwritten font */
      @import url('https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&display=swap');
      
      /* Main styles */
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        min-width: 100%;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        font-family: 'Gloria Hallelujah', 'Comic Sans MS', 'Marker Felt', 'Trebuchet MS', cursive, sans-serif;
        line-height: 1.6;
        color: #1f2937;
        font-size: 1.1rem;
      }
      
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(229, 231, 235, 0.3);
      }
      
      .header {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
        position: relative;
      }
      
      .header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      
      .header p {
        margin: 10px 0 0 0;
        font-size: 18px;
        opacity: 0.9;
      }
      
      .content {
        padding: 40px 30px;
      }
      
      .greeting {
        font-size: 18px;
        margin-bottom: 20px;
        color: #333333;
      }
      
      .message {
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 30px;
        color: #555555;
      }
      
      .urgent-warning {
        background: linear-gradient(135deg, #ffcdd2 0%, #f44336 100%);
        border: 3px solid #d32f2f;
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        margin: 30px 0;
        animation: pulse 2s infinite;
      }
      
      .urgent-warning h2 {
        margin: 0 0 15px 0;
        color: #b71c1c;
        font-size: 28px;
        font-weight: 800;
      }
      
      .urgent-warning p {
        margin: 0;
        color: #b71c1c;
        font-size: 18px;
        font-weight: 600;
      }
      
      .trial-details {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 30px 0;
        border-left: 4px solid #f44336;
      }
      
      .trial-details h3 {
        margin: 0 0 15px 0;
        color: #333333;
        font-size: 16px;
      }
      
      .trial-details p {
        margin: 0 0 10px 0;
        color: #666666;
        font-size: 14px;
      }
      
      .download-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        margin: 30px 0;
        color: white;
      }
      
      .download-section h2 {
        margin: 0 0 15px 0;
        font-size: 24px;
      }
      
      .download-button {
        display: inline-block;
        background-color: white;
        color: #667eea;
        text-decoration: none;
        padding: 20px 40px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 20px;
        margin: 20px 0;
        transition: transform 0.2s ease;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      }
      
      .download-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(255, 255, 255, 0.3);
      }
      
      .benefits {
        margin: 40px 0;
      }
      
      .benefit {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
      }
      
      .benefit-icon {
        font-size: 24px;
        margin-right: 15px;
        width: 40px;
        text-align: center;
      }
      
      .benefit-text {
        flex: 1;
      }
      
      .benefit-title {
        font-weight: 600;
        margin-bottom: 5px;
        color: #333333;
      }
      
      .benefit-description {
        color: #666666;
        font-size: 14px;
      }
      
      .footer {
        background-color: #f8f9fa;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #e9ecef;
      }
      
      .footer p {
        margin: 0 0 10px 0;
        color: #666666;
        font-size: 14px;
      }
      
      .footer a {
        color: #f44336;
        text-decoration: none;
      }
      
      .footer a:hover {
        text-decoration: underline;
      }
      
      .support-info {
        background-color: #e3f2fd;
        border-left: 4px solid #2196f3;
        padding: 20px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
      }
      
      .support-info h3 {
        margin: 0 0 10px 0;
        color: #1976d2;
        font-size: 16px;
      }
      
      .support-info p {
        margin: 0;
        color: #555555;
        font-size: 14px;
      }
      
      /* Mobile responsiveness */
      @media only screen and (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }
        
        .header, .content, .footer {
          padding: 20px;
        }
        
        .header h1 {
          font-size: 28px;
        }
        
        .download-button {
          display: block;
          margin: 20px 0;
          padding: 16px 32px;
          font-size: 18px;
        }
        
        .benefit {
          flex-direction: column;
          text-align: center;
        }
        
        .benefit-icon {
          margin-right: 0;
          margin-bottom: 10px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="header">
        <h1>🚨 Trial Expires Tomorrow!</h1>
        <p>Last chance to download your app</p>
      </div>
      
      <!-- Main Content -->
      <div class="content">
        <div class="greeting">
          Hi <%= @user.display_name %>,
        </div>
        
        <div class="message">
          <p>This is your final reminder - your <%= @app_name %> trial expires tomorrow! Don't lose access to your organized life.</p>
        </div>
        
        <!-- Urgent Warning -->
        <div class="urgent-warning">
          <h2>🚨 FINAL NOTICE</h2>
          <p>Your trial expires tomorrow on <%= @trial_expires_at %></p>
        </div>
        
        <!-- Trial Details -->
        <div class="trial-details">
          <h3>What happens tomorrow:</h3>
          <p>• You'll lose access to all your todos and pages</p>
          <p>• Your data will be safely stored for 7 days</p>
          <p>• You can still download the app today</p>
          <p>• No automatic charges - you're in complete control</p>
        </div>
        
        <!-- Download Section -->
        <div class="download-section">
          <h2>📱 Download Your App NOW</h2>
          <p style="margin: 0 0 20px 0; opacity: 0.9;">This is your last chance to get the full app experience!</p>
          <a href="<%= @download_url %>" class="download-button">Download <%= @app_name %> NOW</a>
          <p style="margin: 15px 0 0 0; font-size: 14px; opacity: 0.8;">
            One-time purchase • No subscriptions • Your data, your device
          </p>
        </div>
        
        <!-- Benefits Section -->
        <div class="benefits">
          <h2 style="margin: 0 0 20px 0; color: #333333;">Why download the app?</h2>
          
          <div class="benefit">
            <div class="benefit-icon">📱</div>
            <div class="benefit-text">
              <div class="benefit-title">Offline Access</div>
              <div class="benefit-description">Use your app anywhere, even without internet connection</div>
            </div>
          </div>
          
          <div class="benefit">
            <div class="benefit-icon">💾</div>
            <div class="benefit-text">
              <div class="benefit-title">Data Ownership</div>
              <div class="benefit-description">Your data stays on your device - complete privacy and control</div>
            </div>
          </div>
          
          <div class="benefit">
            <div class="benefit-icon">⚡</div>
            <div class="benefit-text">
              <div class="benefit-title">Lightning Fast</div>
              <div class="benefit-description">Native app performance with instant loading and smooth animations</div>
            </div>
          </div>
          
          <div class="benefit">
            <div class="benefit-icon">🎨</div>
            <div class="benefit-text">
              <div class="benefit-title">All Themes Included</div>
              <div class="benefit-description">5 themes, 4 fonts, 8 accent colours — 160 combinations. F, 2, 4, 7-day views.</div>
            </div>
          </div>
        </div>
        
        <!-- Support Section -->
        <div class="support-info">
          <h3>Need Help Right Now?</h3>
          <p>If you have any questions or need immediate assistance with the download process, please contact us at <a href="https://todo-it.app/contact">support@todo-it.app</a>. We're here to help!</p>
        </div>
        
        <div class="message">
          <p><strong>Don't wait - download your app today to keep your productivity journey going!</strong></p>
          
          <p>Best regards,<br>
          The <%= @app_name %> Team</p>
        </div>
      </div>
      
      <!-- Footer -->
      <div class="footer">
        <p><strong><%= @app_name %></strong> - Your personal productivity companion</p>
        <p>This final trial reminder was sent to <%= @user.email_address %>.</p>
        <p>
          <a href="https://todo-it.app/contact">Contact Support</a> | 
          <a href="https://todo-it.app">Visit Website</a>
        </p>
      </div>
    </div>
  </body>
</html>
