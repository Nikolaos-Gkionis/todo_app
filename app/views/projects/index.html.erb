<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">My Projects</h1>
    <%= link_to "New Project", new_project_path, class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline-blue" %>
  </div>
  
  <% if @projects.any? %>
    <div class="space-y-4">
      <% @projects.each do |project| %>
        <div class="notebook-card">
          <div class="flex justify-between items-start">
            <div class="flex-grow">
              <div class="flex items-center space-x-3 mb-1">
                <h2 class="text-xl font-semibold">
                  <%= link_to project.name, project_path(project), class: "text-blue-600 hover:text-blue-800" %>
                </h2>
                <% if project.total_todos_count > 0 %>
                  <div class="flex items-center space-x-2">
                    <span class="text-sm font-medium text-gray-700 bg-gray-100 px-2 py-1 rounded-full">
                      <%= project.progress_text %>
                    </span>
                    <% if project.completion_percentage > 0 %>
                      <div class="w-12 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                        <div class="h-full bg-green-500 transition-all duration-300" 
                             style="width: <%= project.completion_percentage %>%"></div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs text-gray-400 italic">No todos yet</span>
                <% end %>
              </div>
              <% if project.description.present? %>
                <p class="text-gray-600 mt-2"><%= project.description %></p>
              <% end %>
            </div>
            <div class="flex space-x-2 ml-4">
              <%= link_to "Edit", edit_project_path(project), 
                    class: "text-green-600 hover:text-green-800 text-sm font-medium hand-underline hand-underline-green" %>
              <%= link_to "Delete", project, 
                    data: { 
                      "turbo-method": :delete,
                      confirm: "Are you sure? This will delete the project and all its todos!" 
                    },
                    class: "text-red-600 hover:text-red-800 text-sm font-medium hand-underline hand-underline-red" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No projects yet. Create your first project!</p>
  <% end %>
</div>