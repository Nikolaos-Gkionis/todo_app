<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">My Projects</h1>
  
  <div class="mb-6">
    <%= link_to "New Project", new_project_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
  </div>
  
  <% if @projects.any? %>
    <div class="space-y-4">
      <% @projects.each do |project| %>
        <div class="notebook-card p-6 rounded-lg">
          <div class="flex justify-between items-start">
            <div class="flex-grow">
              <h2 class="text-xl font-semibold">
                <%= link_to project.name, project_path(project), class: "text-blue-600 hover:text-blue-800" %>
              </h2>
              <% if project.description.present? %>
                <p class="text-gray-600 mt-2"><%= project.description %></p>
              <% end %>
            </div>
            <div class="flex space-x-2 ml-4">
              <%= link_to "Edit", edit_project_path(project), 
                    class: "text-green-600 hover:text-green-800 text-sm font-medium" %>
              <%= link_to "Delete", project, 
                    data: { 
                      "turbo-method": :delete,
                      confirm: "Are you sure? This will delete the project and all its todos!" 
                    },
                    class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No projects yet. Create your first project!</p>
  <% end %>
</div>