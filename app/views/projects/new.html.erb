<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Create New Project</h1>
  
  <%= form_with model: @project, local: true, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium mb-1" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>
    
    <div>
      <%= form.label :description, class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :description, class: "w-full px-3 py-2 border border-gray-300 rounded-md", rows: 3 %>
    </div>
    
    <div>
      <%= form.submit "Create Project", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      <%= link_to "Cancel", projects_path, class: "ml-2 text-gray-600 hover:text-gray-800" %>
    </div>
  <% end %>
</div>