<div class="container mx-auto px-4 py-8">
  <!-- Project Header -->
  <div class="mb-8">
    <%= link_to "← Back to Projects", projects_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <div class="flex justify-between items-start">
      <div>
        <div class="flex items-center space-x-4 mb-2">
          <h1 class="text-3xl font-bold"><%= @project.name %></h1>
          <% if @project.total_todos_count > 0 %>
            <div class="flex items-center space-x-3">
              <span class="text-lg font-medium text-gray-700 bg-gray-100 px-3 py-1 rounded-full">
                <%= @project.progress_text %>
              </span>
              <% if @project.completion_percentage > 0 %>
                <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full bg-green-500 transition-all duration-300" 
                       style="width: <%= @project.completion_percentage %>%"></div>
                </div>
                <span class="text-sm text-gray-600"><%= @project.completion_percentage %>%</span>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if @project.description.present? %>
        <p class="text-gray-600 mt-2"><%= @project.description %></p>
        <% end %>
      </div>
      <div class="flex space-x-3">
        <%= link_to "Edit Project", edit_project_path(@project), 
              class: "text-green-600 hover:text-green-800 font-medium hand-underline hand-underline-green text-sm" %>
        <%= link_to "Delete Project", @project, 
              data: { 
                "turbo-method": :delete,
                confirm: "Are you sure? This will delete the project and all its todos!" 
              },
              class: "text-red-600 hover:text-red-800 font-medium hand-underline hand-underline-red text-sm" %>
      </div>
    </div>
  </div>


  <!-- Todos List -->
  <div class="notebook-card">
    <h2 class="text-xl font-semibold mb-4">Todos (<%= @todos.count %>)</h2>

    <% if @todos.any? %>
    <div class="space-y-3">
      <% @todos.each do |todo| %>

      <div class="todo-item flex items-start p-3">
        <%= form_with model: [@project, todo], method: :patch, local: true, class: "flex items-center mr-3" do |form| %>
        <div class="hand-checkbox <%= todo.completed? ? 'hand-checkbox-checked' : 'hand-checkbox-unchecked' %>" 
             onclick="this.closest('form').submit()">
        </div>
        <%= form.hidden_field :completed, value: !todo.completed %>
        <% end %>

        <div class="flex-1">
          <h4 class="font-medium <%= 'line-through text-gray-500' if todo.completed %>">
            <%= todo.title %>
          </h4>
          <% if todo.notes.present? %>
          <p class="text-sm text-gray-600 mt-1 <%= 'line-through' if todo.completed %>"><%= todo.notes %></p>
          <% end %>
        </div>
        
        <!-- Edit/Delete buttons for todos -->
        <div class="flex space-x-2 ml-3">
          <%= link_to "Edit", edit_project_todo_path(@project, todo), 
                class: "text-green-600 hover:text-green-800 text-sm font-medium border-b border-green-600 hover:border-green-800" %>
          <%= link_to "Delete", project_todo_path(@project, todo), 
                data: { 
                  "turbo-method": :delete,
                  confirm: "Are you sure you want to delete this todo?" 
                },
                class: "text-red-600 hover:text-red-800 text-sm font-medium border-b border-red-600 hover:border-red-800" %>
        </div>
      </div>
      <% end %>
    </div>
    <% end %>
    
    <!-- Collapsible Add Todo Form -->
    <div class="mt-6">
      <!-- Collapsed state - click to expand -->
      <div id="add-todo-trigger" class="add-todo-collapsed" onclick="toggleAddTodo()">
        <p class="text-gray-600">✏️ Add a new todo...</p>
      </div>
      
      <!-- Expanded form - hidden by default -->
      <div id="add-todo-form" class="add-todo-expanded hidden">
        <h3 class="text-lg font-semibold mb-4">Add New Todo</h3>
        <%= form_with model: [@project, @new_todo], local: true, class: "space-y-4" do |form| %>
          <div>
            <%= form.text_field :title, class: "w-full", placeholder: "What needs to be done?" %>
          </div>

          <div>
            <%= form.text_area :notes, class: "w-full", placeholder: "Additional notes (optional)", rows: 2 %>
          </div>

          <div class="flex space-x-3">
            <%= form.submit "Add Todo", class: "text-blue-600 hover:text-blue-800 font-medium hand-underline hand-underline-blue cursor-pointer bg-transparent border-0" %>
            <button type="button" onclick="toggleAddTodo()" class="text-gray-600 hover:text-gray-800 font-medium hand-underline hand-underline-gray cursor-pointer bg-transparent border-0">Cancel</button>
          </div>
        <% end %>
      </div>
    </div>
    
    <% if @todos.empty? %>
      <div class="text-center py-8">
        <p class="text-gray-500">📝 No todos yet. Click above to add your first one!</p>
      </div>
    <% end %>
  </div>
</div>

<script>
function toggleAddTodo() {
  const trigger = document.getElementById('add-todo-trigger');
  const form = document.getElementById('add-todo-form');
  
  if (form.classList.contains('hidden')) {
    // Show form, hide trigger
    form.classList.remove('hidden');
    trigger.classList.add('hidden');
    // Focus on the title input
    form.querySelector('input[name="todo[title]"]').focus();
  } else {
    // Hide form, show trigger
    form.classList.add('hidden');
    trigger.classList.remove('hidden');
    // Clear the form
    form.querySelector('form').reset();
  }
}

// Keyboard shortcuts for better productivity
// Use window property to avoid redeclaration issues with Turbo
window.todoAppLastNPress = window.todoAppLastNPress || 0;

document.addEventListener('keydown', function(e) {
  // Special case: Ctrl/Cmd + Enter to submit form quickly
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      const form = e.target.closest('form');
      if (form) {
        e.preventDefault();
        form.submit();
      }
    }
    return;
  }

  // Alt+N to add new todo (non-conflicting shortcut)
  if (e.altKey && e.key.toLowerCase() === 'n') {
    e.preventDefault();
    const form = document.getElementById('add-todo-form');
    if (form.classList.contains('hidden')) {
      toggleAddTodo();
    }
  }
  
  // Alt+X to close the form (non-conflicting shortcut)
  if (e.altKey && e.key.toLowerCase() === 'x') {
    e.preventDefault();
    const formEsc = document.getElementById('add-todo-form');
    if (!formEsc.classList.contains('hidden')) {
      toggleAddTodo();
    }
  }
  
  // Double-tap 'n' for quick todo creation (alternative method)
  if (e.key.toLowerCase() === 'n' && !e.altKey && !e.ctrlKey && !e.metaKey) {
    const now = Date.now();
    if (now - window.todoAppLastNPress < 300) { // Double-tap within 300ms
      e.preventDefault();
      const form = document.getElementById('add-todo-form');
      if (form.classList.contains('hidden')) {
        toggleAddTodo();
      }
    }
    window.todoAppLastNPress = now;
  }
});

// Show keyboard shortcuts hint
document.addEventListener('DOMContentLoaded', function() {
  // Add a subtle hint about keyboard shortcuts
  const hint = document.createElement('div');
  hint.className = 'text-xs text-gray-400 mt-2 text-center';
  hint.innerHTML = '💡 Tip: <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">Alt+N</kbd> to add todo, <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">Alt+X</kbd> to close, <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">NN</kbd> (double-tap) or <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">Ctrl+Enter</kbd> to submit';
  
  const container = document.querySelector('.container');
  if (container) {
    container.appendChild(hint);
  }
});
</script>