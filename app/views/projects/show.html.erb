<div class="container mx-auto px-4 py-8">
  <!-- Project Header -->
  <div class="mb-8">
    <%= link_to "← Back to Projects", projects_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="text-gray-600 mt-2"><%= @project.description %></p>
    <% end %>
  </div>

  <!-- Add New Todo Form -->
  <div class="bg-white p-6 rounded-lg shadow-md mb-8">
    <h2 class="text-xl font-semibold mb-4">Add New Todo</h2>
    
    <%= form_with model: [@project, @new_todo], local: true, class: "space-y-4" do |form| %>
      <div>
        <%= form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md", placeholder: "What needs to be done?" %>
      </div>
      
      <div>
        <%= form.text_area :notes, class: "w-full px-3 py-2 border border-gray-300 rounded-md", placeholder: "Additional notes (optional)", rows: 2 %>
      </div>
      
      <div>
        <%= form.submit "Add Todo", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>

  <!-- Todos List -->
  <div class="bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-xl font-semibold mb-4">Todos (<%= @todos.count %>)</h2>
    
    <% if @todos.any? %>
      <div class="space-y-3">
        <% @todos.each do |todo| %>
          <div class="flex items-start p-3 border border-gray-200 rounded-lg">
            <div class="flex-1">
              <h4 class="font-medium <%= 'line-through text-gray-500' if todo.completed %>">
                <%= todo.title %>
              </h4>
              <% if todo.notes.present? %>
                <p class="text-sm text-gray-600 mt-1"><%= todo.notes %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No todos yet. Add your first todo above!</p>
    <% end %>
  </div>
</div>
