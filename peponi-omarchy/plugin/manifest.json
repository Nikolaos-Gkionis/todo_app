{
  "schemaVersion": 1,
  "id": "peponi.one-day",
  "name": "Peponi One Day",
  "version": "0.2.0",
  "author": "nikolaos",
  "license": "MIT",
  "description": "Focused one-day task view for paid peponi.to accounts — day navigation and Not Yet drawer via the peponi CLI",
  "homepage": "https://peponi.to",
  "repository": "https://github.com/Nikolaos-Gkionis/todo_app",
  "keywords": [
    "tasks",
    "todo",
    "peponi",
    "focus",
    "one-day"
  ],
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Peponi",
    "description": "Open the Peponi one-day focus overlay",
    "category": "Productivity",
    "aliases": [
      "peponi",
      "tasks",
      "todo",
      "one-day"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
