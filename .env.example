# Copy this file to .env if you use Docker or want extra local settings.
# A plain `bin/setup` / `rails server` run does not need Polar, Stripe, or email.

# Only set this on the public peponi.to server.
# When true, hosted accounts are deleted after 7 days.
# Leave unset (or false) when you run this yourself — your data stays put.
# HOSTED_EPHEMERAL=true

# Optional. The hosted site uses these for contact form and account emails.
# BREVO_API_KEY=
# CONTACT_EMAIL=you@example.com
